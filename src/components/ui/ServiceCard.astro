---
import CardWrapper from './CardWrapper.astro';

export interface Props {
  title: string;
  description: string;
  href: string;
  linkText?: string;
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  title,
  description,
  href,
  linkText = 'Learn More →',
  variant = 'dark',
  size = 'md',
  class: className = '',
} = Astro.props;

const headingClass = variant === 'dark' ? 'text-card-heading-dark' : 'text-card-heading-light';
const bodyClass = variant === 'dark' ? 'text-card-body-dark' : 'text-card-body-light';
const linkClass = variant === 'dark' ? 'text-card-link-dark' : 'text-card-link-light';
---

<CardWrapper variant={variant} size={size} href={href} class={className}>
  <h3 class:list={['text-[18px] md:text-[20px] font-sans font-medium leading-[130%] mb-2', headingClass]}>
    {title}
  </h3>
  <p class:list={['text-[14px] md:text-[15px] font-normal leading-[160%] mb-3 flex-1', bodyClass]}>
    {description}
  </p>
  <span
    class:list={[
      'mt-auto text-[14px] md:text-[15px] font-medium card-link',
      linkClass,
    ]}
  >
    {linkText}
  </span>
</CardWrapper>
