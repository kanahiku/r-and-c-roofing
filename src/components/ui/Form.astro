---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';
import { FORM_ENDPOINT, SITE_SLUG, TURNSTILE_SITE_KEY } from '~/lib/forms';
import { CONTACT } from '~/config/contact';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '' } = Astro.props;

const fieldClass =
  'py-3 px-4 block w-full text-[14px] md:text-[15px] rounded-md border border-black/15 bg-white text-heading';
const errorClass = 'mt-2 text-[13px] md:text-[14px] font-medium text-red-700 hidden';
const fieldMax: Record<string, number> = {
  name: 120,
  email: 254,
  phone: 40,
  street: 120,
  address2: 80,
  city: 80,
  zip: 10,
};
const widthClass = {
  full: 'sm:col-span-6',
  half: 'sm:col-span-3',
  third: 'sm:col-span-2',
} as const;
---

<form
  id="contact-form"
  novalidate
  data-endpoint={FORM_ENDPOINT}
  data-site={SITE_SLUG}
  data-turnstile-sitekey={TURNSTILE_SITE_KEY}
  data-phone-display={CONTACT.phone.display}
  data-phone-href={CONTACT.phone.href}
>
  {
    inputs && (
      <div class="grid grid-cols-1 sm:grid-cols-6 gap-x-4">
        {inputs.map(
          ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', required, options, width = 'full' }) =>
            name && (
              <div class:list={['mb-6', widthClass[width] ?? widthClass.full]}>
                {label && (
                  <label for={name} class="block text-[14px] md:text-[15px] font-medium text-heading mb-2">
                    {label}
                  </label>
                )}
                {type === 'select' ? (
                  <select
                    id={name}
                    name={name}
                    autocomplete={autocomplete === 'on' ? undefined : autocomplete}
                    required={required}
                    aria-describedby={`${name}-error`}
                    class={fieldClass}
                  >
                    <option value="">{placeholder || 'Select an option'}</option>
                    {(options ?? []).map((option) => (
                      <option value={option.value}>{option.label}</option>
                    ))}
                  </select>
                ) : (
                  <input
                    type={type}
                    name={name}
                    id={name}
                    autocomplete={autocomplete}
                    placeholder={placeholder}
                    required={required}
                    maxlength={fieldMax[name] ?? undefined}
                    aria-describedby={`${name}-error`}
                    class={fieldClass}
                  />
                )}
                <p id={`${name}-error`} class={errorClass} data-field-error={name} role="alert"></p>
              </div>
            )
        )}
      </div>
    )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-[14px] md:text-[15px] font-medium text-heading mb-2">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          maxlength={5000}
          aria-describedby={`${textarea.name ? textarea.name : 'message'}-error`}
          class={fieldClass}
        />
        <p
          id={`${textarea.name ? textarea.name : 'message'}-error`}
          class={errorClass}
          data-field-error={textarea.name ? textarea.name : 'message'}
          role="alert"
        ></p>
      </div>
    )
  }

  <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  <div class="mt-6" data-turnstile></div>

  {
    button && (
      <div class="mt-10">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  <p id="form-status" class="mt-4 text-left hidden" aria-live="polite"></p>

  {
    description && (
      <div class="mt-3 text-left">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }
</form>

<script>
  import { FIELD_ERRORS, fieldFromApiError, validateContactFields, type ContactFieldName } from '~/lib/form-validation';

  type TurnstileApi = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id: string) => void;
    getResponse: (id: string) => string;
  };

  const INVALID_FIELD_CLASS = 'border-red-600';
  const VALID_FIELD_CLASS = 'border-black/15';

  function asText(value: FormDataEntryValue | null) {
    return typeof value === 'string' ? value.trim() : '';
  }

  function fieldControl(form: HTMLFormElement, name: string) {
    return form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);
  }

  function setFieldError(form: HTMLFormElement, name: string, message: string) {
    const field = fieldControl(form, name);
    const errorEl = form.querySelector<HTMLElement>(`[data-field-error="${name}"]`);
    if (field) {
      field.setAttribute('aria-invalid', 'true');
      field.classList.add(INVALID_FIELD_CLASS);
      field.classList.remove(VALID_FIELD_CLASS);
    }
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
  }

  function clearFieldError(form: HTMLFormElement, name: string) {
    const field = fieldControl(form, name);
    const errorEl = form.querySelector<HTMLElement>(`[data-field-error="${name}"]`);
    if (field) {
      field.removeAttribute('aria-invalid');
      field.classList.remove(INVALID_FIELD_CLASS);
      field.classList.add(VALID_FIELD_CLASS);
    }
    if (errorEl) {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    }
  }

  function clearAllFieldErrors(form: HTMLFormElement) {
    form.querySelectorAll<HTMLElement>('[data-field-error]').forEach((errorEl) => {
      const name = errorEl.dataset.fieldError;
      if (name) clearFieldError(form, name);
    });
  }

  function showFieldErrors(form: HTMLFormElement, errors: Partial<Record<ContactFieldName, string>>) {
    const names = Object.keys(errors) as ContactFieldName[];
    names.forEach((name) => {
      const message = errors[name];
      if (message) setFieldError(form, name, message);
    });
    const first = names[0] ? fieldControl(form, names[0]) : null;
    first?.focus();
  }

  function composeAddress(data: FormData) {
    const street = asText(data.get('street'));
    const address2 = asText(data.get('address2'));
    const city = asText(data.get('city'));
    const state = asText(data.get('state'));
    const zip = asText(data.get('zip'));
    const cityLine = [city, state].filter(Boolean).join(', ');
    const locality = [cityLine, zip].filter(Boolean).join(' ');
    return [street, address2, locality].filter(Boolean).join('\n');
  }

  function composeMessage(form: HTMLFormElement, data: FormData) {
    const address = composeAddress(data);
    const topicField = form.querySelector<HTMLSelectElement>('[name="topic"]');
    const topicValue = asText(data.get('topic'));
    const topicLabel = topicField?.selectedOptions[0]?.text?.trim() || topicValue;
    const message = asText(data.get('message'));
    const lines: string[] = [];
    if (address) lines.push(`Address:\n${address}`);
    if (topicLabel) lines.push(`Topic: ${topicLabel}`);
    if (message) lines.push(message);
    return lines.join('\n\n') || 'Contact form submission';
  }

  function loadTurnstile(): Promise<TurnstileApi> {
    const existing = (window as Window & { turnstile?: TurnstileApi }).turnstile;
    if (existing) return Promise.resolve(existing);

    return new Promise((resolve, reject) => {
      const ready = () => {
        const api = (window as Window & { turnstile?: TurnstileApi }).turnstile;
        if (api) resolve(api);
        else reject(new Error('Turnstile failed to load'));
      };

      const script = document.querySelector<HTMLScriptElement>('script[data-turnstile-api]');
      if (script) {
        if ((window as Window & { turnstile?: TurnstileApi }).turnstile) {
          ready();
          return;
        }
        script.addEventListener('load', ready, { once: true });
        script.addEventListener('error', () => reject(new Error('Turnstile failed to load')), { once: true });
        return;
      }

      const next = document.createElement('script');
      next.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      next.async = true;
      next.dataset.turnstileApi = 'true';
      next.addEventListener('load', ready, { once: true });
      next.addEventListener('error', () => reject(new Error('Turnstile failed to load')), { once: true });
      document.head.appendChild(next);
    });
  }

  function showCallError(status: HTMLElement, phoneDisplay: string, phoneHref: string) {
    const message: Node[] = [document.createTextNode('Something went wrong. Please try again or call ')];

    if (phoneDisplay && phoneHref) {
      const link = document.createElement('a');
      link.href = phoneHref;
      link.textContent = phoneDisplay;
      link.className = 'underline hover:no-underline';
      message.push(link);
    } else {
      message.push(document.createTextNode('us'));
    }

    message.push(document.createTextNode('.'));
    status.replaceChildren(...message);
    status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-red-700';
  }

  async function bindContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');

    if (!form || !status || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const slot = form.querySelector<HTMLElement>('[data-turnstile]');
    const sitekey = form.dataset.turnstileSitekey || '';
    const phoneDisplay = form.dataset.phoneDisplay || '';
    const phoneHref = form.dataset.phoneHref || '';
    let widgetId = '';

    if (slot && sitekey) {
      try {
        const turnstile = await loadTurnstile();
        widgetId = turnstile.render(slot, { sitekey });
      } catch (error) {
        console.error(error);
      }
    }

    form.addEventListener('input', (event) => {
      const target = event.target as HTMLElement | null;
      const name = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement ? target.name : '';
      if (name && name !== 'website') clearFieldError(form, name);
    });

    form.addEventListener('change', (event) => {
      const target = event.target as HTMLElement | null;
      if (target instanceof HTMLSelectElement && target.name) clearFieldError(form, target.name);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const data = new FormData(form);

      if (asText(data.get('website'))) return;

      clearAllFieldErrors(form);
      status.classList.add('hidden');
      status.textContent = '';

      const hasZipField = Boolean(fieldControl(form, 'zip'));
      const hasStreetField = Boolean(fieldControl(form, 'street'));
      const hasAddress2Field = Boolean(fieldControl(form, 'address2'));
      const hasCityField = Boolean(fieldControl(form, 'city'));
      const hasStateField = Boolean(fieldControl(form, 'state'));
      const hasTopicField = Boolean(fieldControl(form, 'topic'));
      const messageField = fieldControl(form, 'message');
      const errors = validateContactFields({
        name: asText(data.get('name')),
        email: asText(data.get('email')),
        phone: asText(data.get('phone')),
        street: asText(data.get('street')),
        address2: asText(data.get('address2')),
        city: asText(data.get('city')),
        state: asText(data.get('state')),
        zip: asText(data.get('zip')),
        topic: asText(data.get('topic')),
        message: asText(data.get('message')),
        hasStreetField,
        hasAddress2Field,
        hasCityField,
        hasStateField,
        hasZipField,
        hasTopicField,
        hasMessageField: Boolean(messageField),
        messageRequired: Boolean(messageField?.hasAttribute('required')),
      });

      if (Object.keys(errors).length) {
        showFieldErrors(form, errors);
        return;
      }

      const endpoint = form.dataset.endpoint;
      const site = form.dataset.site;
      const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
      const turnstileToken = widgetId && turnstile ? turnstile.getResponse(widgetId) : asText(data.get('cf-turnstile-response'));

      if (!endpoint || !site) {
        showCallError(status, phoneDisplay, phoneHref);
        status.classList.remove('hidden');
        return;
      }

      if (!turnstileToken) {
        status.textContent = 'Please complete the spam check before sending.';
        status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-red-700';
        status.classList.remove('hidden');
        return;
      }

      if (submitButton) submitButton.disabled = true;
      status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-muted';
      status.textContent = 'Sending…';
      status.classList.remove('hidden');

      let succeeded = false;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            site,
            name: asText(data.get('name')),
            email: asText(data.get('email')),
            phone: asText(data.get('phone')),
            street: asText(data.get('street')),
            address2: asText(data.get('address2')),
            city: asText(data.get('city')),
            state: asText(data.get('state')),
            zip: asText(data.get('zip')),
            message: composeMessage(form, data),
            website: asText(data.get('website')),
            turnstileToken,
          }),
        });

        const payload = (await res.json().catch(() => null)) as { ok?: boolean; error?: string } | null;

        if (res.ok && payload?.ok) {
          succeeded = true;
          status.textContent = "Thanks! We'll be in touch soon.";
          status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-heading';
          form.reset();
          clearAllFieldErrors(form);
          if (widgetId && turnstile) turnstile.reset(widgetId);
          return;
        }

        const apiError = payload?.error || '';
        const field = apiError ? fieldFromApiError(apiError) : null;
        if (field) {
          status.classList.add('hidden');
          status.textContent = '';
          showFieldErrors(form, { [field]: FIELD_ERRORS[field] });
          return;
        }

        showCallError(status, phoneDisplay, phoneHref);
      } catch {
        showCallError(status, phoneDisplay, phoneHref);
      } finally {
        if (submitButton) submitButton.disabled = false;
        if (status.textContent) status.classList.remove('hidden');
        // A token is single-use and expires after ~5 minutes. Without this, every
        // retry after a failure resends the spent token and is rejected as duplicate.
        if (!succeeded && widgetId && turnstile) turnstile.reset(widgetId);
      }
    });
  }

  document.addEventListener('astro:page-load', bindContactForm);
</script>
