---
import CardWrapper from './CardWrapper.astro';

export interface Props {
  title: string;
  description: string;
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  border?: boolean;
  class?: string;
}

const {
  title,
  description,
  variant = 'dark',
  size = 'md',
  border = true,
  class: className = '',
} = Astro.props;

const headingClass = variant === 'dark' ? 'text-card-heading-dark' : 'text-card-heading-light';
const bodyClass = variant === 'dark' ? 'text-card-body-dark' : 'text-card-body-light';
---

<CardWrapper variant={variant} size={size} border={border} class={className}>
  <h3 class:list={['text-[16px] md:text-[18px] font-medium font-heading leading-[130%] mb-2', headingClass]}>
    {title}
  </h3>
  <p class:list={['text-[13px] md:text-[14px] font-medium leading-[160%]', bodyClass]}>
    {description}
  </p>
</CardWrapper>
