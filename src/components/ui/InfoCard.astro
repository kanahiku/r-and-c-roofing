---
import { Icon } from 'astro-icon/components';
import CardWrapper from './CardWrapper.astro';

export interface Props {
  title: string;
  description: string;
  icon?: string;
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  border?: boolean;
  class?: string;
}

const {
  title,
  description,
  icon,
  variant = 'dark',
  size = 'md',
  border = true,
  class: className = '',
} = Astro.props;

const headingClass = variant === 'dark' ? 'text-card-heading-dark' : 'text-card-heading-light';
const bodyClass = variant === 'dark' ? 'text-card-body-dark' : 'text-card-body-light';
const iconMark =
  variant === 'dark' ? 'border border-accent/60' : 'bg-[#222]';
---

<CardWrapper variant={variant} size={size} border={border} class={className}>
  {
    icon && (
      <div class:list={['mb-4 w-10 h-10 rounded-md flex items-center justify-center shrink-0', iconMark]}>
        <Icon name={icon} class="w-5 h-5 text-accent" aria-hidden="true" />
      </div>
    )
  }
  <h3 class:list={['text-[16px] md:text-[18px] font-medium font-heading leading-[130%] mb-2', headingClass]}>
    {title}
  </h3>
  <p class:list={['text-[13px] md:text-[14px] font-normal leading-[160%]', bodyClass]}>
    {description}
  </p>
</CardWrapper>
