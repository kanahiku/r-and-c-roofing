---
import { Icon } from 'astro-icon/components';
import CardWrapper from './CardWrapper.astro';
import type { CardVariant } from '~/config/theme';

export interface Props {
  title: string;
  description: string;
  icon?: string;
  variant?: CardVariant;
  size?: 'sm' | 'md' | 'lg';
  border?: boolean;
  href?: string;
  class?: string;
}

const {
  title,
  description,
  icon,
  variant = 'dark',
  size = 'md',
  border = true,
  href,
  class: className = '',
} = Astro.props;

const headingClasses: Record<CardVariant, string> = {
  dark: 'text-card-heading-dark',
  light: 'text-card-heading-light',
  outlined: 'text-card-heading-outlined',
  glass: 'text-card-heading-glass',
};

const bodyClasses: Record<CardVariant, string> = {
  dark: 'text-card-body-dark',
  light: 'text-card-body-light',
  outlined: 'text-card-body-outlined',
  glass: 'text-card-body-glass',
};

// Icon mark: dark bg square for light cards; accent-bordered square for dark/glass
const iconMarks: Record<CardVariant, string> = {
  dark: 'border border-accent/60',
  light: 'bg-[#222]',
  outlined: 'bg-[#222]',
  glass: 'border border-accent/60',
};

const headingClass = headingClasses[variant];
const bodyClass = bodyClasses[variant];
const iconMark = iconMarks[variant];
const hasDescriptionSlot = Astro.slots.has('description');
---

<CardWrapper variant={variant} size={size} border={border} href={href} class={className}>
  {
    icon && (
      <div class:list={['mb-4 w-10 h-10 rounded-md flex items-center justify-center shrink-0', iconMark]}>
        <Icon name={icon} class="w-5 h-5 text-accent" aria-hidden="true" />
      </div>
    )
  }
  <h3 class:list={['text-[16px] md:text-[18px] font-sans font-medium leading-[130%] mb-2', headingClass]}>
    {title}
  </h3>
  <p class:list={['text-[14px] md:text-[15px] font-normal leading-[160%]', bodyClass]}>
    {hasDescriptionSlot ? <slot name="description" /> : description}
  </p>
</CardWrapper>
