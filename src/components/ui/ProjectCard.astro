---
import CardWrapper from './CardWrapper.astro';

export interface Props {
  title: string;
  description?: string;
  image?: {
    src: string;
    alt: string;
  };
  href?: string;
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  title,
  description,
  image,
  href,
  variant = 'light',
  size = 'md',
  class: className = '',
} = Astro.props;

const headingClass = variant === 'dark' ? 'text-card-heading-dark' : 'text-card-heading-light';
const bodyClass = variant === 'dark' ? 'text-card-body-dark' : 'text-card-body-light';
---

<CardWrapper variant={variant} size={size} href={href} class={className}>
  {image ? (
    <img
      src={image.src}
      alt={image.alt}
      class="w-full h-36 md:h-44 object-cover rounded mb-3"
    />
  ) : (
    <div class="w-full h-36 md:h-44 bg-gray-100 dark:bg-slate-800 rounded mb-3 flex items-center justify-center text-gray-300 dark:text-slate-600">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
  )}
  <h3 class:list={['text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-1', headingClass]}>
    {title}
  </h3>
  {description && (
    <p class:list={['text-[13px] md:text-[14px] font-normal leading-[160%]', bodyClass]}>
      {description}
    </p>
  )}
</CardWrapper>
