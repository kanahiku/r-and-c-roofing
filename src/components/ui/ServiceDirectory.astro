---
export interface Props {
  items: Array<{ title: string; description: string; href: string; linkText?: string }>;
  variant?: 'light' | 'dark';
}

const { items, variant = 'dark' } = Astro.props;

const divideClass = variant === 'dark' ? 'divide-white/15' : 'divide-black/10';
const titleClass = variant === 'dark' ? 'text-white' : 'text-heading';
const bodyClass = variant === 'dark' ? 'text-white/60' : 'text-muted';
const linkClass = variant === 'dark' ? 'text-accent' : 'text-timeline-step-light';
const hoverClass = variant === 'dark' ? 'hover:bg-white/5' : 'hover:bg-[rgb(237_217_116/18%)]';
---

<div class:list={['divide-y', divideClass]}>
  {
    items.map(({ title, description, href, linkText = 'Learn More' }) => (
      <a
        href={href}
        class:list={[
          'group flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 py-5 -mx-4 rounded-md cursor-pointer transition-colors duration-200',
          hoverClass,
        ]}
      >
        <div class="min-w-0">
          <h3 class:list={['text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-1', titleClass]}>
            {title}
          </h3>
          <p class:list={['text-[14px] md:text-[15px] font-normal leading-[160%]', bodyClass]}>{description}</p>
        </div>
        <span
          class:list={[
            'text-[14px] md:text-[15px] font-medium shrink-0 underline underline-offset-[3px] decoration-2 decoration-transparent transition-[text-decoration-color] duration-200 group-hover:decoration-current',
            linkClass,
          ]}
        >
          {linkText}
        </span>
      </a>
    ))
  }
</div>
