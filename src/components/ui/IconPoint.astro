---
import { Icon } from 'astro-icon/components';
import { inlineLinkClass, inlineMarkdownHtml } from '~/lib/content/inlineMarkdown';

export interface Props {
  title: string;
  description: string;
  icon: string;
  href?: string;
  variant?: 'light' | 'dark';
  orientation?: 'stack' | 'inline';
  align?: 'center' | 'start';
}

const { title, description, icon, href, variant = 'light', orientation = 'inline', align = 'start' } = Astro.props;

const headingClass = variant === 'dark' ? 'text-white' : 'text-heading';
const bodyClass = variant === 'dark' ? 'text-white/70' : 'text-muted';
const linkClass = inlineLinkClass(variant === 'dark');
const iconMark = variant === 'dark' ? 'border border-accent/60' : 'bg-[#222]';
const isStack = orientation === 'stack';
const isStart = align === 'start';
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    isStack
      ? isStart
        ? 'flex flex-col items-start text-left min-w-0 h-full'
        : 'flex flex-col items-center text-center min-w-0 h-full'
      : 'flex gap-4',
    href &&
      'group cursor-pointer rounded-lg p-4 border transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent',
    href && variant === 'dark' && 'border-accent/50 hover:border-accent hover:bg-white/5',
    href && variant !== 'dark' && 'border-black/20 hover:border-heading hover:bg-black/5',
  ]}
>
  <div
    class:list={[
      'w-10 h-10 rounded-md flex items-center justify-center shrink-0',
      isStack ? 'mb-4' : 'mt-0.5',
      iconMark,
    ]}
  >
    <Icon name={icon} class="w-5 h-5 text-accent" aria-hidden="true" />
  </div>
  <div class="min-w-0 w-full">
    <h3
      class:list={[
        'text-[16px] md:text-[18px] font-sans font-medium leading-[130%] mb-0.5',
        headingClass,
        href && 'group-hover:underline',
      ]}
    >
      {title}
    </h3>
    <p class:list={['text-[13px] md:text-[14px] font-normal leading-[160%]', bodyClass, linkClass]} set:html={inlineMarkdownHtml(description)} />
  </div>
</Tag>
