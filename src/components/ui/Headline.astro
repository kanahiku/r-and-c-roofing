---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

interface ExtendedProps extends Props {
  isDark?: boolean;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  isDark = false,
  classes = {},
} = Astro.props as ExtendedProps;

const {
  container: containerClass = '',
  title: titleClass = '',
  subtitle: subtitleClass = '',
} = classes;

// Typography classes (consistent across light/dark)
const titleTypography = 'text-[26px] md:text-[40px] font-normal leading-[110%] tracking-tighter font-heading';
const subtitleTypography = 'text-[16px] md:text-[17px] font-normal leading-[160%]';

// Color classes based on isDark
const titleColor = isDark ? 'text-headline-dark' : 'text-headline-light';
const subtitleColor = isDark ? 'text-headline-subtitle-dark' : 'text-headline-subtitle-light';
---

{
  (title || subtitle || tagline) && (
    <div class={twMerge('mb-[30px] text-left', containerClass)}>
      {tagline && (
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase" set:html={tagline} />
      )}
      {title && (
        <h2
          class={twMerge(titleTypography, titleColor, titleClass)}
          set:html={title}
        />
      )}

      {subtitle && <p class={twMerge('mt-[9px]', subtitleTypography, subtitleColor, subtitleClass)} set:html={subtitle} />}
    </div>
  )
}
