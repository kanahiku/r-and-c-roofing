---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { Item } from '~/types';

export interface Props {
  items?: Array<Item>;
  defaultIcon?: string;
  isDark?: boolean;
  classes?: Record<string, string>;
}

const { items = [], classes = {}, defaultIcon, isDark = false } = Astro.props as Props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: iconClass = '',
} = classes;

// Color classes based on isDark
const iconColors = isDark 
  ? 'text-timeline-icon-dark border-timeline-icon-border-dark bg-timeline-icon-bg-dark' 
  : 'text-timeline-icon-light border-timeline-icon-border-light bg-timeline-icon-bg-light';
const titleColors = isDark ? 'text-timeline-title-dark' : 'text-timeline-title-light';
const descColors = isDark ? 'text-timeline-desc-dark' : 'text-timeline-desc-light';
const lineColors = isDark ? 'bg-white/20' : 'bg-black/10';
---

{
  items && items.length > 0 && (
    <div class={containerClass}>
      {items.map(({ title, description, icon, classes: itemClasses = {} }, index = 0) => (
        <div
          class={twMerge(
            'flex intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
            panelClass,
            itemClasses?.panel
          )}
        >
          <div class="flex flex-col items-center mr-4 rtl:mr-0 rtl:ml-4">
            <div>
              <div class="flex items-center justify-center">
                {(icon || defaultIcon) && (
                  <Icon
                    name={icon || defaultIcon}
                    class={twMerge('w-10 h-10 p-2 rounded-full border-2', iconColors, iconClass, itemClasses?.icon)}
                  />
                )}
              </div>
            </div>
            {index !== items.length - 1 && <div class={twMerge('w-px h-full', lineColors)} />}
          </div>
          <div class={`pt-1 ${index !== items.length - 1 ? 'pb-8' : ''}`}>
            {title && <p class={twMerge('text-xl font-bold', titleColors, titleClass, itemClasses?.title)} set:html={title} />}
            {description && (
              <p
                class={twMerge('mt-2', descColors, descriptionClass, itemClasses?.description)}
                set:html={description}
              />
            )}
          </div>
        </div>
      ))}
    </div>
  )
}
