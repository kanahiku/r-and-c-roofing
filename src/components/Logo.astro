---
import { twMerge } from 'tailwind-merge';
import logoImg from '~/assets/images/logo.webp';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<img
  src={logoImg.src}
  alt="R&C Roofing"
  width={logoImg.width}
  height={logoImg.height}
  class={twMerge('h-8 md:h-9 w-auto max-w-[240px] object-contain object-left shrink-0', className)}
  loading="eager"
  decoding="async"
/>
