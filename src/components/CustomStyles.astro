---
// Sora for headings (via --font-sora), Inter for body (via --font-inter).
// Both loaded by Astro Fonts API in astro.config.ts.
// 
// Color Palette (R&C Roofing):
// #EDD974 - Gold/Yellow (Primary CTA, Accent)
// #000000 - Black (Navbar, Footer)
// #222222 - Charcoal (Headings)
// #4F5E65 - Slate (Body text)
// #A2AFB5 - Gray (Muted text)
// #FFFFFF - White (Page bg)
// #E3E6E7 - Light gray (Section bg)
// #082244 - Navy (Dark sections)
// #0787C9 - Blue (Links, optional)
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-sora);

    --aw-color-primary: rgb(79 94 101);
    --aw-color-secondary: rgb(162 175 181);
    --aw-color-accent: rgb(237 217 116);
    --aw-color-accent-hover: rgb(212 188 87);

    --aw-color-text-heading: rgb(34 34 34);
    --aw-color-text-default: rgb(79 94 101);
    --aw-color-text-muted: rgb(162 175 181);
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-bg-section-white: rgb(255 255 255);
    --aw-color-bg-section-grey: rgb(250 250 250);
    --aw-color-bg-section-dark: rgb(0 0 0);
    --aw-color-bg-card-dark: rgb(34 34 34);
    --aw-color-bg-card-light: rgb(237 217 116 / 50%);

    --aw-color-card-heading-dark: rgb(255 255 255);
    --aw-color-card-body-dark: rgb(255 255 255 / 60%);
    --aw-color-card-link-dark: var(--aw-color-accent);

    --aw-color-card-heading-light: var(--aw-color-text-heading);
    --aw-color-card-body-light: var(--aw-color-text-muted);
    --aw-color-card-link-light: var(--aw-color-accent);

    --aw-color-card-border-dark: rgb(237 217 116 / 60%);
    --aw-color-card-border-light: transparent;

    /* Button Colors */
    --aw-color-btn-primary-bg: var(--aw-color-accent);
    --aw-color-btn-primary-text: rgb(0 0 0);
    --aw-color-btn-primary-border: var(--aw-color-accent);
    --aw-color-btn-primary-bg-hover: var(--aw-color-accent-hover);
    --aw-color-btn-primary-text-hover: rgb(0 0 0);
    --aw-color-btn-primary-border-hover: var(--aw-color-accent-hover);

    --aw-color-btn-secondary-bg: transparent;
    --aw-color-btn-secondary-text: rgb(0 0 0);
    --aw-color-btn-secondary-border: rgb(0 0 0);
    --aw-color-btn-secondary-bg-hover: rgb(0 0 0);
    --aw-color-btn-secondary-text-hover: rgb(255 255 255);
    --aw-color-btn-secondary-border-hover: rgb(0 0 0);

    --aw-color-btn-ghost-light-bg: transparent;
    --aw-color-btn-ghost-light-text: rgb(0 0 0);
    --aw-color-btn-ghost-light-border: rgb(0 0 0);
    --aw-color-btn-ghost-light-bg-hover: rgb(0 0 0);
    --aw-color-btn-ghost-light-text-hover: rgb(255 255 255);
    --aw-color-btn-ghost-light-border-hover: rgb(0 0 0);

    --aw-color-btn-ghost-dark-bg: transparent;
    --aw-color-btn-ghost-dark-text: rgb(255 255 255);
    --aw-color-btn-ghost-dark-border: var(--aw-color-accent);
    --aw-color-btn-ghost-dark-bg-hover: var(--aw-color-accent);
    --aw-color-btn-ghost-dark-text-hover: rgb(0 0 0);
    --aw-color-btn-ghost-dark-border-hover: var(--aw-color-accent);

    --aw-color-btn-link: var(--aw-color-accent);
    --aw-color-btn-link-hover: var(--aw-color-accent-hover);

    /* Headline Colors */
    --aw-color-headline-light: var(--aw-color-text-heading);
    --aw-color-headline-dark: rgb(255 255 255);
    --aw-color-headline-subtitle-light: var(--aw-color-text-muted);
    --aw-color-headline-subtitle-dark: rgb(255 255 255 / 70%);

    /* Timeline Colors */
    --aw-color-timeline-icon-light: rgb(0 0 0);
    --aw-color-timeline-icon-border-light: var(--aw-color-accent);
    --aw-color-timeline-icon-bg-light: transparent;
    --aw-color-timeline-title-light: var(--aw-color-text-heading);
    --aw-color-timeline-desc-light: var(--aw-color-text-muted);

    --aw-color-timeline-icon-dark: var(--aw-color-accent);
    --aw-color-timeline-icon-border-dark: var(--aw-color-accent);
    --aw-color-timeline-icon-bg-dark: rgb(237 217 116 / 10%);
    --aw-color-timeline-title-dark: rgb(255 255 255);
    --aw-color-timeline-desc-dark: rgb(255 255 255 / 60%);

    /* Testimonials Colors */
    --aw-color-testimonial-card-bg-light: rgb(237 217 116 / 50%);
    --aw-color-testimonial-card-border-light: transparent;
    --aw-color-testimonial-text-light: var(--aw-color-text-muted);
    --aw-color-testimonial-name-light: var(--aw-color-text-heading);
    --aw-color-testimonial-job-light: var(--aw-color-text-muted);
    --aw-color-testimonial-hr-light: rgb(226 232 240);

    --aw-color-testimonial-card-bg-dark: rgb(255 255 255 / 5%);
    --aw-color-testimonial-card-border-dark: rgb(255 255 255 / 15%);
    --aw-color-testimonial-text-dark: rgb(255 255 255 / 70%);
    --aw-color-testimonial-name-dark: rgb(255 255 255);
    --aw-color-testimonial-job-dark: rgb(255 255 255 / 50%);
    --aw-color-testimonial-hr-dark: rgb(255 255 255 / 10%);

    /* FAQ Colors */
    --aw-color-faq-border-light: rgb(229 231 235);
    --aw-color-faq-question-light: var(--aw-color-text-heading);
    --aw-color-faq-answer-light: var(--aw-color-text-muted);
    --aw-color-faq-toggle-border-light: rgb(209 213 219);
    --aw-color-faq-toggle-text-light: rgb(107 114 128);
    --aw-color-faq-toggle-active-light: var(--aw-color-accent);

    --aw-color-faq-border-dark: rgb(255 255 255 / 20%);
    --aw-color-faq-question-dark: rgb(255 255 255);
    --aw-color-faq-answer-dark: var(--aw-color-accent);
    --aw-color-faq-toggle-border-dark: rgb(255 255 255 / 30%);
    --aw-color-faq-toggle-text-dark: rgb(255 255 255 / 50%);
    --aw-color-faq-toggle-active-dark: var(--aw-color-accent);

    /* Projects Section Colors */
    --aw-color-projects-card-bg-light: rgb(237 217 116 / 50%);
    --aw-color-projects-card-border-light: transparent;
    --aw-color-projects-title-light: var(--aw-color-text-heading);
    --aw-color-projects-desc-light: var(--aw-color-text-muted);

    --aw-color-projects-card-bg-dark: rgb(34 34 34);
    --aw-color-projects-card-border-dark: rgb(237 217 116 / 60%);
    --aw-color-projects-title-dark: rgb(255 255 255);
    --aw-color-projects-desc-dark: rgb(255 255 255 / 60%);

    --aw-color-bg-page-dark: rgb(8 34 68);

    --aw-color-motif-hero: var(--aw-color-accent);
    --aw-color-motif-dark: var(--aw-color-accent);
    --aw-color-motif-cta: rgb(0 0 0);

    --aw-opacity-motif-hero: 0.10;
    --aw-opacity-motif-dark: 0.12;
    --aw-opacity-motif-cta: 0.03;

    --aw-shadow-card: none;
    --aw-border-card: rgba(255, 255, 255, 0.16);

    ::selection {
      background-color: rgb(237 217 116 / 30%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-sora);

    --aw-color-primary: rgb(237 217 116);
    --aw-color-secondary: rgb(203 186 99);
    --aw-color-accent: rgb(237 217 116);
    --aw-color-accent-hover: rgb(212 188 87);

    --aw-color-text-heading: rgb(247 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(162 175 181);
    --aw-color-bg-page: rgb(8 34 68);
    --aw-color-bg-section-white: rgb(8 34 68);
    --aw-color-bg-section-grey: rgb(12 45 90);
    --aw-color-bg-section-dark: rgb(0 0 0);
    --aw-color-bg-card-dark: rgb(34 34 34);
    --aw-color-bg-card-light: rgb(12 45 90);

    --aw-color-card-heading-dark: rgb(255 255 255);
    --aw-color-card-body-dark: rgb(255 255 255 / 60%);
    --aw-color-card-link-dark: var(--aw-color-accent);

    --aw-color-card-heading-light: rgb(247 250 252);
    --aw-color-card-body-light: rgb(162 175 181);
    --aw-color-card-link-light: var(--aw-color-accent);

    --aw-color-card-border-dark: rgb(237 217 116 / 60%);
    --aw-color-card-border-light: rgb(237 217 116 / 50%);

    /* Button Colors (Dark Mode) */
    --aw-color-btn-primary-bg: var(--aw-color-accent);
    --aw-color-btn-primary-text: rgb(0 0 0);
    --aw-color-btn-primary-border: var(--aw-color-accent);
    --aw-color-btn-primary-bg-hover: var(--aw-color-accent-hover);
    --aw-color-btn-primary-text-hover: rgb(0 0 0);
    --aw-color-btn-primary-border-hover: var(--aw-color-accent-hover);

    --aw-color-btn-secondary-bg: transparent;
    --aw-color-btn-secondary-text: rgb(255 255 255);
    --aw-color-btn-secondary-border: rgb(255 255 255);
    --aw-color-btn-secondary-bg-hover: rgb(255 255 255);
    --aw-color-btn-secondary-text-hover: rgb(0 0 0);
    --aw-color-btn-secondary-border-hover: rgb(255 255 255);

    --aw-color-btn-ghost-light-bg: transparent;
    --aw-color-btn-ghost-light-text: rgb(0 0 0);
    --aw-color-btn-ghost-light-border: rgb(0 0 0);
    --aw-color-btn-ghost-light-bg-hover: rgb(0 0 0);
    --aw-color-btn-ghost-light-text-hover: rgb(255 255 255);
    --aw-color-btn-ghost-light-border-hover: rgb(0 0 0);

    --aw-color-btn-ghost-dark-bg: transparent;
    --aw-color-btn-ghost-dark-text: rgb(255 255 255);
    --aw-color-btn-ghost-dark-border: var(--aw-color-accent);
    --aw-color-btn-ghost-dark-bg-hover: var(--aw-color-accent);
    --aw-color-btn-ghost-dark-text-hover: rgb(0 0 0);
    --aw-color-btn-ghost-dark-border-hover: var(--aw-color-accent);

    --aw-color-btn-link: var(--aw-color-accent);
    --aw-color-btn-link-hover: var(--aw-color-accent-hover);

    --aw-color-motif-hero: var(--aw-color-accent);
    --aw-color-motif-dark: var(--aw-color-accent);
    --aw-color-motif-cta: rgb(0 0 0);

    --aw-opacity-motif-hero: 0.10;
    --aw-opacity-motif-dark: 0.12;
    --aw-opacity-motif-cta: 0.03;

    ::selection {
      background-color: rgb(237 217 116 / 30%);
      color: snow;
    }
  }
</style>
