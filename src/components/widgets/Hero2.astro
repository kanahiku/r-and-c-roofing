---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import overlayImage from '~/assets/images/patterns/fancy-two.svg';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  variant = 'split',
  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const isOverlay = variant === 'overlay';
const hasStats = isOverlay && Astro.slots.has('stats');
const hasImage = Boolean(image && (typeof image !== 'string' || image.trim()));
---

<section class="relative md:-mt-[76px] not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
    {
      isOverlay && !bg && (
        <>
          <img src={overlayImage.src} alt="" class="absolute inset-0 h-full w-full object-cover object-center" />
          <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/45 to-transparent" />
        </>
      )
    }
  </div>
  <div class="relative max-w-[1400px] mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div
      class:list={[
        isOverlay && hasStats && 'pt-16 md:pt-[120px] pb-12 md:pb-20 min-h-[440px] md:min-h-[560px] flex items-center',
        isOverlay && !hasStats && 'py-16 md:py-[120px] min-h-[560px] md:min-h-[720px] flex items-center',
        !isOverlay && hasImage && 'py-12 md:py-[100px] lg:flex lg:items-center lg:gap-8',
        !isOverlay && !hasImage && 'py-12 md:py-[100px]',
      ]}
    >
      <div class:list={[isOverlay ? 'w-full max-w-2xl text-left' : hasImage ? 'basis-1/2 text-left' : 'w-full max-w-3xl text-left']}>
        {
          tagline && (
            <p
              class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class:list={[
                'text-[42px] md:text-[56px] font-normal leading-[115%] tracking-tighter mb-[20px] font-heading intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter',
                isOverlay ? 'text-white' : 'text-[#111111] dark:text-gray-200',
              ]}
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl lg:max-w-none">
          {
            subtitle && (
              <p
                class:list={[
                  'text-[16px] md:text-[17px] font-normal leading-[160%] mb-[30px] intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter',
                  isOverlay ? 'text-white/80' : 'text-[#444444] dark:text-slate-300',
                ]}
                set:html={subtitle}
              />
            )
          }

          {
            actions && (
              <div class="max-w-xs sm:max-w-md flex flex-nowrap flex-col sm:flex-row justify-start gap-4 lg:max-w-7xl intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      {
        !isOverlay && hasImage && (
          <div class="basis-1/2 flex justify-center lg:justify-end mt-8 lg:mt-0">
            <div class="relative w-full max-w-[500px] aspect-square shrink-0 intersect-once intersect-no-queue motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  {...image}
                  class="rounded-md w-full h-full object-cover"
                  widths={[500, 750, 1000]}
                  sizes="(max-width: 639px) 100vw, 500px"
                  loading="eager"
                  width={500}
                  height={500}
                  layout="cover"
                  format="webp"
                />
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>
  {
    hasStats && (
      <div class="relative bg-[rgb(14_13_7_/_0.1)] backdrop-blur-[15px]">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-[22px]">
          <slot name="stats" />
        </div>
      </div>
    )
  }
</section>
