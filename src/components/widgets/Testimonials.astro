---
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import type { Testimonials as Props } from '~/types';

const {
  title = '',
  subtitle = '',
  tagline = '',
  testimonials = [],
  callToAction,

  id,
  isDark = false,
  cardClass,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Use CSS variable-based classes unless cardClass is explicitly provided
const cardBg = cardClass ?? (isDark
  ? 'border border-testimonial-card-dark bg-testimonial-card-dark backdrop-blur-sm'
  : 'border border-testimonial-card-light bg-testimonial-card-light');
const textColor = isDark ? 'text-testimonial-dark' : 'text-testimonial-light';
const nameColor = isDark ? 'text-testimonial-name-dark' : 'text-testimonial-name-light';
const jobColor = isDark ? 'text-testimonial-job-dark' : 'text-testimonial-job-light';
const hrColor = isDark ? 'border-testimonial-hr-dark' : 'border-testimonial-hr-light';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-[1400px] mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} isDark={isDark} classes={classes?.headline} />

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      testimonials &&
        testimonials.map(({ title, testimonial, name, job, image }) => (
          <div class="flex h-auto intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
            <div class:list={['flex flex-col p-4 md:p-6 rounded-md', cardBg]}>
              {title && <h2 class="text-lg font-medium leading-6 pb-4">{title}</h2>}
              {testimonial && (
                <blockquote class="flex-auto">
                  <p class:list={[textColor]}>" {testimonial} "</p>
                </blockquote>
              )}

              <hr class:list={['my-4', hrColor]} />

              <div class="flex items-center">
                {image && (
                  <div class="h-10 w-10 rounded-full border border-slate-200 dark:border-slate-600">
                    {typeof image === 'string' ? (
                      <Fragment set:html={image} />
                    ) : (
                      <Image
                        class="h-10 w-10 rounded-full border border-slate-200 dark:border-slate-600 min-w-full min-h-full"
                        width={40}
                        height={40}
                        layout="fixed"
                        format="webp"
                        {...image}
                      />
                    )}
                  </div>
                )}

                <div class="grow ml-3 rtl:ml-0 rtl:mr-3">
                  {name && <p class:list={['text-base font-semibold', nameColor]}>{name}</p>}
                  {job && <p class:list={['text-xs', jobColor]}>{job}</p>}
                </div>
              </div>
            </div>
          </div>
        ))
    }
  </div>
  {
    callToAction && (
      <div class="flex justify-start w-fit mt-8 md:mt-12 font-medium">
        <Button {...callToAction} />
      </div>
    )
  }
</WidgetWrapper>
