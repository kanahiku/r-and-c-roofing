---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import MotifLayer from '~/components/ui/MotifLayer.astro';
import { MOTIF, MOTIF_COLOR_VARS, MOTIF_OPACITY_VARS } from '~/config/motif';

export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
  showAfterHoursNote?: boolean;
  license?: string;
  extraLines?: string[];
}

const {
  title,
  subtitle,
  ctaText = 'Schedule a Roof Inspection',
  ctaHref = '/contact',
  showAfterHoursNote = false,
  license,
  extraLines = [],
} = Astro.props;
---

<WidgetWrapper containerClass="max-w-[1400px] mx-auto">
  <div class="relative w-full p-8 md:p-12 rounded-md overflow-hidden bg-accent">
    {MOTIF.sections.cta && (
      <MotifLayer
        color={MOTIF_COLOR_VARS.cta}
        opacityFallback={MOTIF_OPACITY_VARS.cta}
        class="rounded-md"
      />
    )}
    
    <div class="relative z-10">
      <div class="text-center mb-8 md:mb-10">
        <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-black mb-4">
          {title}
        </h2>
        <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-black/70" set:html={subtitle} />
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-t-2 border-black pt-8">
        <div class="text-[15px] md:text-[16px] font-medium leading-[180%] text-black/70">
          <p class="font-semibold text-black text-[16px] md:text-[17px]">R&amp;C Roofing Contractors</p>
          <p>3302 Campbell Ave, Honolulu, HI 96815</p>
          <p>(808) 888-2524</p>
          {extraLines.map((line) => (
            <p set:html={line} />
          ))}
          {license && <p>{license}</p>}
          {showAfterHoursNote && (
            <p class="mt-2 text-[13px] md:text-[14px] italic">After-hours roofing concern? Use the online chat to contact the team.</p>
          )}
        </div>
        <div class="shrink-0">
          <a href={ctaHref} class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-black text-white font-semibold text-[15px] leading-snug hover:bg-zinc-900 transition-colors duration-200">{ctaText}</a>
        </div>
      </div>
    </div>
  </div>
</WidgetWrapper>
