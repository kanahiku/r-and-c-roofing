---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Features as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 3,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
  cardClass,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const columnsClass =
  columns === 4
    ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
    : columns === 3
      ? 'lg:grid-cols-3 sm:grid-cols-2'
      : columns === 2
        ? 'sm:grid-cols-2'
        : '';

const cardBg = cardClass ?? (isDark
  ? 'border-white/15 bg-white/5 backdrop-blur-sm'
  : 'border-accent/50 bg-white dark:bg-slate-900');

const cardTitle = isDark ? 'text-white' : '';
const cardDesc = isDark ? 'text-white/70' : 'text-muted';

const headlineClasses = isDark
  ? { title: 'text-[30px] md:text-[40px] font-normal leading-[120%] text-white', subtitle: 'text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70' }
  : (classes?.headline as Record<string, string>);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-[1400px] mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={headlineClasses} />

  {
    items.length > 0 && (
      <div class:list={['grid gap-4 md:gap-6 gap-x-12', columnsClass]}>
        {items.map(({ title: itemTitle, description, icon, callToAction }) => (
          <div class:list={['relative flex flex-col rounded-lg p-6 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade', cardBg]}>
            {(icon || defaultIcon) && <Icon name={icon || defaultIcon} class="mb-6 w-12 h-12 text-primary" />}
            <h3 class:list={['text-[22px] md:text-[26px] font-medium font-heading leading-[130%]', cardTitle]}>
              {itemTitle}
            </h3>
            {description && (
              <p class:list={['text-[14px] md:text-[15px] font-medium leading-[160%] mt-2', cardDesc]} set:html={description} />
            )}
            {callToAction && (
              <div class="mt-auto pt-4">
                <Button {...callToAction} />
              </div>
            )}
          </div>
        ))}
      </div>
    )
  }
</WidgetWrapper>
