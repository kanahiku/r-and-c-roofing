---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';

import simplePattern from '~/assets/images/patterns/simple.svg';

const metadata = {
  title: 'Roof Insurance Claim Help Hawaii | R&C Roofing',
  description:
    'Get roof insurance claim help from R&C Roofing Contractors on Oahu. We inspect roof damage, document findings, provide roofing scope information, and complete approved repair work.',
  ignoreTitleTemplate: true,
};

const yelpEmbeds = `
<span class="yelp-review" data-review-id="wfK95mJOJuhlnDWT6027ow" data-hostname="www.yelp.com">Read <a href="https://www.yelp.com/user_details?userid=RiSfA-nw1ngEY_q6tzwoQA" rel="nofollow noopener">Ronald C.</a>'s <a href="https://www.yelp.com/biz/r-and-c-roofing-contractors-honolulu?hrid=wfK95mJOJuhlnDWT6027ow" rel="nofollow noopener">review</a> of <a href="https://www.yelp.com/biz/2YU-fBK6jEfW12MP_E_r6g" rel="nofollow noopener">R &amp; C Roofing Contractors</a> on <a href="https://www.yelp.com" rel="nofollow noopener">Yelp</a><script src="https://www.yelp.com/embed/widgets.js" type="text/javascript" async><\/script></span>
<span class="yelp-review" data-review-id="FB6iD9eGHe6Z2DRhu3Szgw" data-hostname="www.yelp.com">Read <a href="https://www.yelp.com/user_details?userid=jKtqiGp_z46RAmwxolPp7Q" rel="nofollow noopener">Nancy M.</a>'s <a href="https://www.yelp.com/biz/r-and-c-roofing-contractors-honolulu?hrid=FB6iD9eGHe6Z2DRhu3Szgw" rel="nofollow noopener">review</a> of <a href="https://www.yelp.com/biz/2YU-fBK6jEfW12MP_E_r6g" rel="nofollow noopener">R &amp; C Roofing Contractors</a> on <a href="https://www.yelp.com" rel="nofollow noopener">Yelp</a><script src="https://www.yelp.com/embed/widgets.js" type="text/javascript" async><\/script></span>
<span class="yelp-review" data-review-id="cuFBoA_QIJoI59bmAyuDrg" data-hostname="www.yelp.com">Read <a href="https://www.yelp.com/user_details?userid=SW5560TYBu1fHCisx3wHWA" rel="nofollow noopener">Herman Y.</a>'s <a href="https://www.yelp.com/biz/r-and-c-roofing-contractors-honolulu?hrid=cuFBoA_QIJoI59bmAyuDrg" rel="nofollow noopener">review</a> of <a href="https://www.yelp.com/biz/2YU-fBK6jEfW12MP_E_r6g" rel="nofollow noopener">R &amp; C Roofing Contractors</a> on <a href="https://www.yelp.com" rel="nofollow noopener">Yelp</a><script src="https://www.yelp.com/embed/widgets.js" type="text/javascript" async><\/script></span>
`;
---

<Layout metadata={metadata}>

  <!-- Hero — White + motif -->
  <Hero2
    actions={[{ variant: 'primary', text: 'Schedule a Roof Damage Inspection', href: '/contact' }]}
    image={{ src: 'https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=2070&q=80', alt: 'Roof insurance claim help on Oahu' }}
  >
    <Fragment slot="title">Roof Insurance<br />Claim Help on Oahu</Fragment>
    <Fragment slot="subtitle">
      <span class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Understand the Damage Before You Move Forward
      </span>
      Roof damage can raise a lot of questions. What happened to the roof? What needs to be repaired? What information will your insurance carrier ask for?
      <br /><br />
      R&C Roofing Contractors helps Oahu property owners understand the roofing side of an insurance claim. We inspect visible roof damage, document relevant findings, and provide contractor-side information about the work that may be needed.
      <br /><br />
      Our team includes HAAG Certified Inspector Robert Pilato, Certification #201408313, with specialized training in roof damage assessment. R&C is also a licensed Hawaii roofing contractor, License C-33642.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0" style="-webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, transparent 100%);">
        <div
          class="absolute inset-0 opacity-[6%]"
          style={`background-color: var(--aw-color-accent); -webkit-mask-image: url('${simplePattern.src}'); mask-image: url('${simplePattern.src}'); -webkit-mask-size: cover; mask-size: cover; -webkit-mask-mode: luminance; mask-mode: luminance;`}
          aria-hidden="true"
        ></div>
      </div>
    </Fragment>
  </Hero2>

  <!-- How R&C Can Help — Grey #FAFAFA, black cards -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="How R&C Can Help With Your Roof Claim" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      R&C supports the roofing portion of the claim process. We do not act as your insurance representative or public adjuster.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      <div class="rounded-lg border border-accent/60 bg-[#222] p-6">
        <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-4 text-green-400">R&amp;C Can Help With</h3>
        <ul class="space-y-3 text-[15px] md:text-[16px] font-medium leading-[160%] text-white/70">
          <li class="flex gap-3"><span class="shrink-0 text-green-500 mt-0.5">✓</span>Inspect accessible areas of the roof for visible damage</li>
          <li class="flex gap-3"><span class="shrink-0 text-green-500 mt-0.5">✓</span>Photograph and document relevant roof conditions</li>
          <li class="flex gap-3"><span class="shrink-0 text-green-500 mt-0.5">✓</span>Identify roofing components that may need repair or replacement</li>
          <li class="flex gap-3"><span class="shrink-0 text-green-500 mt-0.5">✓</span>Prepare contractor estimates or roofing scope information when applicable</li>
          <li class="flex gap-3"><span class="shrink-0 text-green-500 mt-0.5">✓</span>Provide contractor-side information requested during claim review</li>
          <li class="flex gap-3"><span class="shrink-0 text-green-500 mt-0.5">✓</span>Complete roofing work when a project moves forward</li>
        </ul>
      </div>
      <div class="rounded-lg border border-accent/60 bg-[#222] p-6">
        <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-4 text-white/50">R&amp;C Does Not Do</h3>
        <ul class="space-y-3 text-[15px] md:text-[16px] font-medium leading-[160%] text-white/70">
          <li class="flex gap-3"><span class="shrink-0 text-white/40 mt-0.5">—</span>Act as a public adjuster or legal representative</li>
          <li class="flex gap-3"><span class="shrink-0 text-white/40 mt-0.5">—</span>Negotiate your insurance settlement</li>
          <li class="flex gap-3"><span class="shrink-0 text-white/40 mt-0.5">—</span>Determine whether your policy provides coverage</li>
          <li class="flex gap-3"><span class="shrink-0 text-white/40 mt-0.5">—</span>Guarantee that a claim will be approved or paid</li>
          <li class="flex gap-3"><span class="shrink-0 text-white/40 mt-0.5">—</span>Represent you in a dispute with your insurance carrier</li>
          <li class="flex gap-3"><span class="shrink-0 text-white/40 mt-0.5">—</span>Make coverage decisions on behalf of your carrier</li>
        </ul>
      </div>
    </div>
    <p class="mt-6 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic">
      Your insurance carrier determines coverage under your policy. R&amp;C's role is to provide roofing expertise and documentation related to the condition of the property.
    </p>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Claim Process Steps — Black + motif -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white text-center mb-4 md:mb-6">
      How the Roof Insurance Claim Process Works
    </h2>
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Every claim is different, but the roofing portion of the process often follows a similar path.
    </p>
    <div class="flex flex-col gap-6 max-w-2xl mx-auto">
      {[
        {
          step: '1',
          title: 'Inspect the Roof',
          description:
            "R&C evaluates accessible roofing areas and looks for visible damage or deterioration related to your concern. If the issue followed a storm or high-wind event, the inspection can also document conditions that may be relevant to the timing of the damage.",
        },
        {
          step: '2',
          title: 'Document the Findings',
          description:
            "Photos and inspection notes create a record of the roof's condition. If roofing work appears necessary, R&C can also document the affected areas and explain the proposed scope.",
        },
        {
          step: '3',
          title: 'You Contact Your Insurance Carrier',
          description:
            "The policyholder files the claim directly with the insurance carrier. Your carrier will explain its claim requirements, deductible, coverage review, and any additional information it needs.",
        },
        {
          step: '4',
          title: 'R&C Provides Roofing Information as Needed',
          description:
            "During the claim review, R&C can provide contractor-side information related to the roof and proposed work when requested. Your insurance carrier or adjuster determines what information is required for the claim.",
        },
        {
          step: '5',
          title: 'Roofing Work Moves Forward',
          description:
            "If repair or replacement work is approved and you choose R&C for the project, our roofing team can complete the work based on the agreed scope.",
        },
      ].map(({ step, title, description }) => (
        <div class="flex gap-5 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div class="shrink-0 w-9 h-9 rounded-full bg-accent flex items-center justify-center font-heading font-medium text-[15px] text-black mt-0.5">
            {step}
          </div>
          <div>
            <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-1 text-white">{title}</h3>
            <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/70">{description}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/insurance-claim-help/how-the-claim-process-works" class="btn-primary">See How the Claim Process Works</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-black"></div>
      <div class="absolute inset-0" style="-webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, transparent 100%);">
        <div
          class="absolute inset-0 opacity-[8%]"
          style={`background-color: var(--aw-color-accent); -webkit-mask-image: url('${simplePattern.src}'); mask-image: url('${simplePattern.src}'); -webkit-mask-size: cover; mask-size: cover; -webkit-mask-mode: luminance; mask-mode: luminance;`}
          aria-hidden="true"
        ></div>
      </div>
    </Fragment>
  </WidgetWrapper>

  <!-- Roofing Documentation — White, P-06 style 3+2 grid -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline
      title="Roofing Documentation That May Be Useful During a Claim"
      classes={{ container: 'mb-4 md:mb-6' }}
    />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Insurance carriers may request information about the condition of the roof and the work needed to address the damage. Depending on the property and inspection findings, R&amp;C may provide:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mb-4 md:mb-6">
      {[
        {
          title: 'Photos of Visible Roof Conditions',
          description:
            'Relevant areas can be photographed to create a record of what was observed during the inspection.',
        },
        {
          title: 'Location of Observed Damage',
          description:
            'Documenting where a condition appears can help explain which areas of the roofing system may require attention.',
        },
        {
          title: 'Roofing Component Details',
          description:
            'The findings may identify affected roofing materials, flashing, penetrations, fasteners, or other accessible roof components.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-3 text-heading">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
      {[
        {
          title: 'Proposed Roofing Scope',
          description:
            'If repair or replacement is recommended, R&C can provide contractor-side information about the proposed work.',
        },
        {
          title: 'Roofing Estimate',
          description:
            'When applicable, an estimate can outline the roofing work being proposed and the associated project cost.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-3 text-heading">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic">
      The exact documents needed for an insurance claim depend on the carrier and the policy.
    </p>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Why Questions Arise — Grey #FAFAFA -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Why Questions About Roof Damage Can Come Up During a Claim
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 max-w-4xl">
      <p>Visible roof damage does not always have one obvious cause.</p>
      <p>A roof may already show signs of age or previous repairs when a new weather event occurs. Existing deterioration can also appear near newly damaged areas.</p>
      <p>During a claim, questions may arise about whether a condition developed over time or whether it may be associated with a more recent event.</p>
      <p>R&amp;C's role is to document what we observe on the roofing system and explain the contractor-side findings. We do not determine insurance coverage or make decisions about the cause of loss on behalf of the carrier.</p>
      <p>A closer roof assessment can be especially useful when the condition is not easy to understand from the ground.</p>
    </div>
    <div class="mt-8">
      <a href="/roof-inspections/haag-certified-inspection" class="inline-flex items-center justify-center px-6 py-3 rounded-md border-2 border-black text-black font-semibold text-[15px] leading-snug hover:bg-black hover:text-white transition-colors duration-200">Learn About HAAG Certified Roof Inspections</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Insurance Terms — Black + motif, dark cards -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white text-center mb-4 md:mb-6">
      Understanding Common Roof Insurance Terms
    </h2>
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Insurance documents can use terms that are unfamiliar if you have never filed a property claim before. These are three terms you may encounter during the process.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
      {[
        {
          title: 'Actual Cash Value (ACV)',
          description:
            'Actual Cash Value generally refers to a valuation that accounts for depreciation. How ACV applies to your roof depends on your individual policy and claim.',
        },
        {
          title: 'Replacement Cost Value (RCV)',
          description:
            'Replacement Cost Value generally refers to the cost of replacing damaged property with comparable property, subject to the conditions and limits of the policy. Your carrier can explain how RCV applies to your specific coverage.',
        },
        {
          title: 'Deductible',
          description:
            'A deductible is the amount or portion of a covered loss that the policyholder is responsible for under the policy. Some policies may apply different deductible provisions to certain weather events. Review your policy or contact your carrier for the terms that apply to your property.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-accent/60 bg-[#222] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60">{description}</p>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-black"></div>
      <div class="absolute inset-0" style="-webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, transparent 100%);">
        <div
          class="absolute inset-0 opacity-[8%]"
          style={`background-color: var(--aw-color-accent); -webkit-mask-image: url('${simplePattern.src}'); mask-image: url('${simplePattern.src}'); -webkit-mask-size: cover; mask-size: cover; -webkit-mask-mode: luminance; mask-mode: luminance;`}
          aria-hidden="true"
        ></div>
      </div>
    </Fragment>
  </WidgetWrapper>

  <!-- HAAG Fits In — White -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Where HAAG Certified Inspection Fits In
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 max-w-4xl">
      <p>R&amp;C's Robert Pilato holds HAAG Certification #201408313.</p>
      <p>HAAG certification includes specialized education and testing in roof damage assessment. That training adds another level of roofing-specific expertise when R&amp;C evaluates visible damage and surrounding roof conditions.</p>
      <p>For an insurance-related inspection, that can help provide clearer contractor-side documentation of what was observed on the roof.</p>
      <p>A HAAG Certified inspection does not determine whether damage is covered by insurance and does not guarantee a claim outcome.</p>
    </div>
    <div class="mt-8">
      <a href="/roof-inspections/haag-certified-inspection" class="btn-primary">Explore HAAG Certified Roof Inspections</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Real Client Experience — Grey #FAFAFA -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Real Client Experience" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8">
      R&C has worked with Oahu property owners whose roofing projects involved insurance claims.
    </p>
    <div class="flex flex-col sm:flex-row flex-wrap gap-6" set:html={yelpEmbeds} />
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Explore Resources — Black + motif, dark cards -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white text-center mb-4 md:mb-6">
      Explore Our Roof Claim Resources
    </h2>
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Use these resources to learn more about the part of the process that applies to your situation.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
      {[
        {
          title: 'How the Claim Process Works',
          description:
            'Follow the roofing side of the claim process from inspection through the proposed repair or replacement work.',
          href: '/insurance-claim-help/how-the-claim-process-works',
          linkText: 'View the Claim Process →',
        },
        {
          title: 'Denied or Underpaid Roof Claims',
          description:
            'Learn what information to review if your carrier denies the claim or the approved scope differs from the roofing work being recommended.',
          href: '/insurance-claim-help/denied-or-underpaid-claims',
          linkText: 'Learn About Denied or Underpaid Claims →',
        },
        {
          title: 'Storm & Wind Damage Inspections',
          description:
            'Have your roof evaluated after strong winds or severe weather and document relevant visible conditions.',
          href: '/roof-inspections/storm-and-wind-damage-inspection',
          linkText: 'View Storm Damage Inspections →',
        },
      ].map(({ title, description, href, linkText }) => (
        <div class="rounded-lg border border-accent/60 bg-[#222] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60 mb-4 flex-1">{description}</p>
          <a href={href} class="text-accent font-medium text-[14px] md:text-[15px] hover:underline mt-auto">{linkText}</a>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-black"></div>
      <div class="absolute inset-0" style="-webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, transparent 100%);">
        <div
          class="absolute inset-0 opacity-[8%]"
          style={`background-color: var(--aw-color-accent); -webkit-mask-image: url('${simplePattern.src}'); mask-image: url('${simplePattern.src}'); -webkit-mask-size: cover; mask-size: cover; -webkit-mask-mode: luminance; mask-mode: luminance;`}
          aria-hidden="true"
        ></div>
      </div>
    </Fragment>
  </WidgetWrapper>

  <!-- FAQ — White -->
  <FAQs
    title="Frequently Asked Questions"
    items={[
      {
        title: 'Should I call R&C before filing an insurance claim?',
        description:
          "You can schedule a roof inspection whenever you need more information about the condition of the roof. Whether and when to file an insurance claim is your decision. Your insurance carrier can explain the requirements and deadlines that apply under your policy.",
      },
      {
        title: 'Can R&C tell me whether my roof damage is covered?',
        description:
          "No. Coverage is determined by your insurance carrier based on the terms of your policy and its claim review.<br><br>R&C can inspect visible roof conditions and provide contractor-side information about the roofing work that may be needed.",
      },
      {
        title: 'Can R&C help document storm damage?',
        description:
          "Yes. R&C can inspect accessible roofing areas and document relevant visible findings after a storm or other weather event.",
      },
      {
        title: 'Does R&C negotiate with the insurance company?',
        description:
          "No. R&C Roofing Contractors is not a public adjuster and does not negotiate insurance settlements or represent policyholders in claim negotiations.",
      },
      {
        title: 'Can R&C provide a roofing estimate for my claim?',
        description:
          "When roofing work is recommended, R&C can provide contractor-side scope and estimate information as appropriate for the project.",
      },
      {
        title: 'What if my insurance claim is denied?',
        description:
