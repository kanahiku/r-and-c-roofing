---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import Button from '~/components/ui/Button.astro';
import FormContainer from '~/components/ui/Form.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import HeroSubtitle from '~/components/ui/HeroSubtitle.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import RelatedBlogs from '~/components/widgets/RelatedBlogs.astro';
import Image from '~/components/common/Image.astro';
import { getContactPage } from '~/lib/content';
import { contactAddress, mapsDirectionsHref, mapsEmbedSrc } from '~/data/pages/contact';

const page = await getContactPage();
const mapsQuery = page.form.mapsQuery || contactAddress.mapsQuery;
const heroImage = page.hero.image;
const splitImage = page.unsureSection.image;

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};

const heroActions = [
  ...(page.hero.ctaText
    ? [{ variant: 'primary' as const, text: page.hero.ctaText, href: page.hero.ctaHref || '/contact' }]
    : []),
  ...(page.hero.phoneCtaText && page.hero.phoneCtaHref
    ? [{ variant: 'ghost-light' as const, text: page.hero.phoneCtaText, href: page.hero.phoneCtaHref }]
    : []),
];
---

<Layout metadata={metadata}>
  <Hero2 actions={heroActions.length ? heroActions : undefined}>
    <Fragment slot="title">{page.hero.title}</Fragment>
    <Fragment slot="subtitle">
      <HeroSubtitle visualSubheading={page.hero.visualSubheading} subtitle={page.hero.subtitle} />
    </Fragment>
    <Fragment slot="image">
      {
        heroImage ? (
          <Image
            src={heroImage.src}
            alt={heroImage.alt}
            class="w-full h-full object-cover"
            widths={[400, 768, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="eager"
            width={700}
            height={700}
            layout="cover"
            format="webp"
          />
        ) : (
          <HeroImagePlaceholder label={page.hero.imagePlaceholder || 'Contact page photo placeholder'} />
        )
      }
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper id="message" containerClass="max-w-[1400px] mx-auto">
    <Headline title={page.form.heading} classes={{ container: 'mb-[9px]' }} />
    {
      page.form.intro && (
        <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
          {page.form.intro}
        </p>
      )
    }
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-start">
      <div class="rounded-lg bg-white p-4 sm:p-6 lg:p-8">
        <FormContainer
          inputs={[
            { type: 'text', name: 'name', label: 'Name *', autocomplete: 'name', required: true },
            { type: 'email', name: 'email', label: 'Email *', autocomplete: 'email', required: true },
            { type: 'tel', name: 'phone', label: 'Phone *', autocomplete: 'tel', required: true },
            { type: 'text', name: 'zip', label: 'ZIP Code *', autocomplete: 'postal-code', required: true },
            {
              type: 'select',
              name: 'topic',
              label: page.form.topicLabel || 'What Can We Help You With? *',
              required: true,
              placeholder: page.form.topicPlaceholder || 'Select a topic',
              options: page.form.helpOptions,
            },
          ]}
          textarea={{ label: page.form.messageLabel || 'Tell Us What Is Happening', name: 'message', rows: 5 }}
          button={page.form.submitLabel || 'Send Message'}
        />
      </div>
      <div>
        <h3 class="text-[18px] md:text-[20px] font-medium leading-[130%] text-heading mb-3">
          {page.form.mapHeading || 'Find R&C Roofing Contractors'}
        </h3>
        <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted mb-4">
          {page.form.addressLine1 || contactAddress.line1}
          <br />
          {page.form.addressLine2 || contactAddress.city}
        </p>
        <div class="rounded-md overflow-hidden border border-accent/60 bg-[#222] aspect-[4/3] min-h-[280px]">
          <iframe
            title={`Map of R&C Roofing Contractors at ${mapsQuery}`}
            src={mapsEmbedSrc(mapsQuery)}
            class="w-full h-full min-h-[280px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        <div class="mt-6">
          <Button
            variant="ghost-light"
            text={page.form.directionsLabel || 'Get Directions'}
            href={mapsDirectionsHref(mapsQuery)}
            target="_blank"
          />
        </div>
      </div>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title={page.touchpoints.heading} classes={{ container: 'mb-[30px]' }} />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {
        page.touchpoints.items.map((item) => (
          <InfoCard title={item.title} description={item.description} icon={item.icon} variant="dark" />
        ))
      }
    </div>
    {
      page.touchpoints.links?.length ? (
        <p class="mt-8 md:mt-10 text-left">
          {page.touchpoints.links.map((link, index) => (
            <>
              {index > 0 && <span class="text-white/50"> · </span>}
              <a href={link.href} class="text-accent font-medium text-[14px] md:text-[15px] hover:underline">
                {link.text}
              </a>
            </>
          ))}
        </p>
      ) : null
    }
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <Content
    isReversed
    title={page.unsureSection.heading}
    callToAction={
      page.unsureSection.ctaText
        ? { variant: 'ghost-light', text: page.unsureSection.ctaText, href: page.unsureSection.ctaHref || '#message' }
        : undefined
    }
  >
    <Fragment slot="content">
      {
        page.unsureSection.paragraphs.map((paragraph, index) => (
          <p class:list={[index > 0 && 'mt-4', 'text-muted']}>{paragraph}</p>
        ))
      }
      {
        page.unsureSection.linkText && page.unsureSection.linkHref && (
          <p class="mt-4">
            <a
              href={page.unsureSection.linkHref}
              class="text-heading font-medium text-[14px] md:text-[15px] hover:underline"
            >
              {page.unsureSection.linkText}
            </a>
          </p>
        )
      }
    </Fragment>
    <Fragment slot="image">
      {
        splitImage ? (
          <Image
            src={splitImage.src}
            alt={splitImage.alt}
            class="w-full h-full object-cover"
            widths={[400, 768, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            width={700}
            height={700}
            layout="cover"
            format="webp"
          />
        ) : (
          <HeroImagePlaceholder fill label={page.unsureSection.imagePlaceholder || 'Roof inspection photo placeholder'} />
        )
      }
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </Content>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title={page.reasons.heading} classes={{ container: 'mb-[30px]' }} />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
      {
        page.reasons.items.map((card) => (
          <ServiceCard
            title={card.title}
            description={card.description}
            href={card.href}
            linkText={card.linkText}
            variant="dark"
          />
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <RelatedBlogs pageSlug="contact" surface="dark" />

  <CTABanner
    title={page.ctaBanner.title}
    subtitle={page.ctaBanner.subtitle}
    ctaText={page.ctaBanner.ctaText}
    ctaHref={page.ctaBanner.ctaHref}
    extraLines={page.ctaBanner.extraLines}
    license={page.ctaBanner.license}
    showAfterHoursNote={page.ctaBanner.showAfterHoursNote}
  />
</Layout>
