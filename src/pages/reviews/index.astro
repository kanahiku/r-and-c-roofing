---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { aboutHrefs, featuredYelpReviews, reviewPlatforms, verifiedQuotes } from '~/data/pages/about';

const metadata = {
  title: 'R&C Roofing Contractors Reviews | Honolulu, HI',
  description:
    'Read customer reviews of R&C Roofing Contractors from Google, Yelp, and BBB and see what Oahu property owners say about their roofing experience.',
  ignoreTitleTemplate: true,
};

const byProject = [
  {
    title: 'Roof Repair',
    description: `“${verifiedQuotes[2].quote}” — ${verifiedQuotes[2].name}`,
    href: aboutHrefs.repair,
    linkText: 'Explore Roof Repair',
  },
  {
    title: 'Roof Replacement',
    description: `“${verifiedQuotes[3].quote}” — ${verifiedQuotes[3].name}`,
    href: aboutHrefs.replacement,
    linkText: 'Explore Roof Replacement & New Installation',
  },
  {
    title: 'Residential Roofing',
    description: `“${verifiedQuotes[0].quote}” — ${verifiedQuotes[0].name}`,
    href: aboutHrefs.residential,
    linkText: 'Explore Residential Roofing',
  },
  {
    title: 'Commercial Roofing',
    description: `“${verifiedQuotes[4].quote}” — ${verifiedQuotes[4].name}`,
    href: aboutHrefs.commercial,
    linkText: 'Explore Commercial Roofing',
  },
];

const archiveQuotes = [verifiedQuotes[1], verifiedQuotes[0], verifiedQuotes[3], verifiedQuotes[4], verifiedQuotes[2]];
---

<Layout metadata={metadata}>
  <Hero2>
    <Fragment slot="title">R&amp;C Roofing Contractors Reviews</Fragment>
    <Fragment slot="subtitle">
      <span
        class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight"
      >
        What Customers Say About Working With R&amp;C
      </span>
      Choosing a roofing contractor usually means trusting someone with a part of your property you cannot easily
      evaluate on your own.
      <br /><br />
      That is why customer experience matters.
      <br /><br />
      Read feedback from people who have worked with R&amp;C Roofing Contractors on roof repairs, replacements,
      storm-related roofing concerns, and other roofing projects on Oahu.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Customer and project photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Reviews From Across the Web" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Customer feedback about R&amp;C Roofing Contractors can be found on multiple independent review platforms.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
      {
        reviewPlatforms.map((card) => (
          <div class="rounded-lg border border-accent/60 bg-[#222] p-4 md:p-5 flex flex-col h-full">
            <div class="mb-4 w-10 h-10 rounded-md border border-accent/60 flex items-center justify-center">
              <Icon name={card.icon} class="w-5 h-5 text-accent" aria-hidden="true" />
            </div>
            <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-2 text-white">
              {card.title}
            </h3>
            <p class="text-[14px] md:text-[15px] font-normal leading-[160%] text-white/60 flex-1">{card.ratingNote}</p>
            <div class="mt-auto pt-4">
              <Button variant="ghost-dark" text={card.linkText} href={card.href} target="_blank" />
            </div>
          </div>
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="Featured Customer Reviews" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Verified Yelp reviews, shown with their original wording and a link back to the source.
    </p>
    <div class="columns-1 md:columns-2 gap-x-8 md:gap-x-12">
      {
        featuredYelpReviews.map((review) => (
          <div class="break-inside-avoid mb-8 md:mb-10">
            <p class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] text-white">{review.name}</p>
            <p class="mt-1 text-[13px] md:text-[14px] font-medium uppercase tracking-wider text-accent">{review.source}</p>
            <div class="mt-4 yelp-review-grid" set:html={review.embed} />
            <a
              href={review.originalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-4 text-[14px] md:text-[15px] font-medium text-accent hover:underline"
            >
              View Original Review
            </a>
          </div>
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Reviews From Different Roofing Projects" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Customers come to R&amp;C for different reasons. Some are dealing with an active leak. Others need a roof replaced,
      have questions after strong weather, or simply want to understand what condition their roof is in.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
      {
        byProject.map((card) => (
          <ServiceCard
            title={card.title}
            description={card.description}
            href={card.href}
            linkText={card.linkText}
            variant="light"
          />
        ))
      }
    </div>
    <p class="mt-8 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted text-center">
      For storm or insurance-related roofing work, see
      <a href={aboutHrefs.storm} class="text-heading underline underline-offset-2">Storm Damage Roof Inspections</a>
      and
      <a href={aboutHrefs.claims} class="text-heading underline underline-offset-2">Insurance Claim Help</a>.
      Also explore
      <a href={aboutHrefs.inspections} class="text-heading underline underline-offset-2">Roof Inspections</a>.
    </p>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="More Customer Feedback" classes={{ container: 'mb-8 md:mb-12' }} />
    <div class="columns-1 sm:columns-2 gap-x-12 md:gap-x-16">
      {
        archiveQuotes.map((item) => (
          <blockquote class="break-inside-avoid mb-8 md:mb-10">
            <p class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] text-heading">{item.name}</p>
            <p class="mt-1 text-[13px] md:text-[14px] font-medium uppercase tracking-wider text-muted">{item.source}</p>
            <p class="mt-3 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">“{item.quote}”</p>
            <a
              href={item.originalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-3 text-[14px] md:text-[15px] font-medium text-heading hover:underline"
            >
              View Original Review
            </a>
          </blockquote>
        ))
      }
    </div>
    <div class="mt-8 md:mt-10 text-center">
      <Button
        variant="ghost-light"
        text="Load More Reviews"
        href="https://www.yelp.com/biz/r-and-c-roofing-contractors-honolulu"
        target="_blank"
      />
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <Content
    isReversed
    title="See the Roofing Work Behind the Reviews"
    callToAction={{ variant: 'ghost-light', text: 'View Project Gallery', href: aboutHrefs.gallery }}
  >
    <Fragment slot="content">
      <p class="text-muted">Customer feedback tells one part of the story. The finished work tells another.</p>
      <p class="mt-4 text-muted">
        Explore completed R&amp;C roofing projects across Oahu, including before-and-after photos, project locations,
        roofing materials, and the work completed.
      </p>
    </Fragment>
    <Fragment slot="image">
      <div class="grid grid-cols-2 gap-3">
        <HeroImagePlaceholder label="Gallery preview 1" />
        <HeroImagePlaceholder label="Gallery preview 2" />
        <HeroImagePlaceholder label="Gallery preview 3" />
        <HeroImagePlaceholder label="Gallery preview 4" />
      </div>
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </Content>

  <CTABanner
    title="Have a Roofing Question of Your Own?"
    subtitle="If something is happening with your roof, you do not need to know the solution before you call.<br /><br />R&amp;C can evaluate the roof and help determine what roofing work should be considered next."
    ctaText="Schedule a Roof Inspection"
    license="Hawaii Contractor License C-33642"
  />
</Layout>
