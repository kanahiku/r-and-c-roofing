---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Image from '~/components/common/Image.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import BenefitItem from '~/components/ui/BenefitItem.astro';
import ProjectsSection from '~/components/widgets/ProjectsSection.astro';

import { getHomeContent } from '~/lib/content';

// Badge images stay as local imports — these are award/certification logos
// that are static design assets rather than editable content.
import achievementHawaiiBest from '~/assets/images/achievements/r-c-roofing-contractors-roofing-contractor-in-honolulu-hi.image.74377991fdf859f8e79407a88c8ef4677add71ebf7dd4d598bd921dc1e0ee0ad02file_uploadHawaiisBest2023logoFIRSTPLACE-6220366.Woblo.webp';
import achievementBBB from '~/assets/images/achievements/r-c-roofing-contractors-roofing-contractor-in-honolulu-hi.image.415e6e4191400e10c7ae56acccd083a6BBBRCRoofingContractors-6220365.Woblo.webp';
import achievementTorch from '~/assets/images/achievements/r-c-roofing-contractors-roofing-contractor-in-honolulu-hi.image.2cd1e450d55bb0570c63c444b47ceb22bbbtorchawards2017finalist-6220366.Woblo.webp';

const page = await getHomeContent();

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero (Left-Right Split) -->
  <Hero2
    actions={[{ variant: 'primary', text: page.hero.ctaText, href: page.hero.ctaHref }]}
    image={page.hero.heroImage.src ? { src: page.hero.heroImage.src, alt: page.hero.heroImage.alt } : undefined}
  >
    <Fragment slot="title">
      {page.hero.titleLine1}<br />{page.hero.titleLine2}
    </Fragment>

    <Fragment slot="subtitle">
      {page.hero.subtitleParagraph1}
      <br /><br />
      {page.hero.subtitleParagraph2}
    </Fragment>

    <Fragment slot="content">
      <div class="flex flex-wrap items-center gap-5 mt-6">
        <img
          src={achievementHawaiiBest.src}
          alt="Hawaii's Best 2023 First Place"
          class="h-14 w-auto max-w-[100px] object-contain"
        />
        <img
          src={achievementBBB.src}
          alt="BBB Accredited Business"
          class="h-14 w-auto max-w-[100px] object-contain"
        />
        <img
          src={achievementTorch.src}
          alt="BBB Torch Awards 2017 Finalist"
          class="h-14 w-auto max-w-[100px] object-contain"
        />
      </div>
    </Fragment>

    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <!-- Stats Bar -->
  <section class="bg-[#222] py-6 md:py-8">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 text-center">
        {page.statsBar.map(({ stat, label }) => (
          <div class="flex flex-col items-center">
            <span class="text-[28px] md:text-[36px] font-medium font-heading leading-tight text-accent">{stat}</span>
            <span class="text-[13px] md:text-[14px] font-medium text-white/60 mt-1">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Start With a Roof Inspection? -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-[#111111] text-center mb-8 md:mb-12">
      {page.whyInspect.heading}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-start">
      <div class="md:col-span-6 flex flex-col gap-6 md:self-center">
        <div class="w-full h-56 md:h-64 bg-gray-100 dark:bg-slate-800 rounded-lg flex items-center justify-center text-gray-300 dark:text-slate-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-[#444444] dark:text-slate-400">
          <p>{page.whyInspect.paragraph1}</p>
          <p class="mt-4">{page.whyInspect.paragraph2}</p>
        </div>
        <div>
          <a href={page.whyInspect.ctaHref} class="btn-primary">{page.whyInspect.ctaText}</a>
        </div>
      </div>

      <div class="md:col-span-6">
        <div class="grid grid-cols-1 gap-3 md:gap-4">
          {page.whyInspect.infoCards.map((card) => (
            <InfoCard title={card.title} description={card.description} border={false} />
          ))}
        </div>
      </div>
    </div>

    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- How Can We Help You Today? -->
  <Features2
    title={page.servicesSection.title}
    subtitle={page.servicesSection.subtitle}
    isDark={true}
    cardClass="border border-accent/60 bg-[#222]"
    items={page.servicesSection.services.map((s) => ({
      title: s.title,
      description: s.description,
      callToAction: {
        variant: 'link',
        text: s.linkText,
        href: s.linkHref,
        class: 'text-accent font-medium text-[14px] md:text-[15px] hover:underline',
      },
    }))}
  >
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </Features2>

  <!-- Oahu Roofing Conditions -->
  <Content
    title={page.oahuConditions.title}
    callToAction={{
      variant: 'primary',
      text: page.oahuConditions.ctaText,
      href: page.oahuConditions.ctaHref,
    }}
    image={page.oahuConditions.image.src ? { src: page.oahuConditions.image.src, alt: page.oahuConditions.image.alt } : undefined}
    classes={{ title: 'text-[#111111]' }}
  >
    <Fragment slot="content">
      <p class="text-[#444444]">{page.oahuConditions.paragraph1}</p>
      <p class="mt-4 text-[#444444]">{page.oahuConditions.paragraph2}</p>
      <p class="mt-4 text-[#444444]">{page.oahuConditions.paragraph3}</p>
    </Fragment>

    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </Content>

  <!-- Why Property Owners Choose R&C -->
  <WidgetWrapper id="why-rc" containerClass="max-w-[1400px] mx-auto">
    <div class="text-center mb-10 md:mb-14">
      <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-[#111111] mb-0">
        {page.whyRC.heading}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-8 md:gap-y-10">
      {page.whyRC.benefits.map((benefit) => (
        <BenefitItem title={benefit.title} description={benefit.description} />
      ))}
    </div>

    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- Insurance Claims Process -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 md:mb-12">
      <div>
        <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white">
          {page.insuranceClaims.heading}
        </h2>
      </div>
      <a href={page.insuranceClaims.ctaHref} class="btn-primary shrink-0">{page.insuranceClaims.ctaText}</a>
    </div>

    <div class="flex flex-col md:flex-row gap-10 md:gap-16">
      <div class="md:basis-1/2 flex flex-col gap-6">
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
          <p>{page.insuranceClaims.paragraph1}</p>
          <p class="mt-4">{page.insuranceClaims.paragraph2}</p>
        </div>
        {page.insuranceClaims.image.src && (
          <Image
            class="w-full rounded-lg shadow-lg object-cover"
            src={page.insuranceClaims.image.src}
            alt={page.insuranceClaims.image.alt}
            width={600}
            height={400}
            widths={[400, 768]}
            sizes="(max-width: 768px) 100vw, 50vw"
            format="webp"
            layout="constrained"
          />
        )}
        <p class="text-[13px] md:text-[14px] font-medium leading-[160%] text-white/50 mt-4">
          {page.insuranceClaims.disclaimer}
        </p>
      </div>

      <div class="md:basis-1/2">
        <Timeline
          isDark={true}
          items={page.insuranceClaims.timelineSteps.map((step) => ({
            title: step.title,
            description: step.description,
            icon: step.icon,
          }))}
        />
      </div>
    </div>

    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- Recent Projects -->
  <ProjectsSection
    title={page.recentProjects.title}
    subtitle={page.recentProjects.subtitle}
    projects={page.recentProjects.projects}
    ctaText={page.recentProjects.ctaText}
    ctaHref={page.recentProjects.ctaHref}
  >
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </ProjectsSection>

  <!-- Testimonials -->
  <Testimonials
    title={page.testimonials.title}
    subtitle={page.testimonials.subtitle}
    isDark={true}
    cardClass="border border-accent/60 bg-[#222]"
    classes={{ headline: { title: 'text-[30px] md:text-[40px] font-normal leading-[120%] text-[#111111]', subtitle: 'text-[16px] md:text-[17px] font-medium leading-[160%] text-[#444444]' } }}
    testimonials={page.testimonials.items.map((t) => ({
      testimonial: t.testimonial,
      name: t.name,
      job: t.job,
    }))}
    callToAction={{
      variant: 'ghost-light',
      text: page.testimonials.ctaText,
      href: page.testimonials.ctaHref,
    }}
  >
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </Testimonials>

  <!-- Service Areas -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <div class="text-center mb-4 md:mb-6">
      <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white mb-3">
        {page.serviceAreas.heading}
      </h2>
    </div>
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      {page.serviceAreas.subheading}
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4">
      {page.serviceAreas.areas.map((area) => (
        <InfoCard title={area.title} description={area.description} size="sm" />
      ))}
    </div>

    <div class="mt-8 md:mt-10 text-center">
      <a href={page.serviceAreas.ctaHref} class="inline-flex items-center justify-center px-6 py-3 rounded-md border border-accent text-accent font-semibold text-[15px] leading-snug hover:bg-accent hover:text-[#111111] transition-colors duration-200">
        {page.serviceAreas.ctaText}
      </a>
    </div>

    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- FAQs -->
  <FAQs
    title={page.faqs.title}
    classes={{
      headline: { title: 'text-[30px] md:text-[40px] font-normal leading-[120%] text-[#111111]' },
      question: 'text-[#111111]',
      answer: 'text-[#444444] dark:text-slate-400',
    }}
    items={page.faqs.items.map((faq) => ({
      title: faq.question,
      description: faq.answer,
    }))}
  />

  <!-- Final CTA -->
  <CTABanner
    title={page.ctaBanner.title}
    subtitle={page.ctaBanner.subtitle}
    showAfterHoursNote={page.ctaBanner.showAfterHoursNote}
  />
</Layout>
