---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Timeline from '~/components/ui/Timeline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import InfoCard from '~/components/ui/InfoCard.astro';

import { getHomeContent } from '~/lib/content';

import awardLogoOne from '~/assets/images/achievements/award-logo-one.svg';
import awardLogoTwo from '~/assets/images/achievements/award-logo-two.svg';
import awardLogoThree from '~/assets/images/achievements/award-logo-three.svg';

const page = await getHomeContent();

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};

const heroActions = [
  { variant: 'primary', text: page.hero.ctaText, href: page.hero.ctaHref },
  ...(page.hero.phoneCtaText && page.hero.phoneCtaHref
    ? [{ variant: 'ghost-dark', text: page.hero.phoneCtaText, href: page.hero.phoneCtaHref }]
    : []),
];

const heroDesktop = page.hero.heroImage.src ? page.hero.heroImage : undefined;
const heroMobile = page.hero.heroImageMobile?.src ? page.hero.heroImageMobile : undefined;

const roofDamageSteps = (page.roofDamageProcess.steps ?? []).map((step) => ({
  title: step.title,
  description: step.description,
  icon: step.icon,
}));
---

<Layout metadata={metadata}>
  <!-- P-01 Hero — overlay variant (homepage only) -->
  <Hero2 variant="overlay" actions={heroActions} image={heroDesktop} imageMobile={heroMobile}>
    <Fragment slot="title">
      {page.hero.titleLine1}<br />{page.hero.titleLine2}
    </Fragment>

    <Fragment slot="subtitle">
      {page.hero.subtitleParagraph1}
    </Fragment>

    <Fragment slot="content">
      <div class="flex flex-wrap items-center gap-5 mt-6">
        <img
          src={awardLogoOne.src}
          alt="Hawaii's Best 2023 First Place"
          class="h-14 w-auto object-contain"
        />
        <img
          src={awardLogoTwo.src}
          alt="BBB Accredited Business"
          class="h-14 w-auto object-contain"
        />
        <img
          src={awardLogoThree.src}
          alt="BBB Torch Awards 2017 Finalist"
          class="h-14 w-auto object-contain"
        />
      </div>
    </Fragment>

    <Fragment slot="stats">
      <div class="grid grid-cols-2 gap-y-4 md:flex md:items-center md:justify-between md:gap-y-0">
        {page.statsBar.map(({ stat, label }) => (
          <div class="flex flex-col items-center justify-center text-center px-3 py-1 md:px-0 md:py-0">
            <span class="text-[22px] md:text-[42px] font-normal font-heading leading-[110%] tracking-tighter text-accent">
              {stat}
            </span>
            <span class="mt-0.5 text-[13px] md:text-[14px] font-medium uppercase tracking-wider leading-[140%] text-white/80 md:whitespace-nowrap">
              {label}
            </span>
          </div>
        ))}
      </div>
    </Fragment>
  </Hero2>

  <!-- P-03 Why We Start With an Inspection — image right -->
  <Content
    title={page.whyInspect.heading}
    callToAction={{ variant: 'ghost-light', text: page.whyInspect.ctaText, href: page.whyInspect.ctaHref }}
    image={page.whyInspect.image?.src ? { src: page.whyInspect.image.src, alt: page.whyInspect.image.alt } : undefined}
  >
    <Fragment slot="content">
      <p class="text-muted">{page.whyInspect.paragraph1}</p>
      <p class="mt-4 text-muted">{page.whyInspect.paragraph2}</p>
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </Content>

  <!-- How Can We Help You Today? -->
  <Features2
    title={page.servicesSection.title}
    subtitle={page.servicesSection.subtitle}
    isDark={true}
    cardClass="border border-accent/60 bg-[#222]"
    items={page.servicesSection.services.map((s) => ({
      title: s.title,
      description: s.description,
      callToAction: {
        variant: 'link',
        text: s.linkText,
        href: s.linkHref,
        class: 'text-accent font-medium text-[14px] md:text-[15px]',
      },
    }))}
  >
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </Features2>

  <!-- P-02 Built for Oahu Roofing Conditions -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title={page.oahuConditions.title} classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      {page.oahuConditions.paragraph1}
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-4">
      {(page.oahuConditions.cards ?? []).map((card) => (
        <InfoCard title={card.title} description={card.description} icon={card.icon} variant="light" border={false} />
      ))}
    </div>
    <div class="mt-8 md:mt-10">
      <a href={page.oahuConditions.ctaHref} class="btn-ghost-light">{page.oahuConditions.ctaText}</a>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <!-- P-08 The Roof Damage Process -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title={page.roofDamageProcess.heading} />
    <Timeline variant="horizontal" items={roofDamageSteps} />
    <p class="text-[13px] md:text-[14px] font-normal leading-[160%] text-muted italic mt-8 md:mt-10">
      {page.roofDamageProcess.disclaimer}
    </p>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- P-10 FAQs -->
  <FAQs
    isDark={true}
    title={page.faqs.title}
    items={page.faqs.items.map((faq) => ({
      title: faq.question,
      description: faq.answer,
    }))}
  >
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </FAQs>

  <!-- P-12 Final CTA -->
  <CTABanner
    title={page.ctaBanner.title}
    subtitle={page.ctaBanner.subtitle}
    ctaText={page.ctaBanner.ctaText}
    ctaHref={page.ctaBanner.ctaHref}
    showAfterHoursNote={page.ctaBanner.showAfterHoursNote}
  />
</Layout>
