---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Timeline from '~/components/ui/Timeline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import InfoCard from '~/components/ui/InfoCard.astro';

import { getHomeContent } from '~/lib/content';

import achievementHawaiiBest from '~/assets/images/achievements/r-c-roofing-contractors-roofing-contractor-in-honolulu-hi.image.74377991fdf859f8e79407a88c8ef4677add71ebf7dd4d598bd921dc1e0ee0ad02file_uploadHawaiisBest2023logoFIRSTPLACE-6220366.Woblo.webp';
import achievementBBB from '~/assets/images/achievements/r-c-roofing-contractors-roofing-contractor-in-honolulu-hi.image.415e6e4191400e10c7ae56acccd083a6BBBRCRoofingContractors-6220365.Woblo.webp';
import achievementTorch from '~/assets/images/achievements/r-c-roofing-contractors-roofing-contractor-in-honolulu-hi.image.2cd1e450d55bb0570c63c444b47ceb22bbbtorchawards2017finalist-6220366.Woblo.webp';

const page = await getHomeContent();

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};

const heroActions = [
  { variant: 'primary', text: page.hero.ctaText, href: page.hero.ctaHref },
  ...(page.hero.phoneCtaText && page.hero.phoneCtaHref
    ? [{ variant: 'ghost-light', text: page.hero.phoneCtaText, href: page.hero.phoneCtaHref }]
    : []),
];

const roofDamageSteps = (page.roofDamageProcess.steps ?? []).map((step) => ({
  title: step.title,
  description: step.description,
  icon: step.icon,
}));
---

<Layout metadata={metadata}>
  <!-- P-01 Hero -->
  <Hero2
    actions={heroActions}
    image={page.hero.heroImage.src ? { src: page.hero.heroImage.src, alt: page.hero.heroImage.alt } : undefined}
  >
    <Fragment slot="title">
      {page.hero.titleLine1}<br />{page.hero.titleLine2}
    </Fragment>

    <Fragment slot="subtitle">
      {page.hero.subtitleParagraph1}
    </Fragment>

    <Fragment slot="content">
      <div class="flex flex-wrap items-center gap-5 mt-6">
        <img
          src={achievementHawaiiBest.src}
          alt="Hawaii's Best 2023 First Place"
          class="h-14 w-auto max-w-[100px] object-contain"
        />
        <img
          src={achievementBBB.src}
          alt="BBB Accredited Business"
          class="h-14 w-auto max-w-[100px] object-contain"
        />
        <img
          src={achievementTorch.src}
          alt="BBB Torch Awards 2017 Finalist"
          class="h-14 w-auto max-w-[100px] object-contain"
        />
      </div>
    </Fragment>

    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <!-- Stats Bar -->
  <section class="bg-[#222] py-6 md:py-8">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 text-left">
        {page.statsBar.map(({ stat, label }) => (
          <div class="flex flex-col items-start">
            <span class="text-[28px] md:text-[36px] font-medium font-heading leading-tight text-accent">{stat}</span>
            <span class="text-[13px] md:text-[14px] font-medium text-white/60 mt-1">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- P-03 Why We Start With an Inspection — image right -->
  <Content
    title={page.whyInspect.heading}
    callToAction={{ variant: 'ghost-light', text: page.whyInspect.ctaText, href: page.whyInspect.ctaHref }}
    image={page.whyInspect.image?.src ? { src: page.whyInspect.image.src, alt: page.whyInspect.image.alt } : undefined}
  >
    <Fragment slot="content">
      <p class="text-muted">{page.whyInspect.paragraph1}</p>
      <p class="mt-4 text-muted">{page.whyInspect.paragraph2}</p>
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </Content>

  <!-- How Can We Help You Today? -->
  <Features2
    title={page.servicesSection.title}
    subtitle={page.servicesSection.subtitle}
    isDark={true}
    cardClass="border border-accent/60 bg-[#222]"
    items={page.servicesSection.services.map((s) => ({
      title: s.title,
      description: s.description,
      callToAction: {
        variant: 'link',
        text: s.linkText,
        href: s.linkHref,
        class: 'text-accent font-medium text-[14px] md:text-[15px] hover:underline',
      },
    }))}
  >
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </Features2>

  <!-- P-02 Built for Oahu Roofing Conditions -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title={page.oahuConditions.title} classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      {page.oahuConditions.paragraph1}
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-4">
      {(page.oahuConditions.cards ?? []).map((card) => (
        <InfoCard title={card.title} description={card.description} icon={card.icon} variant="light" border={false} />
      ))}
    </div>
    <div class="mt-8 md:mt-10">
      <a href={page.oahuConditions.ctaHref} class="btn-ghost-light">{page.oahuConditions.ctaText}</a>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <!-- P-08 The Roof Damage Process -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title={page.roofDamageProcess.heading} />
    <Timeline variant="horizontal" items={roofDamageSteps} />
    <p class="text-[13px] md:text-[14px] font-medium leading-[160%] text-muted italic mt-8 md:mt-10">
      {page.roofDamageProcess.disclaimer}
    </p>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- P-10 FAQs -->
  <FAQs
    isDark={true}
    title={page.faqs.title}
    items={page.faqs.items.map((faq) => ({
      title: faq.question,
      description: faq.answer,
    }))}
  >
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </FAQs>

  <!-- P-12 Final CTA -->
  <CTABanner
    title={page.ctaBanner.title}
    subtitle={page.ctaBanner.subtitle}
    ctaText={page.ctaBanner.ctaText}
    ctaHref={page.ctaBanner.ctaHref}
    showAfterHoursNote={page.ctaBanner.showAfterHoursNote}
  />
</Layout>
