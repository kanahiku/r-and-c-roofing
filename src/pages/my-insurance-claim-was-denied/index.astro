---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import SectionBg from '~/components/ui/SectionBg.astro';

const metadata = {
  title: 'Roof Insurance Claim Denied in Hawaii? | R&C Roofing',
  description:
    'Was your roof insurance claim denied in Hawaii? Learn what to review next and how R&C can document roof conditions from the contractor side.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- P-01 Hero — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="py-8 md:py-12 max-w-3xl">
      <h1 class="text-[42px] md:text-[56px] font-medium leading-[115%] tracking-tighter font-heading mb-6">
        My Roof Insurance Claim Was Denied. What Should I Do?
      </h1>
      <p class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Start With the Reason for the Denial
      </p>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4 mb-8">
        <p>Getting a denial after you have already dealt with roof damage can leave you wondering what to do next.</p>
        <p>Do not start by assuming the carrier is wrong or that the claim will eventually be approved. Start with the denial letter. The reason the carrier gives for its decision helps determine what information may be worth reviewing next.</p>
        <p>R&C Roofing Contractors can evaluate the physical condition of your roof and provide contractor-side roofing information when additional documentation is appropriate. We do not decide whether your policy should cover the loss.</p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="btn-primary">Have R&C Review the Roof Condition</a>
      </div>
      <p class="mt-4 text-[14px] md:text-[15px] font-medium text-muted">(808) 888-2524 &nbsp;·&nbsp; Hawaii Contractor License C-33642</p>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <!-- What the denial letter says — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Does Your Denial Letter Say?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10">
      Read the carrier's explanation carefully before deciding what to do next.
    </p>
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700 shadow-card">
      <table class="w-full text-left border-collapse bg-white dark:bg-slate-900">
        <thead>
          <tr class="bg-accent/20 border-b border-gray-200 dark:border-slate-700">
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-[30%]">What the Carrier Is Questioning</th>
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-[35%]">What to Look at Next</th>
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-[35%]">How R&C May Help</th>
          </tr>
        </thead>
        <tbody>
          {[
            {
              question: 'Whether the roof shows storm-related damage',
              next: 'What physical roofing conditions were documented after the event?',
              rc: 'R&C can inspect the roof and document observable roofing conditions.',
            },
            {
              question: 'Whether the condition is related to age or deterioration',
              next: 'Is the problem localized, widespread, or consistent with longer-term roof wear?',
              rc: 'R&C can evaluate the current roof condition and document what is physically present.',
            },
            {
              question: 'Whether enough damage was documented',
              next: 'What photographs, roofing findings, or contractor information were included with the claim?',
              rc: 'Additional roofing documentation may help clarify the condition.',
            },
            {
              question: 'Whether repair or replacement is necessary',
              next: 'What does the actual roofing condition support?',
              rc: 'R&C can develop a contractor scope and project pricing based on the roof.',
            },
            {
              question: 'The claim was approved only in part',
              next: 'Which roofing items were included or excluded from the carrier\'s scope?',
              rc: null,
              rcLink: { text: 'Visit Denied or Underpaid Roof Claims →', href: '/insurance-claim-help/denied-or-underpaid-claims' },
            },
            {
              question: 'You do not understand why the claim was denied',
              next: 'Ask your carrier or insurance professional to explain the decision and any applicable review or reconsideration process.',
              rc: 'R&C can answer questions about the roofing condition, but not interpret your policy.',
            },
          ].map(({ question, next, rc, rcLink }, i) => (
            <tr class:list={['border-b border-gray-100 dark:border-slate-800 last:border-b-0', i % 2 === 1 ? 'bg-gray-50/60 dark:bg-slate-800/30' : '']}>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">{question}</td>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">{next}</td>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">
                {rc && rc}
                {rcLink && <a href={rcLink.href} class="text-primary font-medium hover:underline">{rcLink.text}</a>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-8 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic text-center max-w-3xl mx-auto">
      The goal is to separate two questions: What does the insurance policy cover? And what is physically happening with the roof? R&C works on the second question.
    </p>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- What R&C can and cannot do — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What R&C Can and Cannot Do After a Denial" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10">
      A roofing contractor and an insurance adjuster have different roles.
    </p>
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700 shadow-card">
      <table class="w-full text-left border-collapse bg-white dark:bg-slate-900">
        <thead>
          <tr class="bg-accent/20 border-b border-gray-200 dark:border-slate-700">
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">R&amp;C Can Help With</th>
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">R&amp;C Does Not Do</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['Inspecting the roof', 'Determine whether your policy provides coverage'],
            ['Documenting visible roofing conditions', 'Interpret insurance policy language'],
            ['Photographing relevant roof damage', 'Negotiate your insurance settlement'],
            ['Identifying roofing work that may be needed', 'Act as your public adjuster'],
            ['Preparing contractor repair or replacement scopes', 'Represent you in an insurance dispute'],
            ['Providing project-specific roofing pricing', 'Guarantee that the carrier will reverse its decision'],
          ].map(([can, cannot], i) => (
            <tr class:list={['border-b border-gray-100 dark:border-slate-800 last:border-b-0', i % 2 === 1 ? 'bg-gray-50/60 dark:bg-slate-800/30' : '']}>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">
                <span class="inline-flex gap-2 items-start"><span class="shrink-0 text-accent font-bold mt-0.5">✓</span>{can}</span>
              </td>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">
                <span class="inline-flex gap-2 items-start"><span class="shrink-0 text-gray-400 font-bold mt-0.5">✗</span>{cannot}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-8 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic text-center max-w-3xl mx-auto">
      This distinction matters even more after a claim has been denied.
    </p>
    <p class="mt-3 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic text-center max-w-3xl mx-auto">
      R&C Roofing Contractors is not a public adjuster. If you need insurance representation, policy interpretation, or advice about your legal rights, that falls outside R&C's roofing-contractor role.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-6">
      <a href="/insurance-claim-help" class="btn-primary">Insurance Claim Help</a>
      <a href="/insurance-claim-help/how-the-claim-process-works" class="btn btn-secondary">How the Claim Process Works</a>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <!-- Would another inspection help — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="max-w-4xl">
      <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-6">
        Would Another Roof Inspection Help?
      </h2>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4">
        <p>Sometimes the issue after a denial is that there is still uncertainty about the physical condition of the roof.</p>
        <p>A second roofing evaluation may be useful when the carrier's decision and the roof condition do not appear to tell the same story.</p>
        <p>R&C has HAAG Certified roof inspection expertise through Robert Pilato, certification #201408313. An inspection can help determine whether observable conditions are consistent with storm-related damage, longer-term deterioration, or another roofing issue.</p>
        <p>The inspection does not decide whether your policy covers the damage. It gives you better information about the roof itself.</p>
      </div>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/roof-inspections/haag-certified-inspection" class="text-primary font-medium text-[14px] md:text-[15px] hover:underline">Learn About HAAG Certified Roof Inspections →</a>
      </div>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- What if the roof is worn out — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="max-w-4xl">
      <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-6">
        What If the Roof Really Is Worn Out?
      </h2>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4">
        <p>A denied claim does not automatically mean the insurance carrier's explanation is wrong.</p>
        <p>Sometimes an inspection may show that the roofing problem is primarily related to broader deterioration rather than one recent event. If that is what the physical condition supports, R&C should say so.</p>
        <p>At that point, the useful question becomes whether another repair makes sense or whether the roof is approaching the point where replacement should be considered.</p>
      </div>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/my-roof-is-at-end-of-life" class="text-primary font-medium text-[14px] md:text-[15px] hover:underline">My Roof Is at End of Life →</a>
      </div>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <!-- What if R&C finds work — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="max-w-4xl">
      <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-6">
        What If R&C Finds Roofing Work That Needs to Be Done?
      </h2>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
        <p>Insurance and construction are separate decisions.</p>
        <p>Whether the carrier changes its decision or not, the roof may still need attention. If R&C identifies a repairable problem, we can develop the appropriate roofing scope. If the condition is broader and replacement should be considered, we can explain the roofing work involved and provide project-specific pricing.</p>
        <p>The recommendation should follow the roof condition, not the desired insurance outcome.</p>
      </div>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/services/roof-repair" class="btn-primary">Explore Roof Repair</a>
        <a href="/services/roof-replacement-and-new-installation" class="btn btn-secondary">Explore Roof Replacement</a>
      </div>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <!-- Related Problems — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Does Another Roofing Problem Better Match Your Situation?" classes={{ container: 'mb-8 md:mb-10' }} />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {[
        {
          title: 'My Roof Is Leaking',
          description: 'Water is entering the house now.',
          href: '/my-roof-is-leaking',
        },
        {
          title: 'Storm Damage on My Roof',
          description: 'The problem began after strong wind or severe weather.',
          href: '/storm-damage-on-my-roof',
        },
        {
          title: 'My Roof Is at End of Life',
          description: 'The roof is older and you are unsure whether continued repair makes sense.',
          href: '/my-roof-is-at-end-of-life',
        },
        {
          title: 'Buying or Selling a Home',
          description: 'The insurance issue came up while buying or selling the property.',
          href: '/buying-or-selling-a-home',
        },
      ].map(({ title, description, href }) => (
        <a href={href} class="rounded-lg border border-white/16 bg-white dark:bg-slate-900 shadow-card p-5 md:p-6 flex flex-col hover:shadow-md transition-shadow intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-2">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted flex-1">{description}</p>
          <span class="mt-3 text-primary font-medium text-[14px]">Continue here →</span>
        </a>
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- FAQs — white -->
  <FAQs
    title="Frequently Asked Questions About Denied Roof Claims"
    items={[
      {
        title: 'Can R&C get my denied insurance claim approved?',
        description: 'No. R&C does not control insurance coverage decisions and cannot guarantee that a carrier will change its decision. R&C can inspect the roof and provide contractor-side documentation about the physical roofing condition.',
      },
      {
        title: 'Can a denied roof claim be reviewed again?',
        description: 'That depends on your insurance policy, carrier procedures, and the reason for the denial. Read the denial letter carefully and ask your carrier or insurance professional about any applicable reconsideration, review, or documentation process.',
      },
      {
        title: 'What if the insurance company says the damage is from age or wear?',
        description: 'R&C can evaluate the roof and document its current physical condition. If the roof shows broader deterioration, we will not characterize it as storm damage simply because an insurance claim is involved.',
      },
      {
        title: 'What if I disagree with the insurance adjuster\'s roof assessment?',
        description: 'You can have the roof evaluated by a qualified roofing professional. R&C can provide contractor-side roofing findings and project information. We do not negotiate with the carrier or represent you in the insurance dispute.',
      },
      {
        title: 'What is a HAAG Certified roof inspection?',
        description: 'HAAG certification is specialized training in roof damage assessment. R&C has HAAG Certified inspection expertise through Robert Pilato, certification #201408313.',
      },
      {
        title: 'What if my claim was approved but the amount does not match the roofing work?',
        description: 'That is different from a full denial. Visit our Denied or Underpaid Roof Claims page for information about contractor scopes, roofing documentation, and where R&C\'s role ends.',
      },
      {
        title: 'Can R&C repair or replace my roof even if the claim remains denied?',
        description: 'Yes. R&C can perform roofing work based on an agreed contractor scope regardless of whether the project is ultimately insurance-funded or paid another way.',
      },
    ]}
  >
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </FAQs>

  <!-- Final CTA -->
  <CTABanner
    title="Your Claim Was Denied. Start With the Roof Facts."
    subtitle="A denial letter tells you the carrier's current position. A roof inspection tells you what is physically happening with the roof.<br /><br />If you need clearer contractor-side information about the damage, deterioration, or roofing work that may be required, R&amp;C can help establish those facts."
    ctaText="Have R&C Evaluate the Roof"
  />

</Layout>
