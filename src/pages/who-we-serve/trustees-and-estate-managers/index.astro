---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Roofing for Trustees & Estate Managers Oahu | R&C Roofing',
  description:
    'Roofing assessments and contractor documentation for Oahu trustees and estate managers. Understand roof condition, deferred maintenance, repair priorities, replacement needs, and project costs with R&C Roofing.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- P-01 Hero — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="py-8 md:py-12 max-w-3xl">
      <h1 class="text-[42px] md:text-[56px] font-medium leading-[115%] tracking-tighter font-heading mb-6">
        Roofing for Trustees &amp; Estate Managers on Oahu
      </h1>
      <p class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Start With a Documented Record of the Roof
      </p>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4 mb-8">
        <p>When you are responsible for property on behalf of an estate, trust, family, or other ownership structure, a roofing decision may need to be explained to people who were never on the property.</p>
        <p>A verbal opinion is not always enough.</p>
        <p>You may need to know what condition the roof is in, which problems require attention, what can wait, and what roofing work should be considered before approving a major expense.</p>
        <p>R&amp;C Roofing Contractors provides roof inspections and contractor-side roofing information that can help trustees and estate managers document the condition of an Oahu property and make informed decisions about the next step.</p>
        <p>R&amp;C operates under Hawaii contractor license C-33642 and brings more than 50 years of combined crew experience.</p>
      </div>
      <a href="/contact" class="btn-primary">Request a Property Roof Assessment</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- "What Does the Property Record Need to Show?" — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Does the Property Record Need to Show?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-8 md:mb-10">
      Good documentation helps separate an observable roofing condition from an assumption.
    </p>
    <div class="overflow-x-auto mb-8 md:mb-10">
      <table class="w-full text-[15px] md:text-[16px] font-medium leading-[160%] border-collapse">
        <thead>
          <tr class="border-b-2 border-primary">
            <th class="text-left py-3 pr-8 font-heading font-medium text-heading text-[16px] md:text-[18px]">Question</th>
            <th class="text-left py-3 font-heading font-medium text-heading text-[16px] md:text-[18px]">Useful Roofing Information</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100 dark:border-slate-700">
            <td class="py-3 pr-8 font-semibold text-heading align-top">What condition is the roof in today?</td>
            <td class="py-3 text-muted align-top">Documented observations of visible roofing conditions</td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-700 bg-gray-50/50 dark:bg-slate-900/20">
            <td class="py-3 pr-8 font-semibold text-heading align-top">Is there an active problem?</td>
            <td class="py-3 text-muted align-top">Identification of leaks, damage, deterioration, or other areas requiring attention</td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-700">
            <td class="py-3 pr-8 font-semibold text-heading align-top">What needs to be addressed now?</td>
            <td class="py-3 text-muted align-top">Roofing conditions that may call for repair or other action</td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-700 bg-gray-50/50 dark:bg-slate-900/20">
            <td class="py-3 pr-8 font-semibold text-heading align-top">What may be deferred?</td>
            <td class="py-3 text-muted align-top">Conditions that can be monitored rather than immediately addressed, when appropriate</td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-700">
            <td class="py-3 pr-8 font-semibold text-heading align-top">Is replacement being considered?</td>
            <td class="py-3 text-muted align-top">Contractor-side information explaining why broader replacement may warrant consideration</td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-700 bg-gray-50/50 dark:bg-slate-900/20">
            <td class="py-3 pr-8 font-semibold text-heading align-top">What could the work cost?</td>
            <td class="py-3 text-muted align-top">Project-specific contractor pricing based on the proposed roofing scope</td>
          </tr>
          <tr>
            <td class="py-3 pr-8 font-semibold text-heading align-top">What work was eventually completed?</td>
            <td class="py-3 text-muted align-top">Project records and verified roofing scope for the property file</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="flex flex-col sm:flex-row gap-4">
      <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted flex-1">
        The exact documentation available depends on the inspection and project scope.
      </p>
      <div class="shrink-0">
        <a href="/contact" class="btn btn-secondary">Document the Roof Condition</a>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 "HAAG Certified Roof Inspection Expertise" — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      HAAG Certified Roof Inspection Expertise
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>For trustees and estate managers, inspection documentation can be particularly useful when several people need to understand the same property condition.</p>
      <p>R&amp;C's inspection capabilities include HAAG Certified expertise through Robert Pilato, certification #201408313.</p>
      <p>HAAG certification is a third-party credential focused on roof damage assessment.</p>
      <p>An inspection can help establish a clearer record of visible roofing conditions before decisions are made about repair, replacement, or continued monitoring.</p>
    </div>
    <div class="mt-8">
      <a href="/roof-inspections/haag-certified-inspection" class="text-primary font-medium text-[15px] hover:underline">
        Explore HAAG Certified Roof Inspections →
      </a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- "Separating Immediate Needs From Deferred Maintenance" — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Separating Immediate Needs From Deferred Maintenance
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 mb-8">
      <p>Not every roofing issue carries the same priority.</p>
      <p>A property may have a localized repair need while other portions of the roofing system remain serviceable. Another property may show a pattern of deterioration that warrants planning for larger work.</p>
      <p>The goal is to distinguish what should be addressed from what can reasonably remain under observation.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8 mb-8">
      <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-6">
        <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-4">Address Now</h3>
        <ul class="space-y-2 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted list-disc list-inside">
          <li>Active water-entry conditions</li>
          <li>Localized roofing damage requiring repair</li>
          <li>Conditions that may allow further damage if left unaddressed</li>
          <li>Roofing work already identified as necessary</li>
        </ul>
      </div>
      <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-6">
        <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-4">Plan or Monitor</h3>
        <ul class="space-y-2 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted list-disc list-inside">
          <li>Serviceable areas showing normal weathering</li>
          <li>Conditions that do not currently require construction</li>
          <li>Larger future roofing work that can be incorporated into property planning</li>
          <li>Areas that should be reevaluated during future inspections</li>
        </ul>
      </div>
    </div>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>These decisions need to follow the actual roof condition.</p>
      <p>R&amp;C can provide roofing observations and recommendations. Decisions concerning fiduciary duties, legal obligations, estate administration, or financial management remain with the trustee, estate manager, and their professional advisors.</p>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 "Building a Deferred-Maintenance Record" — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Building a Deferred-Maintenance Record
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>Deferred maintenance is easier to manage when there is a record of what was observed and when.</p>
      <p>For properties held over time, recurring roof evaluations can help create a history of roofing conditions rather than forcing future decision-makers to start from scratch.</p>
      <p>Depending on the inspection scope, the property record may include information about:</p>
    </div>
    <ul class="mt-5 space-y-2 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted list-disc list-inside">
      <li>Roofing materials and visible condition</li>
      <li>Previously identified trouble areas</li>
      <li>Repairs that have been recommended or completed</li>
      <li>Changes observed between inspections</li>
      <li>Areas being monitored</li>
      <li>Potential future roofing needs</li>
    </ul>
    <div class="mt-6 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      <p>R&amp;C's annual maintenance materials already identify documented reports as useful for property managers and trustees planning future roofing work.</p>
    </div>
    <div class="mt-8">
      <a href="/roof-inspections/annual-maintenance-inspection" class="text-primary font-medium text-[15px] hover:underline">
        Explore Annual Roof Maintenance Inspections →
      </a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- "Repair, Replace, or Continue Monitoring?" — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Repair, Replace, or Continue Monitoring?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Trustees may inherit a property file containing several years of roofing repairs without a clear explanation of the roof’s overall condition. R&C can help evaluate the current roof and put the options into context.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
      {[
        {
          title: 'Repair',
          description: 'A localized repair may make sense when the problem is limited and surrounding roofing remains serviceable.',
        },
        {
          title: 'Replacement',
          description: 'Replacement may warrant consideration when deterioration affects broader portions of the system or continued localized repairs are becoming less practical.',
        },
        {
          title: 'Monitor',
          description: 'Not every observed condition requires immediate construction. When appropriate, an area may remain under observation and be reevaluated rather than repaired or replaced immediately.',
        },
      ].map(({ title, description }) => (
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 md:mt-10 flex flex-col gap-3">
      <a href="/services/roof-repair" class="text-primary font-medium text-[15px] hover:underline">Explore Roof Repair →</a>
      <a href="/services/roof-replacement-and-new-installation" class="text-primary font-medium text-[15px] hover:underline">Explore Roof Replacement &amp; New Installation →</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 "Roofing Information for Estate and Property Valuation" — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Roofing Information for Estate and Property Valuation
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>Roof condition can be relevant when a property is being evaluated, transferred, prepared for sale, or incorporated into broader estate planning.</p>
      <p>R&amp;C can provide roofing-condition information and contractor estimates related to roofing work that may be needed.</p>
      <p>We do not perform real estate appraisals, estate valuations, structural engineering, or legal assessments.</p>
      <p>Our role is limited to the roof.</p>
      <p>That roofing information can then be provided to the estate's appraiser, attorney, accountant, real estate professional, beneficiaries, or other advisors as appropriate.</p>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- "Preparing an Oahu Property for Sale or Transfer" — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Preparing an Oahu Property for Sale or Transfer
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 mb-8">
      <p>If a property may be sold, transferred, or distributed, unresolved roofing questions can create uncertainty late in the process.</p>
      <p>An evaluation before the transaction moves forward may help establish:</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      {[
        {
          title: 'Current Roof Condition',
          description: 'Understand what is visible before buyers or other parties begin raising questions.',
        },
        {
          title: 'Known Repair Needs',
          description: 'Identify roofing work that should be considered before the property changes hands.',
        },
        {
          title: 'Replacement Considerations',
          description: 'Determine whether the roof condition warrants discussion of a larger project.',
        },
        {
          title: 'Contractor Pricing',
          description: 'Obtain project-specific roofing estimates when work is being considered.',
        },
      ].map(({ title, description }) => (
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-4">
      <p>For properties entering a real estate transaction, R&amp;C also offers dedicated pre-purchase and seller-focused roof inspection services.</p>
    </div>
    <a href="/roof-inspections/real-estate-roof-inspection" class="text-primary font-medium text-[15px] hover:underline">
      Explore Real Estate Roof Inspections →
    </a>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 "When Several Parties Need the Same Information" — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      When Several Parties Need the Same Information
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>Estate properties may involve trustees, beneficiaries, family members, attorneys, property managers, and other advisors.</p>
      <p>Those people may not all see the property in person.</p>
      <p>A documented roofing assessment creates a common reference point for discussing the roof without relying solely on photographs taken from the ground or secondhand descriptions.</p>
      <p>The roofing report does not make the estate decision.</p>
      <p>It gives the people responsible for that decision better roofing information to work from.</p>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 "Storm Damage on a Trust or Estate Property" — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Storm Damage on a Trust or Estate Property
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>If a property experiences wind or storm damage, documentation becomes even more important.</p>
      <p>R&amp;C can inspect visible roofing conditions, photograph relevant damage, and provide contractor-side information about the roofing work that may be required.</p>
      <p>If an insurance claim is involved, the insurance carrier determines coverage and payment.</p>
      <p>R&amp;C Roofing Contractors is not a public adjuster. We do not negotiate claim settlements, interpret coverage, represent a trust or estate in an insurance dispute, or guarantee a claim outcome.</p>
    </div>
    <div class="mt-8">
      <a href="/roof-inspections/storm-and-wind-damage-inspection" class="text-primary font-medium text-[15px] hover:underline">
        Explore Storm Damage Inspections →
      </a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-08 "How R&C Approaches a Trustee or Estate Property" — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="How R&C Approaches a Trustee or Estate Property" />
    <div class="flex flex-col gap-6 max-w-2xl">
      {[
        {
          step: '1',
          title: 'Establish the Purpose',
          description: 'Tell us why the roof is being evaluated, such as deferred maintenance planning, a property transfer, an active roof problem, storm damage, or uncertainty about the existing condition.',
        },
        {
          step: '2',
          title: 'Evaluate the Roof',
          description: 'R&C performs the applicable roofing assessment based on the agreed scope.',
        },
        {
          step: '3',
          title: 'Document the Findings',
          description: 'The goal is to create clear roofing information that can be reviewed by the responsible parties.',
        },
        {
          step: '4',
          title: 'Identify the Roofing Options',
          description: 'Depending on the findings, the recommendation may involve repair, replacement, additional evaluation, or continued monitoring.',
        },
        {
          step: '5',
          title: 'Develop Contractor Pricing',
          description: 'When roofing work is being considered, R&C can prepare pricing based on the proposed scope.',
        },
        {
          step: '6',
          title: 'Maintain the Property Record',
          description: 'Inspection information, roofing proposals, and completed-work documentation can become part of the property\'s ongoing records.',
        },
      ].map(({ step, title, description }) => (
        <div class="flex gap-5 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div class="shrink-0 w-9 h-9 rounded-full bg-primary flex items-center justify-center font-heading font-medium text-[15px] text-white dark:text-slate-900 mt-0.5">
            {step}
          </div>
          <div>
            <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-1">{title}</h3>
            <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8">
      <a href="/contact" class="btn-primary">Request a Property Roof Assessment</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-06 "Why Trustees and Estate Managers Work With R&C" — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Why Trustees and Estate Managers Work With R&C" />

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mb-4 md:mb-6">
      {[
        {
          title: 'Licensed Hawaii Roofing Contractor',
          description: 'R&C Roofing Contractors operates under Hawaii contractor license C-33642.',
        },
        {
          title: 'HAAG Certified Inspection Expertise',
          description: 'Robert Pilato holds HAAG certification #201408313.',
        },
        {
          title: 'Documentation Before Construction',
          description: "R&C's inspection-first approach allows roofing conditions to be evaluated before repair or replacement decisions are made.",
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
      {[
        {
          title: 'Inspection and Roofing Services',
          description: 'If roofing work is needed after the evaluation, R&C also provides roof repair and replacement services.',
        },
        {
          title: '50+ Years of Combined Crew Experience',
          description: 'R&C brings more than 50 years of combined crew experience to its roofing work.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-09 Trustee or Estate Property Example — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline
      title="Trustee or Estate Property Example"
      subtitle="See examples of roofing work completed by R&C for trust and estate properties on Oahu."
    />
    <div class="rounded-md bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-amber-800 dark:text-amber-300 mb-8">
      Client content required before launch. Do not publish estate names, trust names, beneficiary information, or other identifying details without explicit client approval.
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
      {[
        { title: 'Project 1', description: 'Roofing project details coming soon.' },
        { title: 'Project 2', description: 'Roofing project details coming soon.' },
        { title: 'Project 3', description: 'Roofing project details coming soon.' },
      ].map(({ title: cardTitle, description }) => (
        <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
