---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import IconPointBand from '~/components/ui/IconPointBand.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import {
  exploreFromHomeowners,
  serviceHeroActions,
  yelpHerman,
  yelpLeonard,
  yelpWunShen,
} from '~/data/pages/whoWeServe';

const metadata = {
  title: 'Roofing for Oahu Homeowners | R&C Roofing Contractors',
  description:
    'Worried about your roof? R&C Roofing Contractors helps Oahu homeowners understand roof problems, compare repair and replacement options, and plan the right next step.',
  ignoreTitleTemplate: true,
};

const worries = [
  {
    title: 'I Found a Leak',
    description: 'Identify where water is coming from and what part of the system needs attention.',
    icon: 'tabler:droplet',
  },
  {
    title: 'My Roof Was Damaged in a Storm',
    description: 'Document visible damage and check whether repair or replacement is needed.',
    icon: 'tabler:wind',
  },
  {
    title: 'My Roof Is Getting Older',
    description: "Understand your roof's current condition before problems become more obvious.",
    icon: 'tabler:clock',
  },
  {
    title: 'I Think I Need a New Roof',
    description: 'Evaluate the existing roof and explore repair-versus-replacement factors.',
    icon: 'tabler:home-plus',
  },
  {
    title: 'I Have an Insurance Claim',
    description: 'Document visible damage and get contractor-side roofing information.',
    icon: 'tabler:file-text',
  },
  {
    title: 'I Have No Idea What I Need',
    description: 'Start with an expert roof condition assessment instead of guessing.',
    icon: 'tabler:help',
  },
];

const process = [
  {
    title: 'Tell Us What You Are Seeing',
    description:
      'Share your leak, storm impact, age concerns, or other property details without needing technical terminology.',
    icon: 'tabler:phone',
  },
  {
    title: 'We Evaluate the Roof',
    description:
      'We perform a comprehensive inspection, backed by HAAG Certified expertise (Robert Pilato, certification #201408313).',
    icon: 'tabler:search',
  },
  {
    title: 'We Explain What We Find',
    description: "You receive a clear, objective breakdown of your roof's actual condition.",
    icon: 'tabler:file-text',
  },
  {
    title: 'You Review Your Options',
    description: 'We walk you through repair, replacement, or monitoring choices so you understand the rationale.',
    icon: 'tabler:list-details',
  },
  {
    title: 'You Decide How to Move Forward',
    description: 'We develop a detailed project scope only when you are ready to proceed.',
    icon: 'tabler:circle-check',
  },
];

const why = [
  {
    title: 'Licensed Roofing Contractor',
    description: 'Operating under Hawaii License C-33642.',
    icon: 'tabler:certificate',
  },
  {
    title: 'Inspection Expertise',
    description: 'HAAG Certified inspection expertise through Robert Pilato, certification #201408313.',
    icon: 'tabler:badge',
  },
  {
    title: 'Comprehensive Services',
    description:
      'Inspections, repairs, replacements, new installations, and gutter services handled by one experienced local team.',
    icon: 'tabler:tools',
  },
  {
    title: 'Experience & Community',
    description: 'Over 50 years of combined crew experience and proud membership in BIA Hawaii.',
    icon: 'tabler:users',
  },
];

const faqs = [
  {
    title: 'I do not know whether I need a repair or replacement. Where should I start?',
    description:
      'Start with an evaluation of the roof. R&C can look at the existing condition and explain whether a localized repair, larger project, or continued monitoring should be considered.',
  },
  {
    title: 'Will R&C recommend replacement if my roof can be repaired?',
    description:
      'Recommendations are based strictly on the condition of the roof and the extent of the problem. A localized issue will always call for repair rather than an unnecessary complete replacement.',
  },
  {
    title: 'What roofing services does R&C provide for homeowners?',
    description:
      'R&C provides roof inspections, roof repairs, roof replacements and new installations, gutter services, and multiple material options.',
  },
  {
    title: 'Do I need to know what is wrong before scheduling an inspection?',
    description: 'No. You can contact R&C with what you are seeing, and the roof can be evaluated from there.',
  },
];

const yelpEmbeds = `${yelpLeonard}${yelpWunShen}${yelpHerman}`;
---

<Layout metadata={metadata}>
  <Hero2 actions={serviceHeroActions('Talk to R&C About Your Roof')}>
    <Fragment slot="title">Roofing for Oahu Homeowners</Fragment>
    <Fragment slot="subtitle">
      You do not need to know what your roof needs before you call. Whether you are dealing with a leak, storm damage,
      or an aging system, get expert local support backed by Hawaii License C-33642.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Homeowner roofing photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Are You Worried About?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      You do not have to diagnose the problem yourself. Find the situation that matches what you are seeing:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {worries.map((item) => <InfoCard title={item.title} description={item.description} icon={item.icon} variant="dark" />)}
    </div>
    <div class="mt-8 md:mt-10 flex justify-center">
      <a href="/contact" class="btn-primary">Schedule a Roof Evaluation</a>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="What Happens When You Contact R&C Roofing?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Navigating roofing work shouldn't add to your stress:
    </p>
    <IconPointBand items={process} variant="dark" />
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Other Who We Serve Resources" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      If your property management needs or stakeholder responsibilities involve other specialized sectors, explore our
      other dedicated audience solutions:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
      {
        exploreFromHomeowners.map((card) => (
          <ServiceCard
            title={card.title}
            description={card.description}
            href={card.href}
            linkText={card.linkText}
            variant="light"
          />
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Why Oahu Homeowners Choose R&C Roofing" classes={{ container: 'mb-4 md:mb-6 text-left md:mx-0' }} />
    <IconPointGrid items={why} />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="What Oahu Homeowners Say" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Roofing work happens at your home, so workmanship is only part of the experience. Communication and knowing what to
      expect matter too.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 yelp-review-grid" set:html={yelpEmbeds} />
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <FAQs title="Frequently Asked Questions For Homeowners" items={faqs}>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </FAQs>

  <CTABanner
    title="Start With the Condition of Your Roof"
    subtitle="You do not need to decide between repair, replacement, or a specific material before asking for help. Start by finding out what is happening with the roof."
    ctaText="Talk to R&C About Your Roof"
  />
</Layout>
