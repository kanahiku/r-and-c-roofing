---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import SectionBg from '~/components/ui/SectionBg.astro';

const metadata = {
  title: 'HAAG Certified Roof Inspector Hawaii | R&C Roofing',
  description:
    'Schedule a HAAG Certified roof inspection with R&C Roofing Contractors. Get specialized roof damage assessment and documented findings for your Oahu property.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- P-01 Hero — white + motif -->
  <Hero2
    actions={[{ variant: 'primary', text: 'Schedule a HAAG Certified Roof Inspection', href: '/contact' }]}
    image={{ src: 'https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=2070&q=80', alt: 'HAAG Certified roof inspection on Oahu' }}
  >
    <Fragment slot="title">HAAG Certified Roof<br />Inspections on Oahu</Fragment>
    <Fragment slot="subtitle">
      <span class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Specialized Training for Roof Damage Assessment
      </span>
      When a roof has been damaged, the first question is not always whether it can be repaired. You also need to understand what happened and what parts of the roofing system were affected.
      <br /><br />
      R&C Roofing Contractors has a HAAG Certified Inspector on staff. Robert Pilato, Certification #201408313, brings specialized roof damage assessment training to inspections for Oahu property owners.
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <!-- What Does HAAG Certified Mean? — Grey #FAFAFA -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      What Does HAAG Certified Mean?
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>HAAG certification is specialized training for professionals who evaluate roof damage. It gives inspectors a more structured way to assess roofing materials, visible damage patterns, and conditions that may affect how a roof performs.</p>
      <p>The training covers how different roofing systems respond to weather, aging, installation conditions, and other sources of damage. It also helps inspectors distinguish between conditions that may look similar at first glance but can have different causes.</p>
      <p>For property owners, that added training can be especially useful when the cause of roof damage is not obvious. A missing shingle, damaged flashing, or a new leak does not always tell you why the problem happened or how much of the roofing system may be affected.</p>
      <p>R&C combines HAAG damage-assessment training with practical roofing experience. That means the inspection is not limited to identifying a visible problem. The findings are considered in the context of the roofing material, surrounding components, property conditions, and any other visible factors that may help explain what is happening.</p>
      <p>Robert Pilato holds HAAG Certification #201408313, bringing that specialized training directly into R&C's roof inspection process.</p>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- What HAAG Adds — Black + motif -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white text-center mb-4 md:mb-6">
      What HAAG Certification Adds to a Roof Inspection
    </h2>
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      A roof can show similar symptoms for different reasons. A HAAG Certified inspection adds a damage-assessment perspective to the evaluation.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {[
        {
          title: 'Visible Damage Patterns',
          description: 'We look at where damage appears and how it relates to surrounding roofing materials and components.',
        },
        {
          title: 'Roofing Material Condition',
          description: 'Visible deterioration is considered alongside the type and condition of the existing roofing material.',
        },
        {
          title: 'Wind and Storm-Related Conditions',
          description: 'When severe weather is a concern, we look for visible conditions that may be relevant to wind or storm exposure.',
        },
        {
          title: 'Other Possible Sources of Damage',
          description:
            'Not every roofing problem is storm-related. Existing deterioration, previous repairs, installation conditions, and other factors may also need to be considered.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-accent/60 bg-[#222] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60">{description}</p>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- When Makes Sense — White -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="When Does a HAAG Certified Roof Inspection Make Sense?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      A HAAG Certified inspection can be useful when the cause or extent of visible roof damage needs a closer look.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {[
        {
          title: 'After Strong Winds or Severe Weather',
          description:
            'If roofing materials have shifted, a leak appears, or the roof looks different after a storm, a damage-focused inspection can help document the condition.',
          href: '/roof-inspections/storm-and-wind-damage-inspection',
          linkText: 'View Storm & Wind Damage Inspections',
        },
        {
          title: 'When Damage Documentation Is Needed',
          description:
            'If you are documenting roof conditions for an insurance claim, specialized damage-assessment training can provide useful context for the contractor-side findings.',
          href: '/insurance-claim-help',
          linkText: 'Explore Insurance Claim Help',
        },
        {
          title: 'When the Cause of a Roofing Problem Is Unclear',
          description:
            'Roof problems can develop from weather exposure, material deterioration, previous repairs, or other conditions. A closer inspection can help identify visible factors that should be considered.',
        },
        {
          title: 'When You Want a Roofing-Specific Assessment',
          description:
            'A property owner may simply want a closer evaluation from a roofing contractor with additional training in damage assessment.',
        },
      ].map(({ title, description, href, linkText }) => (
        <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-3 text-heading">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted mb-4 flex-1">{description}</p>
          {href ? (
            <a href={href} class="text-primary font-medium text-[14px] md:text-[15px] hover:underline mt-auto">{linkText}</a>
          ) : null}
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <!-- Process — Grey #FAFAFA -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-12">
      What Happens During a HAAG Certified Roof Inspection?
    </h2>
    <div class="flex flex-col gap-6 max-w-2xl">
      {[
        {
          step: '1',
          title: 'We Review Your Concern',
          description:
            'We start by understanding why you requested the inspection and what you have noticed about the roof.',
        },
        {
          step: '2',
          title: 'We Evaluate Accessible Roofing Areas',
          description:
            'Where site conditions and access allow, we inspect relevant roofing materials and components for visible damage or deterioration.',
        },
        {
          step: '3',
          title: 'We Document Relevant Findings',
          description: "Photos and notes help create a record of the roof's condition at the time of inspection.",
        },
        {
          step: '4',
          title: 'We Explain the Findings',
          description:
            'We review what was observed and discuss whether repair, replacement, further evaluation, or monitoring should be considered. If roofing work is needed, R&C can provide information about the proposed scope.',
        },
      ].map(({ step, title, description }) => (
        <div class="flex gap-5 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div class="shrink-0 w-9 h-9 rounded-full bg-[#222] flex items-center justify-center font-heading font-medium text-[15px] text-accent mt-0.5">
            {step}
          </div>
          <div>
            <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-1 text-heading">{title}</h3>
            <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
          </div>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- Insurance Claims Note — Black + motif -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white text-center mb-4 md:mb-6">
      HAAG Certified Inspections and Insurance Claims
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 space-y-4 mb-8 max-w-3xl mx-auto text-center">
      <p>A HAAG Certified inspection does not determine whether an insurance claim will be approved.</p>
      <p>Coverage decisions are made by the insurance carrier based on the policy and its claim review process.</p>
      <p>R&C can inspect accessible roofing areas, document relevant visible conditions, and provide contractor-side information about roofing damage and the proposed scope of work.</p>
      <p>R&C Roofing Contractors is not a public adjuster. We do not adjust claims, negotiate insurance settlements, represent policyholders in claim negotiations, or guarantee claim outcomes.</p>
    </div>
    <div class="text-center">
      <a href="/insurance-claim-help" class="btn-primary">Learn About Insurance Claim Help</a>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- Verify Certification — White -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Verify Our HAAG Certification
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 max-w-4xl">
      <p>Robert Pilato holds HAAG Certification #201408313.</p>
      <p>R&C includes this certification number so property owners can identify the credential associated with the inspector evaluating their roof.</p>
      <p>Our HAAG inspection expertise is paired with R&C Roofing Contractors' Hawaii contractor license C-33642.</p>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <!-- Explore Other Inspections — Grey #FAFAFA, black cards -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Our Other Roof Inspection Services" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      A HAAG Certified inspection is one option within R&C's roof inspection services.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
      {[
        {
          title: 'Pre-Purchase Roof Inspections',
          description: "Get a closer look at the roof's condition before moving forward with a real estate transaction.",
          href: '/roof-inspections/pre-purchase-roof-inspection',
          linkText: 'View Pre-Purchase Inspections',
        },
        {
          title: 'Storm & Wind Damage Inspections',
          description: 'Evaluate visible roof conditions after strong winds or severe weather.',
          href: '/roof-inspections/storm-and-wind-damage-inspection',
          linkText: 'View Storm Damage Inspections',
        },
        {
          title: 'Annual Maintenance Inspections',
          description: 'Track roof conditions over time and identify areas that may need attention.',
          href: '/roof-inspections/annual-maintenance-inspection',
          linkText: 'View Maintenance Inspections',
        },
      ].map(({ title, description, href, linkText }) => (
        <div class="rounded-lg border border-accent/60 bg-[#222] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60 mb-4 flex-1">{description}</p>
          <a href={href} class="text-accent font-medium text-[14px] md:text-[15px] hover:underline mt-auto">{linkText}</a>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/roof-inspections" class="inline-flex items-center justify-center px-6 py-3 rounded-md border-2 border-black text-black font-semibold text-[15px] leading-snug hover:bg-black hover:text-white transition-colors duration-200">View All Roof Inspection Services</a>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- FAQs — White -->
  <FAQs
    title="Frequently Asked Questions"
    items={[
      {
        title: 'What is a HAAG Certified Inspector?',
        description:
          "A HAAG Certified Inspector has completed specialized damage-assessment education and testing through HAAG. R&C's Robert Pilato holds HAAG Certification #201408313.",
      },
      {
        title: 'Is a HAAG Certified inspection different from a standard roof inspection?',
        description:
          'The roofing system itself is still being inspected. The difference is the additional damage-assessment training the HAAG Certified Inspector brings to the evaluation.',
      },
      {
        title: 'Do I need a HAAG Certified inspection after every storm?',
        description:
          'Not necessarily. An inspection may make sense if you notice a new leak, displaced roofing materials, visible damage, or another change after severe weather.',
      },
      {
        title: 'Will a HAAG Certified inspection prove that my insurance claim is covered?',
        description:
          'No. R&C can document visible roofing conditions and provide contractor-side information, but the insurance carrier determines whether damage is covered under your policy.',
      },
      {
        title: 'Can a HAAG inspection help if an insurance claim has already been denied?',
        description:
          'An additional roof inspection may provide more information about visible roofing conditions, but R&C does not determine coverage or overturn insurance decisions. Questions about a denied claim should also be discussed directly with your carrier or an appropriately licensed insurance professional.',
      },
      {
        title: 'Can R&C repair the roof after the inspection?',
        description:
          'Yes. R&C Roofing Contractors is a licensed Hawaii roofing contractor, License C-33642. If roofing work is needed, our team can provide repair or replacement services.',
      },
    ]}
  >
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </FAQs>

  <!-- P-12 Final CTA — Yellow -->
  <CTABanner
    title="Get a Closer Look at Your Roof Damage"
    subtitle="If you are dealing with storm damage or another roofing concern, a HAAG Certified inspection can provide a closer assessment of the roof's visible condition.<br />R&amp;C Roofing Contractors can inspect the roofing system, document relevant findings, and explain what those findings may mean for your property."
    ctaText="Schedule a HAAG Certified Roof Inspection"
  />

</Layout>
