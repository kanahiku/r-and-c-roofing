---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Pre-Purchase Roof Inspections Oahu | R&C Roofing',
  description:
    'Schedule a pre-purchase roof inspection on Oahu with R&C Roofing Contractors. Get a closer look at roof condition before moving forward with a real estate transaction.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- P-01 Hero — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="py-8 md:py-12 max-w-3xl">
      <h1 class="text-[42px] md:text-[56px] font-medium leading-[115%] tracking-tighter font-heading mb-6">
        Pre-Purchase Roof Inspections on Oahu
      </h1>
      <p class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Understand the Roof Before You Close
      </p>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4 mb-8">
        <p>A roof can represent a significant future expense, so it helps to understand its condition before a real estate transaction moves forward.</p>
        <p>R&amp;C Roofing Contractors provides pre-purchase roof inspections for Oahu properties. Our team includes HAAG Certified Inspector Robert Pilato, Certification #201408313, with specialized training in roof damage assessment.</p>
        <p>We evaluate accessible roofing areas, document relevant findings, and explain whether visible conditions may require maintenance, repair, or further evaluation.</p>
      </div>
      <a href="/contact" class="btn-primary">Schedule a Pre-Purchase Roof Inspection</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Why separate inspection — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Why Get a Separate Roof Inspection Before Buying?" subtitle="A general home inspection covers many parts of a property. A dedicated roof inspection allows a roofing contractor to take a closer look at the roofing system itself." />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-6 max-w-3xl">
      That can be useful when:
    </p>
    <ul class="space-y-3 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-8 max-w-3xl">
      {[
        'The roof is older or its history is unclear.',
        'The general inspection identifies a roofing concern.',
        'There are visible signs of previous leaks or repairs.',
        'The property has experienced significant wind or weather exposure.',
        'You want more information before making a decision about the property.',
      ].map((item) => (
        <li class="flex gap-3">
          <span class="shrink-0 text-primary mt-0.5">—</span>
          {item}
        </li>
      ))}
    </ul>
    <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic max-w-3xl">
      R&amp;C is a licensed Hawaii roofing contractor, License C-33642. If the inspection identifies roofing work that should be considered, our team can explain the potential scope.
    </p>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What we evaluate — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What We Evaluate During a Pre-Purchase Roof Inspection" subtitle="The inspection scope depends on the property, roofing system, accessibility, and visible conditions." />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-8 max-w-3xl mx-auto text-center">
      Where accessible, R&amp;C may evaluate:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      {[
        {
          title: 'Roofing Materials',
          description:
            'We look for visible deterioration, damage, displacement, previous repairs, and other conditions that may affect the roofing system.',
        },
        {
          title: 'Flashing and Roof Penetrations',
          description:
            'Areas around vents, pipes, skylights, transitions, and other penetrations can be important points to review for visible deterioration or water-entry concerns.',
        },
        {
          title: 'Roof Edges and Drainage Areas',
          description:
            'We review accessible roof edges, valleys, gutters, and other areas involved in moving water away from the roof.',
        },
        {
          title: 'Exposed Metal Components',
          description:
            'Fasteners, flashing, and other exposed metal components may show signs of corrosion, particularly on properties with greater coastal exposure.',
        },
        {
          title: 'Signs of Moisture or Previous Leaks',
          description:
            'When interior access is appropriate, visible signs of moisture or previous water intrusion may help provide additional context about the roof.',
        },
      ].map(({ title, description }) => (
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What findings can tell you — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What the Inspection Findings Can Tell You" subtitle="The goal is not to predict an exact date when the roof will fail. It is to give you better information about its current visible condition." />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {[
        {
          title: 'For Buyers',
          description:
            'Inspection findings can help you understand whether the roof appears to need immediate attention or whether there are conditions you should plan for after purchasing the property. If roofing work is recommended, R&amp;C can provide contractor-side information about the proposed scope.',
        },
        {
          title: 'For Sellers',
          description:
            'A roof inspection before listing may help identify visible problems that you want to address before the property goes on the market. It can also give you more information if a roofing concern is raised later in the transaction.',
        },
        {
          title: 'For Real Estate Professionals',
          description:
            'When a client needs a closer look at the roof, R&amp;C can provide a roofing-specific inspection and explain the findings in practical terms.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <div class="mt-8">
      <a href="/contact" class="btn-primary">Schedule a Pre-Purchase Inspection</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Oahu conditions — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Oahu Conditions Matter When Evaluating a Roof
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 max-w-4xl">
      <p>Two roofs of a similar age can show very different wear depending on where they are located.</p>
      <p>A coastal property may have greater exposure to salt air. A home in a wetter area may show different moisture-related conditions. Strong sun exposure can also affect roofing materials and exposed components over time.</p>
      <p>R&amp;C considers the property location and visible roof conditions as part of the inspection rather than relying on roof age alone.</p>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Process — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 md:mb-12">
      <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading">
        What Happens During a Pre-Purchase Roof Inspection?
      </h2>
      <a href="/contact" class="btn-primary shrink-0">Schedule a Pre-Purchase Inspection</a>
    </div>
    <div class="flex flex-col gap-6 max-w-2xl">
      {[
        {
          step: '1',
          title: 'We Review the Property and Any Known Concerns',
          description:
            'If another inspection has already identified a roofing issue, let us know what was observed.',
        },
        {
          step: '2',
          title: 'We Inspect Accessible Roofing Areas',
          description:
            'Where access and site conditions allow, we evaluate relevant parts of the roofing system for visible damage or deterioration.',
        },
        {
          step: '3',
          title: 'We Document Relevant Findings',
          description:
            'Photos and notes can help provide a clearer record of the roof’s condition at the time of the inspection.',
        },
        {
          step: '4',
          title: 'We Explain What the Findings Mean',
          description:
            'We discuss whether visible conditions appear to require maintenance, repair, further evaluation, or consideration of a larger roofing project.',
        },
      ].map(({ step, title, description }) => (
        <div class="flex gap-5 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div class="shrink-0 w-9 h-9 rounded-full bg-primary flex items-center justify-center font-heading font-medium text-[15px] text-white dark:text-slate-900 mt-0.5">
            {step}
          </div>
          <div>
            <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-1">{title}</h3>
            <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
          </div>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- HAAG note — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="HAAG Certified Roof Damage Assessment" subtitle="Specialized damage-assessment training can add helpful context when evaluating visible roofing damage and deterioration." />
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4 max-w-4xl">
      <p>Robert Pilato is a HAAG Certified Inspector, Certification #201408313.</p>
      <p>HAAG certification includes specialized education and testing in roof damage assessment. This gives R&amp;C additional training when evaluating visible roofing damage and deterioration.</p>
      <p>That inspection expertise is paired with R&amp;C’s work as a licensed Hawaii roofing contractor.</p>
    </div>
    <div class="mt-8">
      <a href="/roof-inspections/haag-certified-inspection" class="btn btn-secondary">Learn About HAAG Certified Roof Inspections</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Explore other inspections — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Our Other Roof Inspection Services" subtitle="A real estate transaction is one reason to take a closer look at a roof. R&amp;C also provides inspections for other property needs." />
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
      {[
        {
          title: 'HAAG Certified Roof Inspections',
          description: 'Get a closer assessment of visible roof damage supported by specialized HAAG training.',
          href: '/roof-inspections/haag-certified-inspection',
          linkText: 'View HAAG Certified Inspections',
        },
        {
          title: 'Storm & Wind Damage Inspections',
          description: 'Evaluate visible roof conditions after strong winds or severe weather.',
          href: '/roof-inspections/storm-and-wind-damage-inspection',
          linkText: 'View Storm Damage Inspections',
        },
        {
          title: 'Annual Maintenance Inspections',
          description: 'Track roof conditions over time and identify areas that may need attention.',
          href: '/roof-inspections/annual-maintenance-inspection',
          linkText: 'View Maintenance Inspections',
        },
      ].map(({ title, description, href, linkText }) => (
        <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted mb-4 flex-1">{description}</p>
          <a href={href} class="text-primary font-medium text-[14px] md:text-[15px] hover:underline mt-auto">{linkText}</a>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/roof-inspections" class="btn btn-secondary">View All Roof Inspection Services</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- FAQs — white -->
  <FAQs
    title="Frequently Asked Questions"
    items={[
      {
        title: 'Is a roof inspection different from a general home inspection?',
        description:
          'A dedicated roof inspection focuses specifically on the roofing system. It can provide additional detail when a general inspection identifies a roofing concern or when you want a roofing contractor to evaluate the roof more closely.',
      },
      {
        title: 'When should I schedule a roof inspection during a real estate transaction?',
        description:
          'Inspection timelines vary by transaction. If the roof is part of your due diligence, schedule the inspection early enough to review the findings before any applicable inspection or contingency deadlines.',
      },
      {
        title: 'Can R&C tell me how many years the roof has left?',
        description:
          'Roof condition cannot always be reduced to an exact remaining number of years. R&amp;C can evaluate visible deterioration and explain whether the current condition suggests maintenance, repair, or replacement should be considered.',
      },
      {
        title: 'Can the inspection findings be used during negotiations?',
        description:
          'Inspection findings may provide useful information about the condition of the roof and any recommended work. How that information is used in a real estate transaction is up to the parties involved and their real estate professionals.',
      },
      {
        title: 'Does R&C inspect the attic?',
        description:
          'Interior or attic areas may be reviewed when they are accessible and relevant to the roofing concern. The scope depends on the property and inspection conditions.',
      },
      {
        title: 'Should a newer roof still be inspected?',
        description:
          'A newer roof may still be worth evaluating if there is a visible concern, a known leak, unclear installation history, or another reason to take a closer look at the roofing system.',
      },
      {
        title: 'Can R&C complete repairs after the inspection?',
        description:
          'Yes. R&amp;C Roofing Contractors is a licensed Hawaii roofing contractor, License C-33642. If the inspection identifies roofing work that needs to be considered, our team can provide the appropriate roofing services.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- P-12 Final CTA — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="w-full p-8 md:p-12 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-600">
      <div class="text-center mb-8 md:mb-10">
        <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-4">
          Know More About the Roof Before You Move Forward
        </h2>
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted dark:text-slate-400 space-y-3">
          <p>A pre-purchase roof inspection can give you a clearer understanding of the roofing system before your real estate transaction moves ahead.</p>
          <p>R&amp;C Roofing Contractors can evaluate accessible roofing areas, document relevant findings, and explain what those findings may mean for the property.</p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-t border-gray-200 dark:border-gray-700 pt-8">
        <div class="text-[15px] md:text-[16px] font-medium leading-[180%] text-muted dark:text-slate-400">
          <p class="font-semibold text-heading text-[16px] md:text-[17px]">R&amp;C Roofing Contractors</p>
          <p>3302 Campbell Ave, Honolulu, HI 96815</p>
          <p>(808) 888-2524</p>
          <p class="mt-2 text-[13px] md:text-[14px] italic">After-hours roofing concern? Use the online chat to contact the team.</p>
        </div>
        <a href="/contact" class="btn-primary shrink-0">Schedule a Pre-Purchase Roof Inspection</a>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>
</Layout>

