---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import ComparisonTable from '~/components/ui/ComparisonTable.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import {
  inspectionHeroActions,
  inspectionProcessIcons,
  otherInspectionServices,
} from '~/data/pages/roofInspections';

const metadata = {
  title: 'Pre-Purchase Roof Inspections Oahu | R&C Roofing',
  description:
    'Schedule a pre-purchase roof inspection on Oahu with R&C Roofing Contractors. Get a closer look at roof condition before moving forward with a real estate transaction.',
  ignoreTitleTemplate: true,
};

const otherServices = otherInspectionServices('/roof-inspections/pre-purchase-roof-inspection');

const evaluate = [
  {
    title: 'Roofing Materials',
    description: 'We look for visible deterioration, shifted components, and previous patchwork.',
    icon: 'tabler:layers-intersect',
  },
  {
    title: 'Flashing and Penetrations',
    description: 'We inspect vents, pipes, and skylights for proper sealing and water-entry vulnerabilities.',
    icon: 'tabler:circle-dashed',
  },
  {
    title: 'Edges and Drainage',
    description: 'We review roof edges, valleys, and gutters to ensure water moves away from the structure.',
    icon: 'tabler:droplet',
  },
  {
    title: 'Exposed Metal',
    description: 'We check fasteners and flashing for corrosion caused by coastal salt air exposure.',
    icon: 'tabler:sun',
  },
];

const whenItMakesSense = [
  {
    title: 'Older Materials',
    description: 'The roof is aging and its repair history is unclear.',
    icon: 'tabler:calendar',
  },
  {
    title: 'Flagged Concerns',
    description: 'A general home inspector identified a potential roofing issue that needs expert review.',
    icon: 'tabler:flag',
  },
  {
    title: 'Visible Water Signs',
    description: 'You see evidence of interior ceiling stains or previous leak repairs.',
    icon: 'tabler:droplet',
  },
  {
    title: 'Severe Exposure',
    description: 'The property sits in a high-wind or heavy-rain microclimate on Oahu.',
    icon: 'tabler:wind',
  },
];

const faqs = [
  {
    title: 'Is a roof inspection different from a general home inspection?',
    description:
      'Yes. A dedicated roof inspection focuses strictly on the structural integrity of the roofing system rather than a broad property overview.',
  },
  {
    title: 'Can R&C tell me exactly how many years the roof has left?',
    description:
      'No. We evaluate visible deterioration to determine if you need immediate repair or replacement rather than predicting an exact failure date.',
  },
  {
    title: 'Can the inspection findings be used during negotiations?',
    description:
      'Yes. You can use our objective documentation and repair estimates to inform your discussions with the seller.',
  },
  {
    title: 'Does R&C inspect the attic?',
    description:
      'Yes. We review accessible interior attic areas when they are highly relevant to a specific leak or roofing concern.',
  },
  {
    title: 'Can R&C complete repairs after the inspection?',
    description:
      'Yes. We operate under Hawaii Contractor License C-33642 and can execute any necessary repairs if you purchase the property.',
  },
];
---

<Layout metadata={metadata}>
  <Hero2
    actions={inspectionHeroActions}
  >
    <Fragment slot="title">Pre-Purchase Roof<br />Inspections on Oahu</Fragment>
    <Fragment slot="subtitle">
      Understand the true condition of the roof before you close. We evaluate the structure to protect you from
      unexpected repair costs after you buy.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Pre-purchase inspection photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Standard Home Inspection vs. Dedicated Roof Assessment" classes={{ container: 'mb-[20px]' }} />
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px] space-y-4">
      <p>
        A general home inspection covers many parts of a property but often misses specific roofing failures. We provide
        a dedicated structural evaluation.
      </p>
      <p>
        Robert Pilato (Certification #201408313) brings advanced diagnostic training to assess the exact condition of
        the materials based on local island weather exposure.
      </p>
    </div>
    <ComparisonTable
      columns={['Standard Home Inspection', 'Pre-Purchase Roof Assessment']}
      rows={[
        {
          feature: 'Primary Focus',
          left: 'Broad overview of the entire property.',
          right: 'Deep structural evaluation of the roofing system.',
        },
        {
          feature: 'Damage Evaluation',
          left: 'Basic visual checks from the ground or ladder.',
          right: 'Comprehensive material and component analysis.',
        },
        {
          feature: 'Actionable Utility',
          left: 'Highlights general property concerns.',
          right: 'Delivers specific repair scopes and structural documentation.',
        },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="What We Evaluate During an Assessment" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      A damaged component does not always tell the full story. We look deeper to find the root cause.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
      {evaluate.map((card) => (
        <InfoCard title={card.title} description={card.description} icon={card.icon} variant="dark" />
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="When a Pre-Purchase Inspection Makes Sense" classes={{ container: 'mb-[9px] text-left md:mx-0' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-[30px]">
      You need objective data when the cause or extent of your roof damage is unclear.
    </p>
    <IconPointGrid items={whenItMakesSense} />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="How Our Inspection Process Works" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      We follow a strict assessment protocol to give you clear answers.
    </p>
    <Timeline
      items={[
        { title: 'Listen', description: 'We review the property details and any known concerns from previous general inspections.', icon: inspectionProcessIcons.listen },
        { title: 'Evaluate', description: 'We safely access the roof to inspect the materials, flashing, and drainage components.', icon: inspectionProcessIcons.evaluate },
        { title: 'Document', description: 'We capture photographs and detailed notes to record the exact physical condition of the roof.', icon: inspectionProcessIcons.document },
        { title: 'Recommend', description: 'We explain our findings and advise if the property requires maintenance, repair, or a full replacement.', icon: inspectionProcessIcons.recommend },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <Content
    isDark={true}
    title="Using Your Inspection Findings"
    classes={{ title: 'text-white' }}
  >
    <Fragment slot="content">
      <p class="text-white/70">
        A pre-purchase inspection provides structural facts to inform your buying decision. It does not predict an exact
        failure date or guarantee future performance.
      </p>
      <p class="mt-4 text-white/70">
        How you use these findings during real estate negotiations is up to you and your agent. R&C Roofing Contractors
        provides objective contractor documentation and repair estimates to support your due diligence.
      </p>
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Pre-purchase inspection findings photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </Content>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Our Other Inspection Services" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      We offer specialized evaluations for different stages of property ownership.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {otherServices.map((card) => (
        <ServiceCard title={card.title} description={card.description} href={card.href} linkText={card.linkText} variant="light" />
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <FAQs title="Frequently Asked Questions" items={faqs}>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </FAQs>

  <CTABanner
    title="Know More About the Roof Before You Close"
    subtitle="Find out exactly what is happening before you commit to a real estate transaction."
    ctaText="Schedule Inspection"
  />
</Layout>
