---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import IconPointBand from '~/components/ui/IconPointBand.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import ServiceDirectory from '~/components/ui/ServiceDirectory.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { inspectionHeroActions, inspectionServices } from '~/data/pages/roofInspections';

const metadata = {
  title: 'Roof Inspections Oahu | HAAG Certified | R&C Roofing',
  description:
    'Get the facts before replacing your roof. R&C Roofing provides HAAG-certified inspections on Oahu to determine if you need a repair or a replacement.',
  ignoreTitleTemplate: true,
};

const whenToCall = [
  {
    title: 'Active Leaks',
    description: 'We trace interior ceiling stains to the exact exterior breach.',
    icon: 'tabler:droplet',
  },
  {
    title: 'Post-Storm Checks',
    description: 'We identify hidden wind or debris damage after severe Oahu weather.',
    icon: 'tabler:wind',
  },
  {
    title: 'Real Estate Transactions',
    description: 'We evaluate structural conditions before you buy or sell a property.',
    icon: 'tabler:home',
  },
  {
    title: 'Aging Materials',
    description: 'We determine if an older roof needs replacement or targeted maintenance.',
    icon: 'tabler:calendar',
  },
  {
    title: 'Insurance Claims',
    description: 'We document visible damage professionally for your carrier.',
    icon: 'tabler:file-text',
  },
];

const whatYouGet = [
  {
    title: 'Visual Documentation',
    description: 'Clear photographic proof of any damaged shingles, rusted flashing, or underlying wood rot we uncover.',
    icon: 'tabler:camera',
  },
  {
    title: 'Condition Analysis',
    description: "An evaluation of your materials' remaining lifespan based on local island weather exposure.",
    icon: 'tabler:search',
  },
  {
    title: 'Damage Mapping',
    description: 'Pinpointing exactly where the roof is failing and whether the issue is localized or widespread.',
    icon: 'tabler:map-pin',
  },
  {
    title: 'Actionable Recommendations',
    description: 'Clear guidance on the practical next steps required to secure your property.',
    icon: 'tabler:clipboard-check',
  },
];

const faqs = [
  {
    title: 'Will you automatically recommend a new roof?',
    description:
      'No. We recommend a repair if a localized fix can safely address the problem while the surrounding roof remains serviceable.',
  },
  {
    title: 'Do I need to be home during the inspection?',
    description:
      'Only if we need to access the interior of your property. We require you to be present if your concern involves a ceiling leak or an attic condition.',
  },
  {
    title: 'Can an inspection help with my insurance claim?',
    description:
      'Yes. We document visible roofing conditions and provide contractor side information. Please note that R&C Roofing is not a public adjuster. We do not negotiate settlements or guarantee claim outcomes.',
  },
  {
    title: 'Can R&C repair the roof after inspecting it?',
    description:
      'Yes. We operate under Hawaii Contractor License C-33642. Our crews can execute the necessary repairs or a full replacement if we find damage.',
  },
  {
    title: 'How much does a roof inspection cost?',
    description:
      'Pricing depends entirely on the property and the type of inspection requested. Contact us directly to confirm availability and pricing for your specific situation.',
  },
];
---

<Layout metadata={metadata}>
  <Hero2 actions={inspectionHeroActions}>
    <Fragment slot="title">Oahu Roof Inspections</Fragment>
    <Fragment slot="subtitle">
      Get the facts before you pay for construction. We evaluate your roof's actual condition to determine if you need a
      repair or a full replacement.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Roof inspection photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <!-- P-06 When to Call for an Inspection — icon points, not cards -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="When to Call for an Inspection" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      You do not need to wait for water to pour into your living room. A professional evaluation clarifies your next
      steps across several situations:
    </p>
    <IconPointBand items={whenToCall} />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <!-- Linked directory — not a card grid -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline
      isDark={true}
      title="Explore Our Specialized Inspection Services"
      classes={{ container: 'mb-[9px]' }}
    />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      Different situations require different diagnostic approaches. Choose the assessment that matches your current
      property needs from our core inspection services:
    </p>
    <ServiceDirectory items={inspectionServices} variant="dark" />
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- P-14 What You Get — 2x2 text grid, not cards -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What You Get From an R&C Roofing Inspection" classes={{ container: 'mb-[9px] text-left md:mx-0' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted mb-[30px]">
      We provide structural clarity rather than a high-pressure sales pitch. Every inspection delivers concrete evidence
      so you can make an informed decision:
    </p>
    <IconPointGrid items={whatYouGet} />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <Content title="The HAAG Certification Advantage">
    <Fragment slot="content">
      <p class="text-muted">
        Standard contractors often lack the training to properly identify complex damage. Robert Pilato (Cert
        #201408313) is a HAAG Certified roof inspector.
      </p>
      <p class="mt-4 text-muted">
        This specialized credential provides a structured approach to evaluating wear, allowing us to distinguish
        between normal island weathering and sudden storm impacts so you get accurate data for your property decisions.
      </p>
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="HAAG certified roof inspection photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </Content>

  <FAQs isDark={true} title="Frequently Asked Questions" items={faqs}>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </FAQs>

  <CTABanner
    title="Stop Guessing About Your Roof"
    subtitle="Find out exactly what is happening before you commit to a construction contract."
    ctaText="Schedule Inspection"
  />
</Layout>
