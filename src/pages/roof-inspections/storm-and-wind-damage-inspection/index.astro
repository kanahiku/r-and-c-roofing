---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import ComparisonTable from '~/components/ui/ComparisonTable.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import {
  inspectionHeroActions,
  inspectionProcessIcons,
  otherInspectionServices,
} from '~/data/pages/roofInspections';

const metadata = {
  title: 'Storm & Wind Damage Roof Inspections Oahu | R&C Roofing',
  description:
    'Schedule a storm damage roof inspection on Oahu with R&C Roofing Contractors. Get HAAG Certified assessment and documentation of visible wind and roof damage.',
  ignoreTitleTemplate: true,
};

const otherServices = otherInspectionServices('/roof-inspections/storm-and-wind-damage-inspection');

const evaluate = [
  {
    title: 'Lifted Materials',
    description: 'We inspect shingles and metal components for broken adhesive seals and wind uplift.',
    icon: 'tabler:wind',
  },
  {
    title: 'Flashing Damage',
    description: 'We check the metal transitions around vents and pipes for bent or loosened materials.',
    icon: 'tabler:border-corners',
  },
  {
    title: 'Debris Impact',
    description: 'We identify structural bruising or punctures caused by airborne branches.',
    icon: 'tabler:tree',
  },
  {
    title: 'Drainage Blockages',
    description: 'We review valleys and gutters for storm debris that forces water under your roofing materials.',
    icon: 'tabler:droplet',
  },
];

const whenItMakesSense = [
  {
    title: 'Missing Materials',
    description: 'You see shingles, tiles, or metal components in your yard.',
    icon: 'tabler:home',
  },
  {
    title: 'New Interior Leaks',
    description: 'Water appears on your ceiling immediately following severe weather.',
    icon: 'tabler:droplet',
  },
  {
    title: 'Visible Impact',
    description: 'Branches or heavy debris physically struck your property.',
    icon: 'tabler:alert-triangle',
  },
  {
    title: 'Displaced Metal',
    description: 'You notice bent fascia, soffits, or loosened roof edge materials.',
    icon: 'tabler:tools',
  },
];

const faqs = [
  {
    title: 'How do I know if my roof has wind damage?',
    description:
      'Visible signs include missing materials, new leaks, or debris impact. Wind uplift often breaks seals without blowing shingles off entirely, which requires a professional inspection to identify.',
  },
  {
    title: 'Should I climb onto my roof after a storm?',
    description: 'No. Wet or damaged roofs create severe safety risks.',
  },
  {
    title: 'Can R&C document storm damage for an insurance claim?',
    description: 'Yes. We inspect accessible areas and provide objective contractor documentation of the visible damage.',
  },
  {
    title: 'Does homeowners insurance cover roof wind damage?',
    description: 'Coverage depends entirely on the terms and exclusions of your individual policy.',
  },
  {
    title: 'Should I have my roof inspected after every storm?',
    description:
      'No. You only need an inspection if you notice a new leak, displaced materials, or visible debris impact after severe weather.',
  },
];
---

<Layout metadata={metadata}>
  <Hero2
    actions={inspectionHeroActions}
  >
    <Fragment slot="title">Storm &amp; Wind Damage Roof<br />Inspections on Oahu</Fragment>
    <Fragment slot="subtitle">
      Find out what the storm actually did to your roof. We identify hidden structural impacts before they turn into
      major leaks.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Storm damage inspection photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Hidden Wind Damage vs. Visible Storm Impacts" classes={{ container: 'mb-[20px]' }} />
    <div class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px] space-y-4">
      <p>
        High winds can lift shingles and break seals without blowing the materials off your property entirely. When the
        storm passes, your roof may look normal from the driveway while remaining structurally compromised.
      </p>
      <p>
        Robert Pilato (Certification #201408313) applies specialized HAAG damage assessment training to find what a
        standard ground-level check misses.
      </p>
    </div>
    <ComparisonTable
      columns={['Standard Ground Check', 'Professional Storm Assessment']}
      rows={[
        {
          feature: 'Primary Focus',
          left: 'Missing shingles and obvious debris.',
          right: 'Hidden wind uplift and broken seals.',
        },
        {
          feature: 'Damage Evaluation',
          left: 'What you can safely see from the yard.',
          right: 'Hands-on inspection of fasteners and flashing.',
        },
        {
          feature: 'Actionable Utility',
          left: 'Confirms obvious exterior issues.',
          right: 'Provides structural documentation for insurance claims.',
        },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="What We Evaluate After a Storm" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      A damaged component does not always tell the full story. We look deeper to find the root cause of storm-related
      failures.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
      {evaluate.map((card) => (
        <InfoCard title={card.title} description={card.description} icon={card.icon} variant="dark" />
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="When a Storm Inspection Makes Sense" classes={{ container: 'mb-[9px] text-left md:mx-0' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted mb-[30px]">
      You do not need to diagnose the problem yourself. Call for an evaluation if you notice any of these physical
      changes.
    </p>
    <IconPointGrid items={whenItMakesSense} />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="How Our Inspection Process Works" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      We follow a strict assessment protocol to give you clear answers safely.
    </p>
    <Timeline
      items={[
        { title: 'Listen', description: 'We discuss the specific weather event and what physical changes you noticed.', icon: inspectionProcessIcons.listen },
        { title: 'Evaluate', description: 'We safely access the roof surface to inspect materials, fasteners, and impact zones.', icon: inspectionProcessIcons.evaluate },
        { title: 'Document', description: 'We capture photographs and detailed notes to record the exact physical condition of the damage.', icon: inspectionProcessIcons.document },
        { title: 'Recommend', description: 'We explain our findings and advise if you need a localized repair or a full replacement.', icon: inspectionProcessIcons.recommend },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <Content
    isDark={true}
    title="Building Your Claim Documentation"
    classes={{ title: 'text-white' }}
  >
    <Fragment slot="content">
      <p class="text-white/70">
        A storm damage inspection provides contractor-side evidence for your insurance file. It does not guarantee claim
        approval. Your insurance carrier makes all final coverage decisions based on your specific policy language.
      </p>
      <p class="mt-4 text-white/70">
        R&C Roofing Contractors is not a public adjuster. We do not negotiate settlements or represent policyholders in
        claim disputes.
      </p>
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Storm damage claim documentation photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </Content>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Our Other Inspection Services" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      We offer specialized evaluations for different stages of property ownership.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {otherServices.map((card) => (
        <ServiceCard title={card.title} description={card.description} href={card.href} linkText={card.linkText} variant="light" />
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <FAQs title="Frequently Asked Questions" items={faqs}>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </FAQs>

  <CTABanner
    title="Check Your Roof After Severe Weather"
    subtitle="Find out exactly what is happening before you commit to a construction contract."
    ctaText="Schedule Inspection"
  />
</Layout>
