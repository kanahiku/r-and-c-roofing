---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import ComparisonTable from '~/components/ui/ComparisonTable.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import {
  inspectionHeroActions,
  inspectionProcessIcons,
  otherInspectionServices,
} from '~/data/pages/roofInspections';

const metadata = {
  title: 'Pre-Listing Roof Inspection Oahu | R&C Roofing',
  description:
    'Selling a home on Oahu? A pre-listing roof inspection from R&C helps you understand visible roof conditions before putting your property on the market.',
  ignoreTitleTemplate: true,
};

const otherServices = otherInspectionServices('/roof-inspections/pre-listing-roof-inspection');

const evaluate = [
  {
    title: 'Roofing Materials',
    description: 'We check for cracked, displaced, or significantly deteriorated shingles and tiles.',
    icon: 'tabler:layers-intersect',
  },
  {
    title: 'Flashing and Penetrations',
    description: 'We inspect the seals around vents, pipes, and transitions for water-entry vulnerabilities.',
    icon: 'tabler:circle-dashed',
  },
  {
    title: 'Previous Repair Areas',
    description: 'We evaluate older patchwork to ensure it remains structurally sound and localized.',
    icon: 'tabler:tool',
  },
  {
    title: 'Moisture Indicators',
    description: 'We look for visible evidence of previous leaks or poor drainage patterns.',
    icon: 'tabler:droplet',
  },
];

const whenItMakesSense = [
  {
    title: 'Aging Materials',
    description: 'You know the roof is older but lack clarity on its actual physical condition.',
    icon: 'tabler:calendar',
  },
  {
    title: 'Undocumented Repairs',
    description: 'You or a previous owner completed patchwork without professional evaluation.',
    icon: 'tabler:file-text',
  },
  {
    title: 'Past Storm Exposure',
    description: 'Your neighborhood experienced high winds and you want to rule out hidden damage.',
    icon: 'tabler:wind',
  },
  {
    title: 'Proactive Selling',
    description: 'You want a clear picture of your property to avoid surprises during buyer negotiations.',
    icon: 'tabler:home',
  },
];

const faqs = [
  {
    title: 'Do I have to repair everything R&C finds?',
    description:
      'No. We outline the physical conditions we find, but you decide whether to repair, replace, or simply disclose the information to potential buyers.',
  },
  {
    title: 'Should I replace an older roof before listing my house?',
    description:
      'Not automatically based on age alone. We evaluate the physical condition to determine if targeted repairs are sufficient or if a full replacement is structurally necessary.',
  },
  {
    title: "Is this different from the buyer's home inspection?",
    description:
      "Yes. This is a dedicated roofing evaluation you order before listing, whereas a buyer's general inspection is a broad property overview ordered later in the transaction.",
  },
  {
    title: 'Can R&C tell me what I am legally required to disclose?',
    description:
      'No. We provide technical roofing facts, but you must direct all questions about legal disclosure obligations to your real estate professional.',
  },
  {
    title: 'Can R&C complete repairs before I list the home?',
    description:
      'Yes. We operate under Hawaii Contractor License C-33642 and can execute any necessary roofing work prior to your sale.',
  },
];
---

<Layout metadata={metadata}>
  <Hero2
    actions={inspectionHeroActions}
  >
    <Fragment slot="title">Pre-Listing Roof<br />Inspections on Oahu</Fragment>
    <Fragment slot="subtitle">
      Know the exact condition of your roof before your home goes on the market. We provide the structural facts you
      need to make informed selling decisions.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Pre-listing inspection photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Pre-Listing vs. Pre-Purchase Roof Inspections" classes={{ container: 'mb-[20px]' }} />
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px] space-y-4">
      <p>
        Both inspections evaluate the roofing system, but they serve different sides of the real estate transaction. A
        pre-listing assessment helps you prepare before a buyer's inspector flags a potential problem.
      </p>
    </div>
    <ComparisonTable
      columns={['Pre-Listing Inspection', 'Pre-Purchase Inspection']}
      rows={[
        { feature: 'Primary User', left: 'The property seller.', right: 'The potential buyer.' },
        {
          feature: 'Timing',
          left: 'Before the property goes on the market.',
          right: "During the buyer's due diligence period.",
        },
        {
          feature: 'Primary Goal',
          left: 'Identify issues to address or disclose early.',
          right: 'Clarify structural concerns before finalizing a purchase.',
        },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="What We Evaluate During an Assessment" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      A damaged component does not always tell the full story. We look deeper to find the root cause.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
      {evaluate.map((card) => (
        <InfoCard title={card.title} description={card.description} icon={card.icon} variant="dark" />
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="When a Pre-Listing Inspection Makes Sense" classes={{ container: 'mb-[9px] text-left md:mx-0' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-[30px]">
      You need objective data before a buyer's inspector raises a red flag.
    </p>
    <IconPointGrid items={whenItMakesSense} />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="How Our Inspection Process Works" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      We follow a strict assessment protocol to give you clear answers.
    </p>
    <Timeline
      items={[
        { title: 'Listen', description: 'We discuss the roof\'s history and any previous leaks you have already noticed.', icon: inspectionProcessIcons.listen },
        { title: 'Evaluate', description: 'We safely access your roof to assess the visible materials and structural components.', icon: inspectionProcessIcons.evaluate },
        { title: 'Document', description: 'We capture photographs and detailed notes to record the exact physical condition of the roof.', icon: inspectionProcessIcons.document },
        { title: 'Recommend', description: 'We explain our findings and advise if the property requires targeted maintenance or if monitoring is sufficient.', icon: inspectionProcessIcons.recommend },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <Content
    isDark={true}
    title="Preparing Your Selling Strategy"
    classes={{ title: 'text-white' }}
  >
    <Fragment slot="content">
      <p class="text-white/70">
        A pre-listing inspection provides structural facts to inform your selling strategy. It does not prevent buyer
        objections or guarantee a flawless real estate transaction.
      </p>
      <p class="mt-4 text-white/70">
        How you use our documentation to satisfy seller disclosure requirements is entirely up to you and your real
        estate agent. R&C Roofing Contractors simply provides objective contractor documentation and potential repair
        scopes to support your preparation.
      </p>
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Pre-listing roof inspection photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </Content>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Our Other Inspection Services" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      We offer specialized evaluations for different stages of property ownership.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {otherServices.map((card) => (
        <ServiceCard title={card.title} description={card.description} href={card.href} linkText={card.linkText} variant="light" />
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <FAQs title="Frequently Asked Questions" items={faqs}>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </FAQs>

  <CTABanner
    title="Sell With a Clearer Understanding of the Roof"
    subtitle="Find out exactly what is happening before you put your home on the market."
    ctaText="Schedule Inspection"
  />
</Layout>
