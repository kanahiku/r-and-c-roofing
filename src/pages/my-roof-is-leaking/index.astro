---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Roof Leaking on Oahu? Get It Checked | R&C Roofing',
  description:
    'Roof leaking during rain on Oahu? See what to do now, how urgent the leak may be, what could be causing it, and how R&C Roofing finds the source.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- P-01 Hero — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="py-8 md:py-12 max-w-3xl">
      <h1 class="text-[42px] md:text-[56px] font-medium leading-[115%] tracking-tighter font-heading mb-6">
        My Roof Is Leaking. What Should I Do?
      </h1>
      <p class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        If Water Is Entering Your Home, Get the Roof Checked Promptly
      </p>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4 mb-8">
        <p>If your ceiling is dripping, a stain is spreading, or water is entering during heavy rain, do not wait for the next storm to see if it happens again.</p>
        <p>R&C Roofing Contractors evaluates leaking roofs within its Oahu service area to identify where water may be getting in and what roofing work should be considered.</p>
        <p>A leak does not automatically mean you need a new roof. The first step is finding the source.</p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="btn-primary">Call About a Roof Leak</a>
      </div>
      <p class="mt-4 text-[15px] md:text-[16px] font-medium text-muted">(808) 888-2524</p>
      <p class="mt-2 text-[14px] md:text-[15px] font-medium text-muted">
        Not actively dripping? <a href="/roof-inspections/storm-and-wind-damage-inspection" class="text-primary underline hover:no-underline">Schedule a Roof Leak Inspection</a>
      </p>
      <p class="mt-2 text-[13px] md:text-[14px] font-medium text-muted italic">Hawaii Contractor License C-33642</p>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What to Do Right Now — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Should You Do Right Now?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10">
      If water is entering the property, focus first on protecting the interior without putting yourself at risk.
    </p>
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700 shadow-[0_4px_30px_rgba(0,0,0,0.08)]">
      <table class="w-full text-left border-collapse bg-white dark:bg-slate-900">
        <thead>
          <tr class="bg-[#EDD974]/20 border-b border-gray-200 dark:border-slate-700">
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">What You Are Seeing</th>
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">What to Do</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['Water is actively dripping indoors', 'Move belongings away from the affected area where it is safe to do so and contact a roofing professional promptly.'],
            ['A ceiling stain is spreading after rain', 'Schedule an inspection. The water source may be somewhere other than directly above the stain.'],
            ['The stain appeared once and dried', 'Do not assume the problem corrected itself. The source should still be investigated.'],
            ['You see damaged or missing roofing material', 'Have the roof evaluated, especially if the condition appeared after strong wind or heavy weather.'],
            ['You notice attic moisture or a damp smell', 'The roofing system and nearby building components should be checked for a possible source of water entry.'],
            ['The ceiling or roof structure appears visibly sagged', 'Keep people away from the affected area and have the condition professionally evaluated.'],
          ].map(([seeing, action], i) => (
            <tr class:list={['border-b border-gray-100 dark:border-slate-800 last:border-b-0', i % 2 === 1 ? 'bg-gray-50/60 dark:bg-slate-800/30' : '']}>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">{seeing}</td>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">{action}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic">
      Take photos of what you see and note when the problem started.
    </p>
    <p class="mt-1 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic">
      Do not climb onto a wet roof to investigate it yourself.
    </p>
    <div class="mt-6">
      <a href="/contact" class="btn-primary">Get the Leak Checked</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Leak may not be above stain — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="The Leak May Not Be Directly Above the Ceiling Stain" classes={{ container: 'mb-4 md:mb-6' }} />
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10 space-y-3">
      <p>Water does not always travel straight down.</p>
      <p>It can enter through one area of the roof and move along underlayment, decking, framing, or another component before appearing inside your home.</p>
      <p>The location of the water can still provide useful clues.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {[
        {
          title: 'Ceiling Stain in the Middle of a Room',
          description: 'Water may have entered higher on the roof and traveled before reaching the ceiling.',
        },
        {
          title: 'Water Near an Exterior Wall',
          description: 'Roof edges, flashing, transitions, or nearby roofing details may need to be evaluated.',
        },
        {
          title: 'Water Around a Vent, Skylight, or Other Penetration',
          description: 'The roofing details surrounding the penetration may be part of the problem.',
        },
        {
          title: 'Moisture in the Attic',
          description: 'Attic conditions can sometimes help trace the path water has taken between the roof and interior.',
        },
        {
          title: 'Leak Only During Wind-Driven Rain',
          description: 'Some problems become noticeable only when wind changes how rain reaches roof edges, penetrations, flashing, or damaged roofing material.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-5 md:p-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-2">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic text-center max-w-3xl mx-auto">
      The visible symptom provides a clue. It does not replace an inspection.
    </p>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What can cause a leak — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="flex flex-col lg:flex-row gap-8 md:gap-16">
      <div class="lg:basis-1/2">
        <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-6">
          What Can Cause a Roof Leak on Oahu?
        </h2>
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4">
          <p>A leaking roof can have several possible causes.</p>
          <p>The goal is to determine where water may be entering, how far the condition extends, and whether the surrounding roofing system remains serviceable. That information determines what should happen next.</p>
        </div>
        <div class="mt-8">
          <a href="/contact" class="btn-primary">Have R&C Find the Source</a>
        </div>
      </div>
      <div class="lg:basis-1/2">
        <p class="text-[14px] md:text-[15px] font-semibold text-heading mb-4 uppercase tracking-wide">R&C may evaluate conditions involving:</p>
        <ul class="space-y-3">
          {[
            'Missing, lifted, cracked, or displaced roofing material',
            'Damaged or deteriorated flashing',
            'Roofing details around vents and other penetrations',
            'Valleys and roof transitions',
            'Conditions beneath the exterior roofing material',
            'Wind or storm-related damage',
          ].map((item) => (
            <li class="flex gap-3 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
              <span class="shrink-0 text-primary mt-0.5">—</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Repair or Replace — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Does the Roof Need Repair or Replacement?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10">
      A leak does not automatically mean you need a new roof. The appropriate next step depends on the source, extent of the problem, and overall roof condition.
    </p>
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700 shadow-[0_4px_30px_rgba(0,0,0,0.08)]">
      <table class="w-full text-left border-collapse bg-white dark:bg-slate-900">
        <thead>
          <tr class="bg-[#EDD974]/20 border-b border-gray-200 dark:border-slate-700">
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">What R&C Finds</th>
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">What May Make Sense Next</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['A localized flashing, penetration, or roofing-material problem', 'Targeted roof repair may be enough if the surrounding roof remains serviceable.'],
            ['Damage is limited to one roof area', 'That area may be repairable without replacing the entire roofing system.'],
            ['Several unrelated leak points or widespread deterioration are present', 'Roof replacement may need to be considered instead of continuing with isolated repairs.'],
            ['The leak appeared after strong wind or a storm', 'A Storm & Wind Damage Inspection may be the better next step.'],
            ['The observed condition does not require immediate construction', 'Monitoring may be appropriate instead of performing unnecessary work.'],
          ].map(([finding, action], i) => (
            <tr class:list={['border-b border-gray-100 dark:border-slate-800 last:border-b-0', i % 2 === 1 ? 'bg-gray-50/60 dark:bg-slate-800/30' : '']}>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">{finding}</td>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">{action}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-8 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto">
      R&C does not assume every leaking roof needs replacement.
    </p>
    <p class="mt-2 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto">
      If a localized repair can reasonably address the problem, that option should be considered first.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/services/roof-repair" class="btn-primary">Explore Roof Repair</a>
      <a href="/services/roof-replacement-and-new-installation" class="btn btn-secondary">Explore Roof Replacement &amp; New Installation</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Testimonials — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Homeowners Say About R&C" classes={{ container: 'mb-8 md:mb-10' }} />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {[
        {
          quote: 'I highly recommend these good old local boys. They did a wonderful job being thorough and following up with my needs in a timely fashion. It\'s very hard to find a good contractor here on the island.',
          name: 'Richard S.',
          source: 'Google Review',
        },
        {
          quote: 'R&C roofing is the bomb. The workers were very polite and hard working. No one was standing around, every worker was moving and being productive. They were also super clean and neat. They cleaned up the rubbish and did a walk around to pick up rubbish at the end of each of the 2 days they were there.',
          name: 'Alai A.',
          source: 'Google Review',
        },
      ].map(({ quote, name, source }) => (
        <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-6 md:p-8 flex flex-col">
          <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted flex-1 mb-6">"{quote}"</p>
          <div>
            <p class="font-semibold text-heading text-[15px]">{name}</p>
            <p class="text-[13px] text-muted">{source}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/about/reviews" class="btn btn-secondary">Read More Google Reviews</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Related Problems — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Does Another Roofing Problem Better Match Your Situation?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10">
      Sometimes a leak is only one part of a larger roofing concern.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {[
        {
          title: 'Storm Damage on My Roof',
          description: 'The leak started after strong wind or severe weather.',
          href: '/storm-damage-on-my-roof',
        },
        {
          title: 'My Roof Is at End of Life',
          description: 'The roof keeps leaking or problems are appearing in different areas.',
          href: '/my-roof-is-at-end-of-life',
        },
        {
          title: 'My Insurance Claim Was Denied',
          description: 'You filed an insurance claim and it was denied.',
          href: '/my-insurance-claim-was-denied',
        },
        {
          title: 'Buying or Selling a Home',
          description: 'The roof problem came up while buying or selling the property.',
          href: '/buying-or-selling-a-home',
        },
      ].map(({ title, description, href }) => (
        <a href={href} class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-5 md:p-6 flex flex-col hover:shadow-md transition-shadow intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-2">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted flex-1">{description}</p>
          <span class="mt-3 text-primary font-medium text-[14px]">Continue here →</span>
        </a>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- FAQs — grey -->
  <FAQs
    title="Frequently Asked Questions About Leaking Roofs"
    items={[
      {
        title: 'Why is my roof leaking only when it rains hard?',
        description: 'Some roofing conditions become noticeable only when enough rain reaches the affected area or wind changes how water moves across the roof. The actual source should be evaluated rather than diagnosed from the weather pattern alone.',
      },
      {
        title: 'Does the ceiling stain show exactly where the roof is leaking?',
        description: 'Not necessarily. Water can travel through or along roofing components before becoming visible inside the home.',
      },
      {
        title: 'Can a leaking roof be repaired without replacing the whole roof?',
        description: 'Sometimes. If the problem is localized and the surrounding roofing system remains serviceable, a targeted repair may be appropriate.',
      },
      {
        title: 'What if the leak stops when the rain stops?',
        description: 'Dry weather can stop the visible symptom without correcting the roofing condition that allowed water inside. If you have already seen evidence of a leak, the source should still be investigated.',
      },
      {
        title: 'How much does it cost to repair a leaking roof on Oahu?',
        description: 'Cost depends on the source of the problem, roofing materials involved, accessibility, extent of the affected area, and repair scope. R&C can provide project-specific pricing after the roofing condition has been evaluated.',
      },
      {
        title: 'Does homeowners insurance cover a leaking roof?',
        description: 'Coverage depends on the policy and cause of the loss. If a sudden storm event may have caused the damage, R&C can document roofing conditions from the contractor side. Your insurance carrier determines coverage and payment.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </FAQs>

  <!-- P-12 Final CTA — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="w-full p-8 md:p-12 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-600">
      <div class="text-center mb-8 md:mb-10">
        <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-4">
          Your Roof Is Leaking. Start With the Source.
        </h2>
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted dark:text-slate-400 space-y-3">
          <p>If water is entering your home, do not wait for another storm to find out whether it happens again.</p>
          <p>Find out where the water is getting in and what roofing work actually makes sense.</p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-t border-gray-200 dark:border-gray-700 pt-8">
        <div class="text-[15px] md:text-[16px] font-medium leading-[180%] text-muted dark:text-slate-400">
          <p class="font-semibold text-heading text-[16px] md:text-[17px]">R&amp;C Roofing Contractors</p>
          <p>3302 Campbell Ave, Honolulu, HI 96815</p>
          <p>(808) 888-2524</p>
          <p class="mt-1 text-[13px] md:text-[14px] italic">Hawaii Contractor License C-33642</p>
        </div>
        <a href="/contact" class="btn-primary shrink-0">Call About Your Roof Leak</a>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

</Layout>
