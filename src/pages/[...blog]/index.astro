---
import ServicePageView from '~/components/templates/ServicePageView.astro';
import { findServicePage } from '~/lib/content';

export const prerender = false;

const raw = Astro.params.blog;
const slug = Array.isArray(raw) ? raw.filter(Boolean).join('/') : (raw ?? '').replace(/^\/+|\/+$/g, '');
const page = slug ? await findServicePage(slug) : null;

if (!page) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
---

<ServicePageView slug={slug} page={page} />
