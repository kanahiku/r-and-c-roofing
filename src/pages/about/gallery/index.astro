---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';

const metadata = {
  title: 'Oahu Roofing Projects & Before and After Photos | R&C Roofing',
  description:
    'Explore roofing projects completed by R&C Roofing Contractors across Oahu, including roof repairs, replacements, residential roofing, commercial roofing, and before-and-after photos.',
  ignoreTitleTemplate: true,
};

const projectTypes = [
  'All Projects',
  'Roof Repair',
  'Roof Replacement',
  'Residential Roofing',
  'Commercial Roofing',
  'Storm Damage',
];
const materials = ['All Materials', 'Metal', 'Asphalt Shingle', 'Stone-Coated Steel', 'Tile'];
const areas = [
  'All Oahu',
  'Honolulu',
  'Kailua',
  'Kāneʻohe',
  'Hawaiʻi Kai',
  'Aiea & Pearl City',
  'Kapolei & ʻEwa Beach',
  'Mililani',
  'Waipahu',
];

const featuredProjects = [
  { name: 'Featured Roofing Project', neighborhood: 'Oahu' },
  { name: 'Featured Roofing Project', neighborhood: 'Oahu' },
  { name: 'Featured Roofing Project', neighborhood: 'Oahu' },
  { name: 'Featured Roofing Project', neighborhood: 'Oahu' },
];
---

<Layout metadata={metadata}>
  <Hero2>
    <Fragment slot="title">Roofing Projects Across Oahu</Fragment>
    <Fragment slot="subtitle">
      Every roofing project starts with a different property and a different reason for calling. Explore completed
      R&amp;C Roofing Contractors projects across Oahu, including roof repairs, roof replacements, residential and
      commercial roofing, and different roofing materials. Use the filters below to browse projects by the type of work,
      roofing material, or area.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Hero project photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Our Roofing Projects" classes={{ container: 'mb-[30px]' }} />
    <div class="flex flex-col gap-5">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <span class="text-[14px] font-medium text-heading shrink-0 w-36">Project Type:</span>
        <div class="flex flex-wrap gap-2">
          {
            projectTypes.map((type, i) => (
              <span
                class:list={[
                  'px-3 py-1 rounded-full text-[13px] font-medium',
                  i === 0 ? 'bg-accent text-heading' : 'bg-white text-muted',
                ]}
              >
                {type}
              </span>
            ))
          }
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <span class="text-[14px] font-medium text-heading shrink-0 w-36">Roofing Material:</span>
        <div class="flex flex-wrap gap-2">
          {
            materials.map((mat, i) => (
              <span
                class:list={[
                  'px-3 py-1 rounded-full text-[13px] font-medium',
                  i === 0 ? 'bg-accent text-heading' : 'bg-white text-muted',
                ]}
              >
                {mat}
              </span>
            ))
          }
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <span class="text-[14px] font-medium text-heading shrink-0 w-36">Area:</span>
        <div class="flex flex-wrap gap-2">
          {
            areas.map((area, i) => (
              <span
                class:list={[
                  'px-3 py-1 rounded-full text-[13px] font-medium',
                  i === 0 ? 'bg-accent text-heading' : 'bg-white text-muted',
                ]}
              >
                {area}
              </span>
            ))
          }
        </div>
      </div>
    </div>
    <p class="mt-6 text-[13px] md:text-[14px] font-medium leading-[160%] text-muted italic">
      Filters will update this gallery once project photography is published. They do not create separate filter URLs.
    </p>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="Featured Roofing Projects" classes={{ container: 'mb-[30px]' }} />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
      {
        featuredProjects.map((project) => (
          <div class="rounded-lg border border-accent/60 bg-[#222] overflow-hidden flex flex-col h-full">
            <div class="grid grid-cols-2">
              <div class="border-r border-white/10">
                <HeroImagePlaceholder label={`${project.name} before photo`} />
                <p class="px-3 py-2 text-[12px] font-medium uppercase tracking-wider text-white/50">Before</p>
              </div>
              <div>
                <HeroImagePlaceholder label={`${project.name} after photo`} />
                <p class="px-3 py-2 text-[12px] font-medium uppercase tracking-wider text-white/50">After</p>
              </div>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] text-white mb-2">
                {project.name}
              </h3>
              <p class="text-[13px] md:text-[14px] font-normal leading-[160%] text-white/60 flex-1">
                {project.neighborhood}. Project name, neighborhood, property type, roofing material, and the situation
                and work descriptions will be added when photography is available.
              </p>
              <span class="mt-auto pt-4 text-[14px] md:text-[15px] font-medium text-accent">View Project</span>
            </div>
          </div>
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <Content isReversed title="Before and After">
    <Fragment slot="content">
      <p class="text-muted">
        Some roofing changes are easier to understand when you can see where the project started and where it finished.
        Browse before-and-after views from selected R&amp;C roofing projects across Oahu once photography is published.
      </p>
    </Fragment>
    <Fragment slot="image">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <HeroImagePlaceholder label="Before photo placeholder" />
          <p class="mt-2 text-[12px] font-medium uppercase tracking-wider text-muted">Before</p>
        </div>
        <div>
          <HeroImagePlaceholder label="After photo placeholder" />
          <p class="mt-2 text-[12px] font-medium uppercase tracking-wider text-muted">After</p>
        </div>
      </div>
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </Content>

  <CTABanner
    title="Have a Roofing Project of Your Own?"
    subtitle="If you are dealing with a leak, an aging roof, storm damage, or another roofing concern, start by finding out what condition the roof is in. R&C Roofing Contractors can evaluate the roof and help determine what roofing work should be considered next."
    ctaText="Schedule a Roof Inspection"
  />
</Layout>
