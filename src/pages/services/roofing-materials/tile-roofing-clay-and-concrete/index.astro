---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Timeline from '~/components/ui/Timeline.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import SectionBg from '~/components/ui/SectionBg.astro';

const metadata = {
  title: 'Tile Roofing Honolulu & Oahu | Clay & Concrete | R&C Roofing',
  description:
    'Explore clay and concrete tile roofing for Oahu properties. Compare tile options, structural considerations, Hawaii conditions, costs, and installation with R&C Roofing.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- P-01 · Hero -->
  <Hero2
    actions={[{ variant: 'primary', text: 'Discuss a Tile Roofing Project', href: '/contact' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1632759145351-1d592919f522?auto=format&fit=crop&w=1200&q=80',
      alt: 'Clay and concrete tile roofing on an Oahu property',
    }}
  >
    <Fragment slot="title">
      Clay &amp; Concrete Tile<br />Roofing on Oahu
    </Fragment>
    <Fragment slot="subtitle">
      <span class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Is Tile Roofing Right for Your Property?
      </span>
      Tile roofing creates a distinctive architectural look, but choosing tile involves more than selecting a profile or color. The type of tile, roof design, structural requirements, property exposure, and installation details all need to work together.
      <br /><br />
      R&amp;C Roofing Contractors installs tile roofing for qualifying properties within its Oahu service area. We can help you compare clay and concrete tile and determine whether a tile roofing system is appropriate for your replacement or new construction project.
      <br /><br />
    R&amp;C operates under Hawaii contractor license C-33642.
  </Fragment>
  <Fragment slot="bg">
    <SectionBg variant="hero" />
  </Fragment>
</Hero2>

  <!-- Is Tile Roofing a Good Fit? · grey bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Is Tile Roofing a Good Fit for Your Roof?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-10 md:mb-14 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      Tile may be worth considering when its appearance and roofing requirements fit the property. Roof loading is an important part of tile-roof planning — the Tile Roofing Industry Alliance includes roof loading among the technical topics addressed in its installation training.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      <div class="rounded-lg border border-accent/60 bg-[#222] p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-6 text-white">Tile May Be Worth Considering If</h3>
        <ul class="space-y-4">
          {[
            'You want the distinctive appearance of a tile roof.',
            'Tile complements the architecture of the property.',
            'You are planning a larger replacement or new installation.',
            'You are willing to evaluate the complete roofing system rather than choosing tile based on appearance alone.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-accent font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-white/60">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg border border-accent/60 bg-[#222] p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-6 text-white">Look Closely at Other Options If</h3>
        <ul class="space-y-4">
          {[
            'The existing structure is not suited to the proposed tile system without additional work.',
            'Another material better matches your roof design or project budget.',
            'You want a roofing system with different installation or structural requirements.',
            'The specific tile product is not appropriate for the property or project.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-accent font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-white/60">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-8 text-center">
      <a href="/services/roofing-materials" class="btn btn-secondary">Compare Roofing Materials</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Clay Tile or Concrete Tile? · black bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline title="Clay Tile or Concrete Tile?" isDark={true} classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-10 md:mb-14 text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
      Both create a tile roof, but they are different materials. Industry guidance treats clay and concrete as separate roofing materials with their own product standards and installation requirements.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      <div class="rounded-lg border border-accent/60 bg-[#222] p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-6 text-white">Clay Tile</h3>
        <ul class="space-y-4">
          {[
            'Made from clay that is formed and fired at high temperatures.',
            'Available in traditional barrel profiles as well as other shapes and finishes.',
            'Product characteristics depend on the manufacturer and tile selected.',
            'May be selected when genuine clay is part of the architectural goal.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-accent font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-white/60">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg border border-accent/60 bg-[#222] p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-6 text-white">Concrete Tile</h3>
        <ul class="space-y-4">
          {[
            'Traditionally manufactured from cement, sand, and water, with pigments or finishes for different appearances.',
            'Available in profiles that can resemble clay tile, slate, shake, and other roofing styles.',
            'Product characteristics also vary significantly by manufacturer and profile.',
            'May be considered when homeowners want a broader range of tile profiles and appearances.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-accent font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-white/60">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- What Is Clay Tile Roofing? / What Is Concrete Tile Roofing? · white bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="About Clay Tile and Concrete Tile" classes={{ container: 'mb-10 md:mb-14' }} />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 md:gap-12">
      <div>
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-4">What Is Clay Tile Roofing?</h3>
        <div class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted space-y-4">
          <p>Clay roofing tiles are formed from clay and fired at high temperatures. They are available in different profiles, including traditional barrel and S-shaped designs as well as flatter styles.</p>
          <p>Clay may appeal to property owners who want the material itself to contribute to the architectural character of the building.</p>
          <p>The exact product still needs to be evaluated for the roof design and project requirements.</p>
        </div>
      </div>
      <div>
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-4">What Is Concrete Tile Roofing?</h3>
        <div class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted space-y-4">
          <p>Concrete roof tiles are manufactured from a cement-based mixture and formed into roofing units.</p>
          <p>Concrete can be produced in different colors, textures, and profiles. Some products are designed to resemble traditional clay tile, slate, or shake.</p>
          <p>That variety can give property owners several architectural directions while remaining within the concrete-tile category.</p>
        </div>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Tile Roofing Is More Than the Tile You See · grey bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Tile Roofing Is More Than the Tile You See
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 mb-8">
      <p>Individual tiles are only part of the roofing system. TRIA's current installation guidance covers all of these components along with roof loading and wind-uplift design criteria. That is why replacing a few visible tiles is not the same as evaluating the condition of the complete roof.</p>
      <p>A tile roofing project may also involve:</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
      {[
        'Roof deck',
        'Underlayment',
        'Flashing',
        'Valleys',
        'Roof penetrations',
        'Fasteners or attachment components',
        'Eave details',
        'Hip and ridge components',
      ].map((item) => (
        <div class="flex items-start gap-3">
          <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
          <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Tile Roofing and Oahu Conditions · black bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline title="Tile Roofing and Oahu Conditions" isDark={true} classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-10 md:mb-14 text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
      The right tile system for a property depends on more than appearance alone. Oahu's environmental conditions should be part of the evaluation.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {[
        {
          title: 'Rain and Water Management',
          description: 'Tile is part of a complete roofing assembly. Underlayment, flashing, valleys, penetrations, and roof transitions all contribute to how water is managed. The condition of these components matters when evaluating an existing tile roof.',
        },
        {
          title: 'Wind Exposure',
          description: 'Tile-roof installation requirements can vary based on wind design conditions and the system being installed. Current TRIA guidance includes specific wind-uplift design criteria, which is why R&C evaluates the actual property and selected tile rather than making a generic wind-resistance promise.',
        },
        {
          title: 'Coastal Exposure',
          description: 'The tiles themselves are not the only materials exposed to coastal conditions. Metal flashing, fasteners, and other roofing components should also be considered when planning a tile roof near the ocean.',
        },
        {
          title: 'Sun Exposure',
          description: 'Tile roofs are exposed to Oahu sun throughout the year. Appearance and weathering can differ based on the tile material, surface treatment, color, and specific product. Concrete and clay tiles are made from natural materials, so some color variation can also occur.',
        },
      ].map(({ title, description }) => (
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60">{description}</p>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- Advantages and Tradeoffs · white bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Advantages and Tradeoffs of Tile Roofing" classes={{ container: 'mb-10 md:mb-14' }} />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-6 text-heading">Potential Advantages</h3>
        <ul class="space-y-4">
          {[
            'Distinctive architectural appearance',
            'Available in several profiles and colors',
            'Clay and concrete provide different material choices within the tile category',
            'Can suit both traditional and contemporary architecture depending on the selected product',
            'Replacement tiles may sometimes allow localized repairs',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-6 text-heading">Considerations</h3>
        <ul class="space-y-4">
          {[
            'Structural and roof-loading requirements need to be considered',
            'Installation is more specialized than simply replacing individual surface materials',
            'Individual tiles can break and may require replacement',
            'Matching an older tile may become difficult if a profile or color is discontinued',
            'The condition of the underlayment and surrounding system may affect whether a localized repair is appropriate',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- How Long Does a Tile Roof Last? · grey bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      How Long Does a Tile Roof Last?
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 mb-8">
      <p>We would not use one lifespan number for every clay or concrete tile roof. The tiles themselves may remain serviceable for a long time while other parts of the roofing assembly require attention sooner. Product-specific warranty and system information are more useful than a blanket statement.</p>
      <p>Service life depends on the individual roofing system, including:</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
      {[
        'Tile product',
        'Underlayment',
        'Installation',
        'Roof design',
        'Property exposure',
        'Flashing and other components',
        'Maintenance',
        'Previous repairs or damage',
      ].map((item) => (
        <div class="flex items-start gap-3">
          <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
          <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What Does Tile Roofing Cost on Oahu? · black bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 md:mb-12">
      <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white">
        What Does Tile Roofing Cost on Oahu?
      </h2>
      <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-md border-2 border-accent text-white font-semibold text-[15px] leading-snug hover:bg-accent hover:text-black transition-colors duration-200 shrink-0">Request an Estimate</a>
    </div>
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 mb-8 md:mb-10">
      Tile-roof pricing depends on the property and selected roofing system. R&amp;C provides project-specific pricing after evaluating the property and proposed tile system.
    </p>
    <div class="divide-y divide-white/20 border-t border-white/20">
      {[
        { title: 'Clay or Concrete', description: 'The tile material and specific product can affect material pricing.' },
        { title: 'Roof Size and Design', description: 'Roof area, slope, hips, valleys, penetrations, and architectural complexity influence installation.' },
        { title: 'Structural Requirements', description: 'The proposed tile system needs to be appropriate for the property. Any additional structural work would affect the overall project scope.' },
        { title: 'Existing Roof Condition', description: 'When replacing another roof, conditions beneath the existing roofing materials may affect the work required.' },
        { title: 'Tile Profile and Details', description: 'Different profiles can require different components and installation methods.' },
        { title: 'Property Access', description: 'Building height and site access can also affect project logistics.' },
      ].map(({ title, description }) => (
        <div class="py-6 md:py-8 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-2 text-white">{title}</h3>
          <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/60">{description}</p>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- Can You Replace Shingles or Metal With Tile? · white bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Can You Replace Shingles or Metal With Tile?
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 mb-8">
      <p>Potentially, but changing to tile should not be treated as a simple material swap. The existing structure and roof design need to be considered along with the proposed tile system.</p>
      <p>R&amp;C can evaluate the property before recommending whether a transition from asphalt shingles, metal roofing, or another system to tile should be considered.</p>
    </div>
    <a href="/services/roof-replacement-and-new-installation" class="btn-primary">Explore Roof Replacement &amp; New Installation</a>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Can a Tile Roof Be Repaired? · grey bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Can a Tile Roof Be Repaired?
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 mb-8">
      <p>Sometimes. Individual broken or displaced tiles may be replaceable when the surrounding roofing system remains in serviceable condition and compatible replacement material is available. However, the visible tile is only part of the roof.</p>
      <p>If leaks or repeated tile damage are occurring, R&amp;C may need to evaluate the surrounding tiles, flashing, and accessible underlying roofing conditions before recommending a repair. TRIA recommends inspection of the underlayment before repairs are carried out on storm-damaged tile roofs.</p>
    </div>
    <a href="/services/roof-repair" class="btn-primary">Explore Roof Repair</a>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- How R&C Approaches a Tile Roofing Project · black bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 md:mb-12">
      <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white">
        How R&amp;C Approaches a Tile Roofing Project
      </h2>
      <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-md border-2 border-accent text-white font-semibold text-[15px] leading-snug hover:bg-accent hover:text-black transition-colors duration-200 shrink-0">Plan Your Tile Roof</a>
    </div>
    <div class="flex flex-col md:flex-row gap-10 md:gap-16">
      <div class="md:basis-1/2 flex flex-col gap-6">
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
          <p>Every tile roofing project starts with evaluating whether tile is appropriate for the property. R&amp;C looks at the structure, conditions, and selected system before developing the roofing scope.</p>
        </div>
      </div>
      <div class="md:basis-1/2">
        <Timeline
          isDark={true}
          items={[
            {
              title: 'Evaluate the Property',
              description: 'We start with the existing roof when applicable, roof design, project goals, and property conditions.',
              icon: 'tabler:search',
            },
            {
              title: 'Determine Whether Tile Is Appropriate',
              description: 'The proposed material and roofing system are considered in the context of the building.',
              icon: 'tabler:checklist',
            },
            {
              title: 'Compare Clay and Concrete Options',
              description: 'Available profiles and products can be reviewed based on the project and desired appearance.',
              icon: 'tabler:template',
            },
            {
              title: 'Develop the Roofing Scope',
              description: 'R&C defines the proposed work based on the roof and selected tile system.',
              icon: 'tabler:file-description',
            },
            {
              title: 'Complete the Roofing Work',
              description: 'If the project moves forward, R&C installs the agreed roofing system according to the project specifications and applicable requirements.',
              icon: 'tabler:home-check',
            },
          ]}
        />
      </div>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- See Tile Roofing on Real Oahu Properties · white bg -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="See Tile Roofing on Real Oahu Properties" classes={{ container: 'mb-8 md:mb-12' }} />
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
      {[
        { neighborhood: '[Neighborhood]', tile: '[Clay or Concrete Tile]', project: '[Verified replacement or new installation]', description: '[Short verified description of the project.]' },
        { neighborhood: '[Neighborhood]', tile: '[Clay or Concrete Tile]', project: '[Verified scope]', description: '[Short verified description.]' },
        { neighborhood: '[Neighborhood]', tile: '[Clay or Concrete Tile]', project: '[Verified scope]', description: '[Short verified description.]' },
      ].map(({ neighborhood, tile, project, description }) => (
        <div class="rounded-lg border border-white/16 bg-white dark:bg-slate-900 shadow-card p-4">
          <div class="w-full h-40 bg-gray-100 dark:bg-slate-800 rounded mb-3 flex items-center justify-center text-gray-300 dark:text-slate-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-[13px] md:text-[14px] font-medium text-muted mb-1">{neighborhood} | {tile}</p>
          <p class="text-[15px] md:text-[16px] font-semibold font-heading text-heading mb-1">Project: {project}</p>
