---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import IconPointBand from '~/components/ui/IconPointBand.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { hubMaterialCards, serviceHeroActions } from '~/data/pages/materials';

const metadata = {
  title: 'Roofing Materials Oahu | Compare Roof Options | R&C Roofing',
  description:
    'Compare roofing materials for Oahu properties, including metal, asphalt shingles, stone-coated steel, and clay or concrete tile. Explore your options with R&C Roofing.',
  ignoreTitleTemplate: true,
};

const howToChoose = [
  {
    title: 'Roof Design & Slope',
    description:
      'The pitch, shape, size, and transitions of your roof dictate which installation methods and systems are appropriate.',
    icon: 'tabler:ruler-measure',
  },
  {
    title: 'Property Location & Microclimates',
    description:
      'Environmental factors across Oahu—such as coastal salt air, heavy valley rainfall, wind exposure, and intense tropical sun—directly impact material lifespan.',
    icon: 'tabler:map-pin',
  },
  {
    title: 'Existing Structure',
    description:
      'If you are replacing an existing roof, your current decking and framing assembly may limit or influence your material options.',
    icon: 'tabler:building',
  },
  {
    title: 'Architectural Appearance',
    description:
      "Roofing materials make up a major portion of your property's exterior aesthetic, ranging from clean metal lines to textured tile.",
    icon: 'tabler:home',
  },
  {
    title: 'Total Project Budget',
    description:
      'Material cost is only part of the equation; installation complexity, structural adjustments, and project scope determine overall investment.',
    icon: 'tabler:wallet',
  },
];

const comparisonRows = [
  {
    material: 'Metal Roofing',
    goodFor: 'Properties wanting a durable, modern metal system for replacement or new construction.',
    appearance: 'Available in different profiles and modern finishes.',
    consider: 'Roof design, finish quality, coastal salt-air exposure, and system specs.',
  },
  {
    material: 'Asphalt Shingles',
    goodFor: 'Homes looking for a familiar, cost-effective residential roofing solution.',
    appearance: 'Traditional shingle profile with wide style choices.',
    consider: 'Product selection, roof slope, local wind exposure, and budget.',
  },
  {
    material: 'Stone-Coated Steel',
    goodFor: 'Property owners wanting steel strength with a textured residential look.',
    appearance: 'Profiles resembling tile, shake, or traditional shingles.',
    consider: 'System selection, roof design, structural load, and project requirements.',
  },
  {
    material: 'Clay & Concrete Tile',
    goodFor: 'Homes and buildings structurally suited for a heavy-weight tile system.',
    appearance: 'Distinctive, traditional tile architectural profile.',
    consider: 'Structural weight capacity, roof pitch, and specialized installation requirements.',
  },
];

const faqs = [
  {
    title: 'What roofing materials does R&C install on Oahu?',
    description:
      'We work with a variety of proven residential and commercial systems, including metal roofing, asphalt shingles, stone-coated steel, and clay or concrete tile.',
  },
  {
    title: 'What is the best roofing material for a home on Oahu?',
    description:
      'There is no single "best" material for every property. The right choice depends on your roof\'s design, neighborhood weather exposure, structural load capacity, and budget.',
  },
  {
    title: 'Does living near the ocean affect my roofing material choice?',
    description:
      'Yes. Coastal salt air can accelerate corrosion on certain exposed metal fasteners, flashing, and finishes, making material and component selection critical for oceanfront properties.',
  },
  {
    title: 'Can I change to a different roofing material during a replacement?',
    description:
      'Often yes, but it depends on your existing roof structure, roof pitch, and weight capacity. We evaluate these factors before recommending a material switch.',
  },
  {
    title: 'Should I choose my roofing material before scheduling an inspection?',
    description:
      'No. If you are unsure which material fits your property best, we can evaluate your roof\'s physical condition first and then discuss which options align with your project goals.',
  },
];
---

<Layout metadata={metadata}>
  <Hero2 actions={serviceHeroActions('Discuss Your Roofing Material Options')}>
    <Fragment slot="title">Roofing Materials for Oahu Properties</Fragment>
    <Fragment slot="subtitle">
      Compare your options before choosing a roof. We help you evaluate how different materials fit your property's
      architecture, local weather exposure, and budget—backed by Hawaii License C-33642.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Roofing materials photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Choose Your Roofing Material" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      Every material performs differently under island conditions. Select a category below to explore specific styles,
      benefits, and considerations:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {
        hubMaterialCards.map((card) => (
          <ServiceCard
            title={card.title}
            description={card.description}
            href={card.href}
            linkText={card.linkText}
            variant="dark"
          />
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="Compare Your Options at a Glance" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      Use this matrix to understand how different roofing materials match various property goals:
    </p>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[720px] border-separate border-spacing-0 text-left">
        <thead>
          <tr>
            <th class="bg-[#222] text-white text-[13px] md:text-[14px] font-bold leading-[160%] px-4 md:px-5 py-3 md:py-4 rounded-tl-lg border-r border-accent">
              Roofing Material
            </th>
            <th class="bg-[#222] text-white text-[13px] md:text-[14px] font-bold leading-[160%] px-4 md:px-5 py-3 md:py-4 border-r border-accent">
              Good Starting Point For
            </th>
            <th class="bg-[#222] text-white text-[13px] md:text-[14px] font-bold leading-[160%] px-4 md:px-5 py-3 md:py-4 border-r border-accent">
              Appearance
            </th>
            <th class="bg-[#222] text-accent text-[13px] md:text-[14px] font-bold leading-[160%] px-4 md:px-5 py-3 md:py-4 rounded-tr-lg">
              Key Considerations
            </th>
          </tr>
        </thead>
        <tbody>
          {
            comparisonRows.map((row, index) => {
              const isLast = index === comparisonRows.length - 1;
              return (
                <tr>
                  <th
                    class:list={[
                      'align-top bg-white text-heading text-[14px] md:text-[15px] font-medium font-heading leading-[130%] px-4 md:px-5 py-4 md:py-5 border-r border-accent',
                      isLast && 'rounded-bl-lg',
                    ]}
                  >
                    {row.material}
                  </th>
                  <td class="align-top bg-white text-muted text-[14px] md:text-[15px] font-normal leading-[160%] px-4 md:px-5 py-4 md:py-5 border-r border-accent">
                    {row.goodFor}
                  </td>
                  <td class="align-top bg-white text-muted text-[14px] md:text-[15px] font-normal leading-[160%] px-4 md:px-5 py-4 md:py-5 border-r border-accent">
                    {row.appearance}
                  </td>
                  <td
                    class:list={[
                      'align-top bg-white text-muted text-[14px] md:text-[15px] font-normal leading-[160%] px-4 md:px-5 py-4 md:py-5',
                      isLast && 'rounded-br-lg',
                    ]}
                  >
                    {row.consider}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="How to Choose the Right Roofing Material on Oahu" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      Choosing a roof involves looking beyond a product photo. Every material performs differently based on your specific
      property:
    </p>
    <IconPointBand items={howToChoose} />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <FAQs title="Frequently Asked Questions" items={faqs}>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </FAQs>

  <CTABanner
    title="Compare Your Roofing Options With R&C Roofing"
    subtitle="Do not choose a roofing material based on a single feature alone. Get expert guidance matched to your specific property."
    ctaText="Discuss Your Roofing Material Options"
  />
</Layout>
