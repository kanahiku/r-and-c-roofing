---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import IconPointBand from '~/components/ui/IconPointBand.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import ComparisonTable from '~/components/ui/ComparisonTable.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { exploreFromSlate, serviceHeroActions } from '~/data/pages/materials';

const metadata = {
  title: 'Slate & Rubber Slate Roofing Oahu | R&C Roofing',
  description:
    'Explore slate and synthetic rubber slate roofing for Oahu properties. Learn about natural stone durability, lightweight alternatives, and expert installation with R&C.',
  ignoreTitleTemplate: true,
};

const slateTypes = [
  {
    title: 'Natural Slate',
    description:
      'Formed from real stone, offering a genuine, centuries-old aesthetic and extreme longevity. However, it requires significant structural framing reinforcements due to its heavy weight.',
    icon: 'tabler:mountain',
  },
  {
    title: 'Synthetic Rubber Slate',
    description:
      'Engineered from durable rubber and polymer composites designed to replicate the exact look of natural stone while remaining lightweight and highly resistant to impact damage.',
    icon: 'tabler:layers-intersect',
  },
];

const microclimates = [
  {
    title: 'Wind Uplift & Storm Resistance',
    description:
      'Secure fastening methods and specialized installation patterns ensure that individual slates or synthetic units remain locked down during severe wind events.',
    icon: 'tabler:wind',
  },
  {
    title: 'Moisture & Weather Performance',
    description:
      'High-performance underlayment systems provide essential secondary waterproofing against heavy valley downpours.',
    icon: 'tabler:droplet',
  },
  {
    title: 'Coastal & UV Durability',
    description:
      'Natural stone and UV-stabilized synthetic compounds resist tropical sun degradation and harsh coastal exposure.',
    icon: 'tabler:sun',
  },
];

const whyTrust = [
  {
    title: 'Licensed Hawaii Contractor',
    description: "Operating under License C-33642 with full general liability and workers' compensation coverage.",
    icon: 'tabler:certificate',
  },
  {
    title: '50+ Years Combined Experience',
    description: 'Decades of specialized island roofing knowledge across residential and commercial buildings.',
    icon: 'tabler:clock',
  },
  {
    title: 'Structural Expertise',
    description:
      'We carefully analyze load requirements for natural stone versus lightweight synthetic options before recommending a system.',
    icon: 'tabler:building',
  },
  {
    title: 'Inspection-First Philosophy',
    description: 'We base our recommendations on physical facts to ensure your investment is sound.',
    icon: 'tabler:search',
  },
];
---

<Layout metadata={metadata}>
  <Hero2 actions={serviceHeroActions('Discuss a Slate Roofing Project')}>
    <Fragment slot="title">Slate &amp; Rubber Slate Roofing on Oahu</Fragment>
    <Fragment slot="subtitle">
      Explore natural slate and advanced synthetic rubber slate roofing systems engineered for premium architectural
      aesthetics and durability across Oahu—backed by Hawaii License C-33642.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Slate roofing photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[26px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-[20px]">
      Is Slate or Rubber Slate Right for Your Property?
    </h2>
    <div class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted space-y-5">
      <p>
        Slate provides an unmatched, timeless natural stone appearance and incredible longevity, but its extreme weight
        requires specialized structural framing. For properties that want the high-end look of slate without the heavy
        load demands, modern synthetic rubber slate offers a lightweight, durable alternative.
      </p>
      <p>
        We evaluate your building’s architectural style, structural load capacity, and local environment to determine
        which option is the right fit.
      </p>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="Comparing Slate Options to Other Roofing Materials" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      To decide if natural or synthetic slate is right for your project, it helps to see how it compares against
      alternative systems:
    </p>
    <ComparisonTable
      isDark={true}
      featureLabel="Material Comparison"
      columns={['When to Choose Slate or Rubber Slate', 'When to Consider Alternatives']}
      rows={[
        {
          feature: 'vs. Asphalt Shingles',
          left: 'You want a high-end, luxury architectural aesthetic paired with exceptional long-term weathering and impact resistance.',
          right: 'Your project requires a lower initial budget or a standard residential shingle profile.',
        },
        {
          feature: 'vs. Metal Roofing',
          left: 'You want a classic stone or slate appearance rather than a contemporary, sleek metal panel finish.',
          right: 'You prefer modern architectural lines and a lightweight, low-slope metal installation.',
        },
        {
          feature: 'vs. Standard Tile',
          left: 'You want a distinct stone or synthetic slate shingle profile instead of traditional barrel or S-curve clay/concrete tiles.',
          right: 'You want a heavier traditional tile aesthetic or a more standard tile profile.',
        },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Natural Slate vs. Synthetic Rubber Slate" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      While both deliver an upscale slate aesthetic, they differ significantly in weight, composition, and structural
      requirements:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
      {
        slateTypes.map((card) => (
          <InfoCard title={card.title} description={card.description} icon={card.icon} variant="light" border={false} />
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Slate Roofing and Oahu’s Microclimates" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      A high-end slate or synthetic slate roof must be engineered for island weather conditions:
    </p>
    <IconPointBand items={microclimates} />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="Explore Other Roofing Materials" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      Compare slate and rubber slate side-by-side with other available material options for your Oahu property:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {
        exploreFromSlate.map((card) => (
          <ServiceCard
            title={card.title}
            description={card.description}
            href={card.href}
            linkText={card.linkText}
            variant="dark"
          />
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Why Oahu Property Owners Trust R&C Roofing" classes={{ container: 'mb-[30px] text-left md:mx-0' }} />
    <IconPointGrid items={whyTrust} />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title="Find Out if Slate Fits Your Property"
    subtitle="Get expert guidance and objective structural facts for your natural or synthetic slate roofing project."
    ctaText="Discuss a Slate Roofing Project"
  />
</Layout>
