---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import IconPointBand from '~/components/ui/IconPointBand.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import ComparisonTable from '~/components/ui/ComparisonTable.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { exploreFromAsphalt, serviceHeroActions } from '~/data/pages/materials';

const metadata = {
  title: 'Asphalt Shingle Roofing Oahu | R&C Roofing Contractors',
  description:
    'Explore asphalt shingle roofing for Oahu homes. Compare shingle styles, wind resistance, weather performance, and professional installation with R&C.',
  ignoreTitleTemplate: true,
};

const shingleTypes = [
  {
    title: 'Architectural (Dimensional) Shingles',
    description:
      'Multi-layered shingles that provide a thicker, more dimensional appearance and enhanced wind resistance compared to standard three-tab shingles.',
    icon: 'tabler:layers-intersect',
  },
  {
    title: 'Specialty & Impact-Resistant Shingles',
    description:
      'Advanced shingle lines engineered with enhanced granules or modified asphalt for superior weather performance and granule retention.',
    icon: 'tabler:shield-check',
  },
];

const microclimates = [
  {
    title: 'Wind Uplift & Fastening',
    description:
      'Shingle installation must follow strict high-wind fastening patterns and local building codes to prevent blow-offs during severe tropical storms.',
    icon: 'tabler:wind',
  },
  {
    title: 'Heat & UV Degradation',
    description:
      'Intense year-round sun accelerates granule loss and thermal aging, making proper attic ventilation and high-quality shingle selection essential.',
    icon: 'tabler:sun',
  },
  {
    title: 'Moisture & Algae Resistance',
    description:
      'Balanced roof ventilation and algae-resistant shingle granules help prevent moisture buildup and dark staining caused by island humidity.',
    icon: 'tabler:droplet',
  },
];

const whyTrust = [
  {
    title: 'Licensed Hawaii Contractor',
    description: "Operating under License C-33642 with full general liability and workers' compensation coverage.",
    icon: 'tabler:certificate',
  },
  {
    title: '50+ Years Combined Experience',
    description: 'Decades of specialized island roofing knowledge across residential and commercial buildings.',
    icon: 'tabler:clock',
  },
  {
    title: 'Code-Compliant Installation',
    description: "We ensure precise fastening, flashing, and ventilation setup to maximize your shingle roof's lifespan.",
    icon: 'tabler:building',
  },
  {
    title: 'Inspection-First Philosophy',
    description: 'We base our recommendations on physical facts to ensure your investment is sound.',
    icon: 'tabler:search',
  },
];
---

<Layout metadata={metadata}>
  <Hero2 actions={serviceHeroActions('Discuss an Asphalt Shingle Project')}>
    <Fragment slot="title">Asphalt Shingle Roofing on Oahu</Fragment>
    <Fragment slot="subtitle">
      Explore versatile, dependable asphalt shingle roofing systems engineered for residential and sloped properties
      across Oahu—backed by Hawaii License C-33642.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Asphalt shingle roofing photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Is Asphalt Shingle Roofing Right for Your Property?
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>
        Asphalt shingles remain the most popular choice for sloped residential roofs, offering a dependable balance of
        traditional appearance, broad style options, and cost-effectiveness.
      </p>
      <p>
        However, choosing shingles involves more than picking a color. Roof slope, neighborhood wind exposure, attic
        ventilation, and proper fastening all play a vital role in how well your shingle roof withstands island weather.
        We evaluate your property to ensure your shingle system is installed to strict manufacturer and building code
        standards.
      </p>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="Comparing Asphalt Shingles to Other Materials" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      To decide if asphalt shingles are right for your project, it helps to see how they compare against alternative
      systems:
    </p>
    <ComparisonTable
      featureLabel="Material Comparison"
      columns={['When to Choose Asphalt Shingles', 'When to Consider Alternatives']}
      rows={[
        {
          feature: 'vs. Metal Roofing',
          left: 'You want a familiar residential shingle profile, lower initial project costs, and straightforward repairability.',
          right:
            'You want a modern architectural metal look or a maximum-longevity system designed for decades of service.',
        },
        {
          feature: 'vs. Stone-Coated Steel',
          left: 'You prefer a traditional shingle aesthetic paired with a budget-friendly initial investment.',
          right: 'You want maximum impact durability and extreme wind uplift resistance backed by a steel base.',
        },
        {
          feature: 'vs. Tile Roofing',
          left: 'Your roof structure requires a lightweight roofing material without heavy framing load reinforcements.',
          right: 'You prefer a distinctive, high-end clay, concrete, or slate architectural profile.',
        },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Asphalt Shingle Options: Architectural vs. Traditional" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Modern asphalt shingles come in different profiles designed to suit various aesthetic and performance goals:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
      {
        shingleTypes.map((card) => (
          <InfoCard title={card.title} description={card.description} icon={card.icon} variant="light" border={false} />
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Asphalt Shingle Roofing and Oahu’s Microclimates" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-12">
      An asphalt shingle roof must be specified and installed to handle Hawaii’s unique environmental factors:
    </p>
    <IconPointBand items={microclimates} />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="Explore Other Roofing Materials" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-center max-w-3xl mx-auto mb-8 md:mb-12">
      Compare asphalt shingles side-by-side with other available material options for your Oahu property:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {
        exploreFromAsphalt.map((card) => (
          <ServiceCard
            title={card.title}
            description={card.description}
            href={card.href}
            linkText={card.linkText}
            variant="dark"
          />
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Why Oahu Property Owners Trust R&C Roofing" classes={{ container: 'mb-4 md:mb-6 text-left md:mx-0' }} />
    <IconPointGrid items={whyTrust} />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title="Find Out if Asphalt Shingles Fit Your Property"
    subtitle="Get expert guidance and objective facts for your asphalt shingle roofing project."
    ctaText="Discuss an Asphalt Shingle Project"
  />
</Layout>
