---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import ServiceDirectory from '~/components/ui/ServiceDirectory.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { roofingServiceLinks, serviceHeroActions } from '~/data/pages/services';

const metadata = {
  title: 'Commercial Roofing Oahu | R&C Roofing Contractors',
  description:
    'Commercial roofing services on Oahu from R&C Roofing Contractors. We provide roof inspections, repairs, replacement, and roofing support for property owners and project teams.',
  ignoreTitleTemplate: true,
};

const stakeholders = [
  {
    title: 'Property Managers',
    description:
      'Clear assessments, routine inspections, and reliable budgeting information to protect community assets and reserve funds.',
    icon: 'tabler:building-community',
  },
  {
    title: 'General Contractors',
    description:
      'Professional roofing scope execution that integrates cleanly into broader construction, renovation, or multi-trade schedules.',
    icon: 'tabler:briefcase',
  },
  {
    title: 'Architects & Design Teams',
    description:
      'Technical contractor input on system selection, weight loads, penetrations, and building design alignment.',
    icon: 'tabler:ruler-measure',
  },
  {
    title: 'Association Boards & Trustees',
    description:
      'Objective structural data and transparent documentation to support informed capital expenditure decisions.',
    icon: 'tabler:users',
  },
];

const systems = [
  {
    title: 'Low-Slope & Flat Roof Systems',
    description: 'Engineered membrane and built-up systems designed to handle pooling water and intense tropical heat.',
    icon: 'tabler:layout',
  },
  {
    title: 'Liquid-Applied Roof Coatings',
    description:
      'Seamless elastomeric and reflective coatings that protect existing commercial surfaces and lower interior building temperatures.',
    icon: 'tabler:paint',
  },
  {
    title: 'Modified Bitumen Roofing',
    description: 'Multi-layer durable systems built for high-traffic commercial roofs and heavy asset placement.',
    icon: 'tabler:layers-intersect',
  },
  {
    title: 'Commercial Metal Retrofits',
    description: 'Specialized structural restoration and fastening for aging commercial metal panel buildings.',
    icon: 'tabler:building-factory',
  },
];

const whyTrust = [
  {
    title: 'Licensed Hawaii Contractor',
    description:
      "Operating under License C-33642 with full general liability and workers' compensation coverage for commercial sites.",
    icon: 'tabler:certificate',
  },
  {
    title: '50+ Years Combined Experience',
    description:
      'Decades of specialized island roofing experience across multi-family units, association boards, and commercial builds.',
    icon: 'tabler:clock',
  },
  {
    title: 'Inspection-First Philosophy',
    description:
      'We base our recommendations on physical facts, ensuring you only pay for the scope of work your property requires.',
    icon: 'tabler:search',
  },
  {
    title: 'Clear Stakeholder Documentation',
    description:
      'We provide photographic evidence and project-specific pricing that can easily be reviewed by property owners, boards, and project teams.',
    icon: 'tabler:file-text',
  },
];

const related = [
  {
    title: 'Roof Repair',
    description:
      'Targeted fixes for active leaks, localized damage, and failing flashings when surrounding systems remain sound.',
    href: roofingServiceLinks.repair.href,
    linkText: 'View Roof Repair',
  },
  {
    title: 'Roof Replacement',
    description: 'Comprehensive tear-offs and new commercial roofing installations engineered to strict wind-uplift codes.',
    href: roofingServiceLinks.replacement.href,
    linkText: 'View Roof Replacement',
  },
  {
    title: 'Roof Inspections',
    description:
      'Professional assessments led by HAAG Certified Inspector Robert Pilato (Cert #201408313) to document visible conditions.',
    href: roofingServiceLinks.inspections.href,
    linkText: 'View Roof Inspections',
  },
  {
    title: 'Gutter Services',
    description:
      'Custom seamless gutter installation and repair to route heavy island rainfall away from your commercial foundation.',
    href: roofingServiceLinks.gutters.href,
    linkText: 'View Gutter Services',
  },
];
---

<Layout metadata={metadata}>
  <Hero2 actions={serviceHeroActions('Discuss Your Commercial Roofing Project')}>
    <Fragment slot="title">Commercial Roofing Services on Oahu</Fragment>
    <Fragment slot="subtitle">
      Expert roofing support, inspections, repairs, and complete replacements engineered for commercial properties,
      property managers, and project teams across Oahu—backed by Hawaii License C-33642.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Commercial roofing photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Tailored Roofing Support for Commercial Stakeholders" classes={{ container: 'mb-[9px] text-left md:mx-0' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted mb-[30px]">
      Commercial roofing decisions involve unique operational priorities, property budgets, tenant requirements, and
      stakeholder coordination. We provide structured, diagnostic-driven solutions tailored to your property management
      role:
    </p>
    <IconPointGrid items={stakeholders} />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="Commercial Roofing Systems &amp; Solutions" classes={{ container: 'mb-[9px] text-left md:mx-0' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-white/70 mb-[30px]">
      Different commercial building designs require specific engineering and waterproofing approaches. We install and
      service commercial systems tailored to Oahu properties, including:
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
      {
        systems.map((card) => (
          <InfoCard title={card.title} description={card.description} icon={card.icon} variant="dark" />
        ))
      }
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Our Commercial Roofing Services" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      As a licensed Hawaii contractor, we provide a complete suite of commercial solutions designed to minimize downtime
      and protect building envelopes:
    </p>
    <ServiceDirectory items={related} variant="light" />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Why Oahu Commercial Properties Trust R&C Roofing" classes={{ container: 'mb-[30px] text-left md:mx-0' }} />
    <IconPointGrid items={whyTrust} />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="What Happens Next?" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      Managing a commercial roofing project is straightforward with our structured, collaborative process:
    </p>
    <Timeline
      isDark={true}
      items={[
        {
          title: 'Discuss the Property & Project',
          description: 'Contact us to share your building type, timeline, and specific roofing concerns.',
          icon: 'tabler:message',
        },
        {
          title: 'Evaluate the Roof',
          description: 'We perform a thorough site evaluation of accessible roofing areas to assess structural conditions.',
          icon: 'tabler:search',
        },
        {
          title: 'Review the Scope & Estimates',
          description: 'We provide clear, contractor-side documentation, photographic evidence, and project pricing for your stakeholders.',
          icon: 'tabler:file-text',
        },
        {
          title: 'Execute the Work',
          description: 'Our licensed crews manage the project safely, cleanly, and on schedule.',
          icon: 'tabler:hammer',
        },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title="Partner With Experienced Commercial Roofers"
    subtitle="Get the structural facts and professional execution your commercial property requires."
    ctaText="Discuss Your Commercial Roofing Project"
  />
</Layout>
