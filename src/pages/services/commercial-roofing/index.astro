---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Timeline from '~/components/ui/Timeline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import ProjectsSection from '~/components/widgets/ProjectsSection.astro';

const metadata = {
  title: 'Commercial Roofing Oahu | R&C Roofing Contractors',
  description:
    'Commercial roofing services on Oahu from R&C Roofing Contractors. We provide roof inspections, repairs, replacement, and roofing support for property owners and project teams.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- P-01 · Hero -->
  <Hero2
    actions={[{ variant: 'primary', text: 'Discuss Your Commercial Roofing Project', href: '/contact' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=80',
      alt: 'Commercial roofing project on an Oahu building',
    }}
  >
    <Fragment slot="title">
      Commercial Roofing Services on Oahu
    </Fragment>
    <Fragment slot="subtitle">
      <p class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Roofing Support for Commercial Properties and Project Teams
      </p>
      Commercial roofing decisions often involve more than the condition of the roof. Property budgets, tenant needs, construction schedules, documentation, and coordination with multiple stakeholders can all affect how a roofing project moves forward.
      <br /><br />
      R&amp;C Roofing Contractors provides commercial roofing services within its Oahu service area. We work with property owners and the professionals responsible for evaluating, planning, and completing roofing work. Our commercial capabilities include roof inspections, repair, replacement, and new roof installation.
      <br /><br />
      R&amp;C operates under Hawaii contractor license C-33642 and brings more than 50 years of combined roofing experience to projects in Hawaii.
      <span class="block mt-8"></span>
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <!-- P-05 style · Who We Work With (Grey #FAFAFA — black cards) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Who We Work With" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-8 md:mb-12 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      Commercial roofing projects look different depending on who is responsible for the property.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      {[
        {
          title: 'Property Managers',
          description: 'When you oversee one or more properties, you need clear information about roof condition, recommended work, and potential next steps. R&C can help evaluate roofing concerns and provide contractor-side information for repair planning, replacement discussions, and property budgeting.',
          href: '/contact',
          linkText: 'Explore Roofing for Property Managers',
        },
        {
          title: 'General Contractors',
          description: 'Roofing work may be one part of a larger construction or renovation project. R&C can coordinate the roofing scope as a licensed roofing contractor and work with the project team based on the construction requirements.',
          href: '/contact',
          linkText: 'Explore Roofing for General Contractors',
        },
        {
          title: 'Architects & Design Professionals',
          description: 'Roofing decisions can involve system selection, existing conditions, project requirements, and coordination with the larger building design. R&C can provide roofing contractor input during the planning and construction process.',
          href: '/contact',
          linkText: 'Explore Roofing for Architects',
        },
        {
          title: 'Property Owners, Trustees & Association Boards',
          description: 'Decision-makers responsible for commercial or shared properties often need information they can review before approving a larger roofing expense. R&C can inspect the roof, explain the proposed roofing scope, and provide project-specific contractor information.',
          href: '/contact',
          linkText: 'Explore Roofing for Property Decision-Makers',
        },
      ].map(({ title, description, href, linkText }) => (
        <div class="rounded-lg border border-accent/60 bg-[#222] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60 flex-1">{description}</p>
          <a href={href} class="mt-4 text-accent font-medium text-[14px] md:text-[15px] hover:underline">
            {linkText} →
          </a>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Stacked rows · What Does Your Commercial Roof Need? (Black) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white mb-4 md:mb-6 text-center">
      What Does Your Commercial Roof Need?
    </h2>
    <p class="text-center max-w-3xl mx-auto mb-10 md:mb-14 text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
      The right next step depends on the property and the condition of the roofing system.
    </p>
    <div class="divide-y divide-white/10 border-t border-white/10">
      {[
        {
          title: 'A Roof Problem Needs Attention',
          description: 'Leaks, damaged materials, flashing concerns, or other localized conditions may require repair.',
          href: '/services/roof-repair',
          linkText: 'Explore Roof Repair',
        },
        {
          title: 'The Roof May Need Replacement',
          description: 'Widespread deterioration or recurring roofing problems may point to a larger replacement project.',
          href: '/services/roof-replacement-and-new-installation',
          linkText: 'Explore Roof Replacement',
        },
        {
          title: 'A New Project Is Being Planned',
          description: 'R&C can provide roofing services for new construction, renovations, additions, or other planned projects.',
          href: '/contact',
          linkText: 'Discuss Your Project',
        },
        {
          title: 'We Need to Understand Roof Condition',
          description: 'An inspection can provide a closer look at accessible roofing areas and visible conditions.',
          href: '/roof-inspections',
          linkText: 'Explore Roof Inspections',
        },
        {
          title: 'The Property Has Storm Damage',
          description: 'R&C can document relevant visible conditions following severe weather.',
          href: '/roof-inspections/storm-and-wind-damage-inspection',
          linkText: 'View Storm Damage Inspections',
        },
        {
          title: 'We Need Roofing Information for Planning',
          description: 'Contractor-side findings, scope information, and estimates can support internal planning and decision-making.',
          href: '/contact',
          linkText: 'Contact R&C',
        },
      ].map(({ title, description, href, linkText }) => (
        <div class="py-8 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 mb-3">{description}</p>
          <a href={href} class="text-accent font-medium text-[14px] md:text-[15px] hover:underline">{linkText} →</a>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 · Commercial Roof Inspections (White bg) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-6 md:mb-8">
      Commercial Roof Inspections
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 mb-8">
      <p>
        A commercial roofing project does not always begin with construction. Sometimes the first need is simply understanding the current condition of the roof.
      </p>
      <p>
        R&amp;C can inspect accessible roofing areas and document relevant visible conditions when a property owner or project team needs more information. R&amp;C's team includes HAAG Certified Inspector Robert Pilato, Certification #201408313, with specialized training in roof damage assessment.
      </p>
      <p>An inspection may be useful when:</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mb-8">
      {[
        'A leak or other roofing concern has developed',
        'The condition of an existing roof is unclear',
        'Repair and replacement options are being evaluated',
        'A property is being reviewed for future capital planning',
        'Severe weather may have affected the roof',
        'Roofing information is needed before a larger project moves forward',
      ].map((item) => (
        <div class="flex items-start gap-3">
          <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
          <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
        </div>
      ))}
    </div>
    <a href="/roof-inspections" class="btn-primary">Explore Commercial Roof Inspections</a>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 · Commercial Roof Repair (Grey #FAFAFA) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-6 md:mb-8">
      Commercial Roof Repair
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5 mb-8">
      <p>
        A localized roofing problem does not automatically mean the entire system needs to be replaced. If damage is limited and the surrounding roofing system remains serviceable, repair may be an appropriate option.
      </p>
      <p>Commercial roof repairs may address conditions involving:</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mb-8">
      {[
        'Active or recurring leaks',
        'Damaged roofing materials',
        'Flashing and roof transitions',
        'Penetrations',
        'Roof edges',
        'Drainage-related roofing areas',
        'Localized deterioration',
      ].map((item) => (
        <div class="flex items-start gap-3">
          <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
          <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
        </div>
      ))}
    </div>
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-8">
      The repair recommendation depends on what R&amp;C finds at the property.
    </p>
    <a href="/services/roof-repair" class="btn-primary">Explore Roof Repair Services</a>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 · Commercial Roof Replacement & New Installation (Black) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white mb-6 md:mb-8">
      Commercial Roof Replacement &amp; New Installation
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 space-y-5 mb-8">
      <p>
        Replacement may need to be considered when the existing roofing system has broader deterioration or when localized repairs would not adequately address the overall condition.
      </p>
      <p>
        R&amp;C also provides new roof installation for commercial construction and other projects where a roofing system is being planned.
      </p>
      <p>
        Depending on the project, the process may include evaluation of existing conditions, development of the roofing scope, material or system selection, project coordination, installation, and completion.
      </p>
    </div>
    <a href="/services/roof-replacement-and-new-installation" class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-accent text-black font-semibold text-[15px] leading-snug hover:bg-yellow-400 transition-colors duration-200">Explore Roof Replacement &amp; Installation</a>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- Comparison · Repair Now or Plan for Replacement? (White bg) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Repair Now or Plan for Replacement?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-8 md:mb-12 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      Commercial roofing decisions often involve balancing the immediate condition of the roof with the property's longer-term needs.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8 mb-8 md:mb-10">
      <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-5 text-heading">A Repair May Be Appropriate When</h3>
        <ul class="space-y-4">
          {[
            'The roofing problem is localized.',
            'Surrounding roofing materials remain serviceable.',
            'A defined repair can address the immediate condition.',
            'The remaining roofing system can continue to function with the repair.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-5 text-heading">Replacement May Need to Be Planned When</h3>
        <ul class="space-y-4">
          {[
            'Problems occur across several areas of the roof.',
            'The broader roofing system shows significant deterioration.',
            'Repeated localized repairs are no longer addressing the overall condition.',
            'The existing system can no longer be repaired effectively.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="text-center max-w-3xl mx-auto text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      R&amp;C evaluates the roof before recommending which path should be considered. For commercial properties, that information can also help decision-makers determine whether the work belongs in an immediate repair budget or a larger future roofing project.
    </p>
  </WidgetWrapper>

  <!-- Stacked rows · Roofing Information for Budgeting and Project Planning (Grey #FAFAFA) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-4 md:mb-6 text-center">
      Roofing Information for Budgeting and Project Planning
    </h2>
    <p class="text-center max-w-3xl mx-auto mb-10 md:mb-14 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      Commercial roofing decisions often require information that can be reviewed by people who may never visit the roof themselves. Depending on the project, R&amp;C can provide contractor-side information such as:
    </p>
    <div class="divide-y divide-gray-200 dark:divide-gray-700 border-t border-gray-200 dark:border-gray-700">
      {[
        {
          title: 'Observed Roofing Conditions',
          description: 'Photos and findings can help document relevant visible conditions at the time of inspection.',
        },
        {
          title: 'Recommended Roofing Scope',
          description: 'R&C can explain which areas need attention and whether repair or replacement should be considered.',
        },
        {
          title: 'Project Estimate',
          description: 'Once the proposed scope is defined, R&C can provide project-specific pricing as appropriate.',
        },
        {
          title: 'Roofing Options',
          description: 'For replacement and new installation projects, available roofing systems or materials can be discussed based on the property and project requirements.',
        },
        {
          title: 'Additional Contractor Information',
          description: 'When a project involves other professionals, R&C can provide roofing-specific information relevant to the work being planned.',
        },
      ].map(({ title, description }) => (
        <div class="py-8 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-heading">{title}</h3>
          <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-08 · A Clear Commercial Roofing Process (Black) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 md:mb-12">
      <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white">
        A Clear Commercial Roofing Process
      </h2>
      <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-accent text-black font-semibold text-[15px] leading-snug hover:bg-yellow-400 transition-colors duration-200 shrink-0">Start a Roofing Conversation</a>
    </div>
    <div class="flex flex-col md:flex-row gap-10 md:gap-16">
      <div class="md:basis-1/2 flex flex-col gap-6">
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
          <p>R&amp;C coordinates commercial roofing projects from initial evaluation through completion, working with the appropriate property contacts and project stakeholders at each stage.</p>
        </div>
      </div>
      <div class="md:basis-1/2">
        <Timeline
          isDark={true}
          items={[
            {
              title: 'Tell Us About the Property and Project',
              description: 'We start with the roofing concern, project goal, property type, and people involved in the decision.',
              icon: 'tabler:briefcase',
            },
            {
              title: 'Evaluate the Roofing Need',
              description: 'For existing buildings, R&C can evaluate relevant accessible roofing areas and existing conditions. For new projects, we review the roofing work being planned.',
              icon: 'tabler:search',
            },
            {
              title: 'Develop the Proposed Scope',
              description: 'We explain the roofing work that should be considered and any project conditions relevant to that recommendation.',
              icon: 'tabler:clipboard-list',
            },
            {
              title: 'Review the Project',
              description: 'The appropriate stakeholders can review the proposed scope, estimate, and other contractor information before the project moves forward.',
              icon: 'tabler:file-description',
            },
            {
              title: 'Coordinate the Roofing Work',
              description: 'If R&C is selected for the project, our team coordinates the agreed roofing work with the appropriate property or project contacts.',
              icon: 'tabler:users',
            },
            {
              title: 'Complete the Roofing Project',
              description: 'R&C performs the agreed roofing work according to the project scope and applicable requirements.',
              icon: 'tabler:hammer',
            },
          ]}
        />
      </div>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <!-- 4-col no-card · Commercial Roofing on Oahu (White bg) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Commercial Roofing on Oahu" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-8 md:mb-12 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      The environment surrounding a commercial property can be relevant to roofing decisions.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {[
        {
          title: 'Coastal Exposure',
          description: 'Properties closer to the ocean may experience greater salt exposure, particularly on exposed metal roofing components.',
        },
        {
          title: 'Wind Exposure',
          description: 'Building height, roof configuration, location, and surrounding terrain can influence wind exposure.',
        },
        {
          title: 'Rainfall and Drainage',
          description: 'Rainfall varies across Oahu, making roof drainage and water-management details important considerations.',
        },
        {
          title: 'Sun and Heat',
          description: 'Roofing materials and exposed components experience ongoing UV and heat exposure that can contribute to aging.',
        },
      ].map(({ title, description }) => (
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 md:mt-10 text-center max-w-3xl mx-auto text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      The appropriate roofing approach depends on the individual building rather than a one-size-fits-all recommendation.
    </p>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-13 · Commercial Roofing and Insurance Claims (Grey #FAFAFA) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-8 md:mb-10">
      Commercial Roofing and Insurance Claims
    </h2>
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
      <p>
        When commercial roof damage may involve an insurance claim, R&amp;C can provide contractor-side roofing support. Our team can inspect accessible areas, document relevant visible conditions, and provide information about the roofing work being recommended.
      </p>
      <p>
        The insurance carrier determines coverage and claim payment.
      </p>
      <p>
        R&amp;C Roofing Contractors is not a public adjuster. We do not negotiate insurance settlements, represent policyholders in claim disputes, or guarantee claim outcomes.
      </p>
    </div>
    <div class="mt-8 md:mt-10">
      <a href="/insurance-claim-help" class="btn btn-secondary">Explore Insurance Claim Help</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-09 · Recent Commercial Roofing Projects (Black — black cards) -->
  <ProjectsSection
    title="Recent Commercial Roofing Projects"
    isDark={true}
    columns={2}
    ctaText="View Commercial Roofing Projects"
    projects={[
      { title: 'Commercial Project 1', description: 'Details coming soon.' },
      { title: 'Commercial Project 2', description: 'Details coming soon.' },
    ]}
  >
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </ProjectsSection>

  <!-- Commercial Roofing for Different Decision-Makers (White bg) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Commercial Roofing for Different Decision-Makers" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-10 md:mb-14 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      Different stakeholders need different information from a roofing contractor.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-0 divide-y divide-gray-200 dark:divide-gray-700 border-t border-gray-200 dark:border-gray-700 sm:divide-y-0 sm:border-t-0">
      {[
        {
          title: 'Property Managers',
          description: 'Roof condition, repair planning, estimates, documentation, and coordination for managed properties.',
          href: '/contact',
          linkText: 'Roofing for Property Managers',
        },
        {
          title: 'General Contractors',
          description: 'Roofing scope coordination for construction, renovation, and larger project teams.',
          href: '/contact',
          linkText: 'Roofing for General Contractors',
        },
        {
          title: 'Architects & Design Teams',
          description: 'Contractor-side roofing input for project planning and construction coordination.',
          href: '/contact',
          linkText: 'Roofing for Architects',
        },
        {
          title: 'Owners, Trustees & Boards',
          description: 'Clear information to support roofing decisions, project planning, and approval discussions.',
          href: '/contact',
          linkText: 'Roofing for Property Decision-Makers',
        },
      ].map(({ title, description, href, linkText }) => (
