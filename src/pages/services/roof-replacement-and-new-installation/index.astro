---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Timeline from '~/components/ui/Timeline.astro';
import simplePattern from '~/assets/images/patterns/simple.svg';

const metadata = {
  title: 'Roof Replacement Oahu | New Roof Installation | R&C Roofing',
  description:
    'Planning a roof replacement or new roof installation on Oahu? R&C Roofing Contractors installs residential and commercial roofing systems for Hawaii properties.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- P-01 · Hero -->
  <Hero2
    actions={[{ variant: 'primary', text: 'Schedule a Roof Replacement Consultation', href: '/contact' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1200&q=80',
      alt: 'New roof installation on an Oahu residential property',
    }}
  >
    <Fragment slot="title">
      Roof Replacement &amp; New Roof Installation on Oahu
    </Fragment>
    <Fragment slot="subtitle">
      <p class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Plan the Right Roofing System for Your Property
      </p>
      A roof replacement is a larger decision than repairing one damaged area. You are choosing the roofing system that will protect the property for years to come.
      <br /><br />
      R&amp;C Roofing Contractors provides roof replacement and new roof installation services for residential and commercial properties within its Oahu service area. We evaluate the existing roof when applicable, discuss material options, develop the proposed roofing scope, and complete the installation when the project moves forward.
      <br /><br />
      R&amp;C operates under Hawaii contractor license C-33642 and brings more than 50 years of combined roofing experience to projects in Hawaii.
      <span class="block mt-8"></span>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0" style="-webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, transparent 100%);">
        <div
          class="absolute inset-0 opacity-[6%]"
          style={`background-color: var(--aw-color-accent); -webkit-mask-image: url('${simplePattern.src}'); mask-image: url('${simplePattern.src}'); -webkit-mask-size: cover; mask-size: cover; -webkit-mask-mode: luminance; mask-mode: luminance;`}
          aria-hidden="true"
        ></div>
      </div>
    </Fragment>
  </Hero2>

  <!-- Two-column split · Are You Replacing or Installing New? (grey bg) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Are You Replacing an Existing Roof or Installing a New One?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-8 md:mb-12 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      Both projects result in a new roofing system, but the starting point is different.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      <div class="rounded-lg border border-accent/60 bg-[#222] p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-5 text-white">Roof Replacement</h3>
        <ul class="space-y-4">
          {[
            'Designed for a property with an existing roof that needs to be removed, replaced, or substantially rebuilt.',
            'The existing roof condition helps determine the scope of work.',
            'Existing materials and underlying components may need evaluation before the new system is installed.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-accent font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-white/60">{item}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-accent text-black font-semibold text-[15px] leading-snug hover:bg-yellow-400 transition-colors duration-200">Schedule a Replacement Consultation</a>
        </div>
      </div>
      <div class="rounded-lg border border-accent/60 bg-[#222] p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-5 text-white">New Roof Installation</h3>
        <ul class="space-y-4">
          {[
            'Designed for new construction, additions, or other projects where a new roofing system is being planned.',
            'Roofing decisions are coordinated with the building design and project requirements.',
            'Material, drainage, flashing, penetrations, and other roofing details are considered as part of the new installation.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-accent font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-white/60">{item}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-md border-2 border-accent text-white font-semibold text-[15px] leading-snug hover:bg-accent hover:text-black transition-colors duration-200">Discuss a New Roof Installation</a>
        </div>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Stacked divider rows · When Should You Consider Roof Replacement? (Black) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white mb-4 md:mb-6 text-center">
      When Should You Consider Roof Replacement?
    </h2>
    <p class="text-center max-w-3xl mx-auto mb-10 md:mb-14 text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
      Not every roof problem requires replacement. R&amp;C looks at the condition of the roofing system before recommending a larger project. Replacement may need to be considered when:
    </p>
    <div class="divide-y divide-white/10 border-t border-white/10">
      {[
        {
          title: 'Problems Are Appearing in Multiple Areas',
          description: 'Recurring leaks or deterioration across different sections of the roof may indicate that localized repairs are no longer addressing the broader condition.',
        },
        {
          title: 'Roofing Materials Show Widespread Deterioration',
          description: 'Materials that are extensively worn, damaged, corroded, or no longer performing as intended may be difficult to repair effectively.',
        },
        {
          title: 'Previous Repairs Are No Longer Solving the Problem',
          description: 'Repeated repairs can sometimes indicate that the issue is no longer limited to one isolated area.',
        },
        {
          title: 'Underlying Components Need More Extensive Work',
          description: 'If deterioration beneath the roofing materials affects a larger portion of the system, the project scope may extend beyond a targeted repair.',
        },
        {
          title: 'The Property Owner Is Planning a Larger Upgrade',
          description: 'Some owners choose replacement as part of a renovation, property improvement, sale preparation, or long-term maintenance plan.',
        },
      ].map(({ title, description }) => (
        <div class="py-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">{description}</p>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-black"></div>
      <div class="absolute inset-0" style="-webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, transparent 100%);">
        <div
          class="absolute inset-0 opacity-[8%]"
          style={`background-color: var(--aw-color-accent); -webkit-mask-image: url('${simplePattern.src}'); mask-image: url('${simplePattern.src}'); -webkit-mask-size: cover; mask-size: cover; -webkit-mask-mode: luminance; mask-mode: luminance;`}
          aria-hidden="true"
        ></div>
      </div>
    </Fragment>
  </WidgetWrapper>

  <!-- Two-column comparison · Repair or Replace? (White bg) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Repair or Replace?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-8 md:mb-12 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      If you are not sure which option makes sense, start with the condition of the roof.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8 mb-8 md:mb-10">
      <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-5 text-heading">Repair May Be Appropriate When</h3>
        <ul class="space-y-4">
          {[
            'Damage is limited to one area.',
            'Surrounding materials remain serviceable.',
            'Compatible repair materials are available.',
            'The repair addresses the underlying roofing problem.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg border border-accent/50 bg-white dark:bg-slate-900 p-6 md:p-8">
        <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-5 text-heading">Replacement May Be Appropriate When</h3>
        <ul class="space-y-4">
          {[
            'Problems affect several areas of the roof.',
            'Surrounding materials show widespread deterioration.',
            'Existing materials cannot be repaired effectively.',
            'Repairing one section would leave broader roofing issues unresolved.',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-primary font-bold shrink-0 text-[18px] leading-[160%]">›</span>
              <span class="text-[15px] md:text-[16px] font-medium leading-[160%] text-muted">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="text-center max-w-3xl mx-auto text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-8">
      R&amp;C does not assume that an older roof automatically needs replacement. We evaluate what is happening with the roofing system before recommending the scope that should be considered.
    </p>
    <div class="text-center">
      <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-md border-2 border-black text-black font-semibold text-[15px] leading-snug hover:bg-black hover:text-white transition-colors duration-200">Schedule a Roof Inspection</a>
    </div>
  </WidgetWrapper>

  <!-- Component breakdown · What Goes Into a Roof Replacement? (Grey #FAFAFA) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Goes Into a Roof Replacement?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-center max-w-3xl mx-auto mb-10 md:mb-14 text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      A roof is more than the exterior material you see from the ground. Depending on the existing roof and proposed system, a replacement project may involve several roofing components.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {[
        {
          title: 'Existing Roofing Materials',
          description: 'The condition and configuration of the existing roofing system help determine how the replacement project should be approached.',
        },
        {
          title: 'Roof Deck',
          description: 'When accessible during the project, underlying decking can be evaluated for visible deterioration that may need to be addressed before new roofing materials are installed.',
        },
        {
          title: 'Underlayment',
          description: 'Underlayment forms part of the roofing assembly beneath the exterior roof covering. The appropriate product and installation method depend on the roofing system and project requirements.',
        },
        {
          title: 'Flashing',
          description: 'Roof transitions, valleys, walls, edges, penetrations, and other vulnerable areas may require flashing as part of the overall roofing system.',
        },
        {
          title: 'Roofing Material',
          description: 'The exterior material is selected based on the property, roof design, project requirements, appearance preferences, and budget.',
        },
        {
          title: 'Ventilation and Other Components',
          description: 'Certain roofing projects may also involve ventilation, drainage, penetrations, or other system-specific components.',
        },
      ].map(({ title, description }) => (
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 md:mt-10 text-center max-w-3xl mx-auto text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
      R&amp;C develops the roofing scope based on the property and the system being installed.
    </p>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Material cards · Choose the Right Roofing Material (Black) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white mb-4 md:mb-6 text-center">Choose the Right Roofing Material</h2>
    <p class="text-center max-w-3xl mx-auto mb-8 md:mb-12 text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
      Material selection is one of the biggest decisions in a replacement or new roof project. R&amp;C works with several roofing options used on Hawaii properties.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      {[
        {
          title: 'Asphalt Shingle Roofing',
          description: 'Asphalt shingles are commonly used on residential properties and are available in a range of styles. They can be a practical option for homeowners looking for a familiar roofing appearance and a variety of product choices.',
          href: '/services/roofing-materials/asphalt-shingles',
          linkText: 'Explore Asphalt Shingle Roofing',
        },
        {
          title: 'Metal Roofing',
          description: 'Metal roofing is available in different profiles, finishes, and system configurations. Material selection should consider the property, roof design, exposure, and project requirements.',
          href: '/services/roofing-materials/metal-roofing',
          linkText: 'Explore Metal Roofing',
        },
        {
          title: 'Stone-Coated Steel Roofing',
          description: 'Stone-coated steel combines a steel roofing base with a textured exterior finish and is available in profiles that resemble other roofing materials.',
          href: '/services/roofing-materials/stone-coated-steel',
          linkText: 'Explore Stone-Coated Steel Roofing',
        },
        {
          title: 'Clay & Concrete Tile Roofing',
          description: 'Tile roofing offers a distinctive appearance and may be appropriate when the structure and roof design are suitable for the selected system.',
          href: '/services/roofing-materials/tile-roofing',
          linkText: 'Explore Tile Roofing',
        },
      ].map(({ title, description, href, linkText }) => (
        <div class="rounded-lg border border-accent/60 bg-[#222] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60 flex-1">{description}</p>
          <a href={href} class="mt-4 text-accent font-medium text-[14px] md:text-[15px] hover:underline">
            {linkText} →
          </a>
        </div>
      ))}
    </div>
    <div class="mt-8 md:mt-10 text-center">
      <a href="/services/roofing-materials" class="inline-flex items-center justify-center px-6 py-3 rounded-md border-2 border-accent text-white font-semibold text-[15px] leading-snug hover:bg-accent hover:text-black transition-colors duration-200">Compare Roofing Materials</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-black"></div>
      <div class="absolute inset-0" style="-webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, transparent 100%);">
        <div
          class="absolute inset-0 opacity-[8%]"
          style={`background-color: var(--aw-color-accent); -webkit-mask-image: url('${simplePattern.src}'); mask-image: url('${simplePattern.src}'); -webkit-mask-size: cover; mask-size: cover; -webkit-mask-mode: luminance; mask-mode: luminance;`}
          aria-hidden="true"
        ></div>
      </div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-08 · How the Roof Replacement Process Works (white bg) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 md:mb-12">
      <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading">
        How the Roof Replacement Process Works
      </h2>
      <a href="/contact" class="btn-primary shrink-0">Request a Replacement Consultation</a>
    </div>
    <div class="flex flex-col md:flex-row gap-10 md:gap-16">
      <div class="md:basis-1/2 flex flex-col gap-6">
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted dark:text-slate-400">
          <p>Every roofing project is different, but a replacement generally moves through several stages. R&amp;C coordinates the full project from the initial evaluation through to final completion.</p>
        </div>
      </div>
      <div class="md:basis-1/2">
        <Timeline
          items={[
            {
              title: 'Evaluate the Property',
              description: 'We start by reviewing the existing roof, your concerns, and what you want from the replacement. For new construction, the starting point is the project itself and the roofing system being planned.',
              icon: 'tabler:search',
            },
            {
              title: 'Develop the Roofing Scope',
              description: 'R&C determines the proposed work based on the existing conditions, roofing material, property design, and other project requirements.',
              icon: 'tabler:clipboard-list',
            },
            {
              title: 'Select the Roofing Material',
              description: 'We discuss available roofing materials and the options that may be appropriate for the property.',
              icon: 'tabler:template',
            },
            {
              title: 'Prepare for Construction',
              description: 'Before work begins, the project scope, scheduling, site considerations, and applicable project requirements are reviewed. Permit requirements, when applicable, depend on the specific project and jurisdiction.',
              icon: 'tabler:file-description',
            },
            {
              title: 'Remove or Prepare the Existing System',
              description: 'For replacement projects, the existing roofing assembly is addressed according to the agreed project scope. Conditions that become visible during this phase may affect the work required.',
              icon: 'tabler:settings',
            },
            {
              title: 'Install the New Roofing System',
              description: 'R&C installs the agreed roofing materials and associated components according to the project specifications and applicable requirements.',
              icon: 'tabler:hammer',
            },
            {
              title: 'Complete the Project',
              description: 'Once roofing work is finished, the project moves through the applicable completion and cleanup steps outlined for the job.',
              icon: 'tabler:file-description',
            },
          ]}
        />
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-06 · What Affects Roof Replacement Cost (grey bg, 7 items) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Affects Roof Replacement Cost on Oahu?" classes={{ container: 'mb-4 md:mb-6' }} />
    <div class="text-center max-w-3xl mx-auto mb-8 md:mb-12">
      <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted">
        There is no meaningful one-price estimate for a roof replacement. The final cost depends on the property and the roofing system being installed.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mb-4 md:mb-6">
      {[
        {
          title: 'Roof Size',
          description: 'Larger roofing areas generally require more material and labor.',
        },
        {
          title: 'Roof Design and Slope',
          description: 'Complex rooflines, multiple transitions, steep slopes, or difficult-to-access sections can affect the scope of work.',
        },
        {
          title: 'Roofing Material',
          description: 'Asphalt shingles, metal, stone-coated steel, tile, and other materials have different product and installation requirements.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-accent/60 bg-[#222] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60">{description}</p>
        </div>
      ))}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 mb-8 md:mb-10">
      {[
        {
          title: 'Existing Roof Condition',
          description: 'The amount of work required to address the existing system can affect the project.',
        },
        {
          title: 'Underlying Conditions',
          description: 'Additional deterioration may sometimes become visible after existing roofing materials are removed.',
        },
        {
          title: 'Flashing and Roofing Details',
          description: 'Penetrations, walls, valleys, edges, drainage areas, and other roof details can affect labor and material needs.',
        },
        {
          title: 'Access and Site Conditions',
          description: 'Property access and construction logistics can also influence the project scope.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-accent/60 bg-[#222] p-6 flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/60">{description}</p>
        </div>
      ))}
    </div>
    <p class="text-center max-w-3xl mx-auto text-[16px] md:text-[17px] font-medium leading-[160%] text-muted mb-8">
      R&amp;C provides project-specific pricing after evaluating the property and developing the proposed roofing scope.
    </p>
    <div class="text-center">
      <a href="/contact" class="btn-primary">Request a Roof Replacement Estimate</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#FAFAFA] dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- 4-col no-card · Roofing Systems for Oahu Conditions (Black) -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-white mb-4 md:mb-6 text-center">Roofing Systems for Oahu Conditions</h2>
    <p class="text-center max-w-3xl mx-auto mb-8 md:mb-12 text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70">
      Roofing decisions in Hawaii should account for the conditions surrounding the property.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {[
        {
          title: 'Coastal Exposure',
          description: 'Properties closer to the ocean may experience more salt exposure, which can be relevant when selecting metal components, finishes, and roofing materials.',
        },
        {
          title: 'Wind Exposure',
          description: 'Roof shape, location, height, and surrounding terrain can influence how a property is exposed to wind.',
        },
        {
          title: 'Rainfall',
          description: 'Oahu rainfall conditions vary significantly by location. Roofing and drainage details should be appropriate for the property and system.',
        },
        {
          title: 'Sun and Heat',
          description: 'Roofing materials are exposed to strong UV and heat throughout the year, which can contribute to material aging over time.',
        },
      ].map(({ title, description }) => (
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[22px] md:text-[26px] font-medium font-heading leading-[130%] mb-3 text-white">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-white/70">{description}</p>
        </div>
      ))}
    </div>
