---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Prepare Your Roof for Hurricane Season on Oahu | R&C Roofing',
  description:
    'Is your roof ready for hurricane season on Oahu? Use this roof preparation checklist to spot problems early and learn when a professional inspection may make sense.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- P-01 Hero — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="py-8 md:py-12 max-w-3xl">
      <h1 class="text-[42px] md:text-[56px] font-medium leading-[115%] tracking-tighter font-heading mb-6">
        Is Your Roof Ready for Hurricane Season?
      </h1>
      <p class="block text-[20px] md:text-[24px] font-medium font-heading text-heading mb-6 leading-[130%] tracking-tight">
        Check the Roof Before the Weather Gives You a Reason To
      </p>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-4 mb-8">
        <p>Hurricane season in Hawaiʻi runs from June through November.</p>
        <p>You cannot control what a storm does, but you can go into the season knowing more about the condition of your roof.</p>
        <p>If roofing material is already loose, flashing is damaged, or an old leak has never been fully diagnosed, strong wind and heavy rain may expose that weakness.</p>
        <p>R&C Roofing Contractors can evaluate roofs within its Oahu service area before storm season and help determine whether anything should be repaired, monitored, or investigated further.</p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="btn-primary">Schedule a Roof Inspection</a>
      </div>
      <p class="mt-4 text-[15px] md:text-[16px] font-medium text-muted">(808) 888-2524</p>
      <p class="mt-2 text-[13px] md:text-[14px] font-medium text-muted italic">Hawaii Contractor License C-33642</p>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- How ready is your roof — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="How Ready Is Your Roof?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10">
      You do not need to climb onto the roof to start thinking about storm preparation. Begin with what you already know about the property.
    </p>
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700 shadow-[0_4px_30px_rgba(0,0,0,0.08)]">
      <table class="w-full text-left border-collapse bg-white dark:bg-slate-900">
        <thead>
          <tr class="bg-[#EDD974]/20 border-b border-gray-200 dark:border-slate-700">
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">What You Know About the Roof</th>
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">What May Make Sense Before Storm Season</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100 dark:border-slate-800">
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">The roof has no known problems and has been performing normally.</td>
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">Continue to watch for changes. A roof does not automatically need work just because hurricane season is approaching.</td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-800 bg-gray-50/60 dark:bg-slate-800/30">
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">You have noticed a ceiling stain or occasional leak.</td>
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">Find the source before another period of heavy rain. <a href="/my-roof-is-leaking" class="text-primary hover:underline">My Roof Is Leaking →</a></td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-800">
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">Roofing material looks loose, damaged, or out of place.</td>
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">Have the affected area evaluated before stronger weather arrives.</td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-800 bg-gray-50/60 dark:bg-slate-800/30">
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">The roof has needed several recent repairs.</td>
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">Consider whether another repair is appropriate or whether the overall roof condition should be evaluated. <a href="/my-roof-is-at-end-of-life" class="text-primary hover:underline">My Roof Is at End of Life →</a></td>
          </tr>
          <tr class="border-b border-gray-100 dark:border-slate-800">
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">The roof was affected by a previous storm.</td>
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">Make sure known damage has been evaluated and addressed. <a href="/storm-damage-on-my-roof" class="text-primary hover:underline">Storm Damage on My Roof →</a></td>
          </tr>
          <tr>
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">You are not sure what condition the roof is in.</td>
            <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">A roof inspection can give you a clearer starting point.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-8 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted italic text-center max-w-3xl mx-auto">
      The goal is not to replace a roof simply because storm season is coming. It is to identify problems that already exist before severe weather has a chance to make them worse.
    </p>
    <div class="mt-6 text-center">
      <a href="/contact" class="btn-primary">Have R&C Check the Roof</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What to look at — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Should You Look At Before Hurricane Season?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10">
      From the ground and from inside the property, there are several conditions worth paying attention to.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 md:gap-6">
      {[
        {
          title: 'Roofing Material That Looks Different',
          description: 'Missing, lifted, cracked, shifted, or visibly damaged roofing material deserves a closer look.',
        },
        {
          title: 'Flashing and Roof Details',
          description: 'Areas around penetrations, valleys, roof-to-wall transitions, and other roofing details can become water-entry points when components are damaged or deteriorated.',
        },
        {
          title: 'Previous Leaks',
          description: 'A stain that dried months ago does not necessarily mean the roofing problem disappeared. If water has entered before, identifying the source before another period of heavy rain is a practical step.',
        },
        {
          title: 'Roof Edges',
          description: 'Strong wind interacts directly with roof edges and exposed roofing components. Existing damage around those areas should not be ignored.',
        },
        {
          title: 'Debris Around Drainage Areas',
          description: 'Leaves or other debris can interfere with how water moves away from the roof. Do not climb onto the roof to clear an unsafe area yourself. R&C does not currently advertise roof or gutter cleaning as a service, so any cleaning work should be handled by an appropriate provider if needed.',
        },
      ].map(({ title, description }) => (
        <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-5 md:p-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-2">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted">{description}</p>
        </div>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What a pre-season inspection tells you — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Can a Pre-Season Roof Inspection Tell You?" classes={{ container: 'mb-4 md:mb-6' }} />
    <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted max-w-3xl mx-auto text-center mb-8 md:mb-10 space-y-3">
      <p>A roof inspection does not make a property storm-proof.</p>
      <p>It can help answer whether there are roofing conditions worth addressing before the season progresses.</p>
      <p>Depending on the property and accessible conditions, R&C can evaluate concerns involving roofing material, flashing, penetrations, transitions, previous leak areas, and the overall condition of the roof.</p>
      <p class="font-semibold text-heading">The useful outcome is a decision:</p>
    </div>
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700 shadow-[0_4px_30px_rgba(0,0,0,0.08)]">
      <table class="w-full text-left border-collapse bg-white dark:bg-slate-900">
        <thead>
          <tr class="bg-[#EDD974]/20 border-b border-gray-200 dark:border-slate-700">
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">What the Inspection Finds</th>
            <th class="px-5 py-4 text-[13px] md:text-[14px] font-semibold font-heading text-heading uppercase tracking-wide w-1/2">What May Make Sense</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['No significant roofing concerns', 'Major roofing work may not be necessary.'],
            ['One localized problem', 'Roof repair may be appropriate.'],
            ['A previous repair or leak area needs attention', 'Address the source before the next heavy-weather event.'],
            ['Several parts of the roof are deteriorating', 'Consider whether continued repair remains practical.'],
            ['Broader roof deterioration is present', 'Roof replacement may need to be considered.'],
            ['Existing storm-related damage is found', 'A Storm & Wind Damage Roof Inspection may be the more appropriate path.'],
          ].map(([finding, action], i) => (
            <tr class:list={['border-b border-gray-100 dark:border-slate-800 last:border-b-0', i % 2 === 1 ? 'bg-gray-50/60 dark:bg-slate-800/30' : '']}>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-heading align-top">{finding}</td>
              <td class="px-5 py-4 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted align-top">{action}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-8 text-[14px] md:text-[15px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto">
      R&C's broader inspection strategy is built around diagnosis before construction, rather than assuming an inspection should lead to a new roof.
    </p>
    <div class="mt-6 text-center">
      <a href="/roof-inspections" class="text-primary font-medium text-[14px] md:text-[15px] hover:underline">Roof Inspections →</a>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What to avoid — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="max-w-4xl">
      <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-6">
        What Should You Avoid Doing Before a Storm?
      </h2>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
        <p>Roof preparation should not create a new safety problem.</p>
        <p>Do not climb onto a wet, steep, or unfamiliar roof to perform your own inspection.</p>
        <p>Avoid making quick roofing patches simply because severe weather is forecast if you do not know what is actually causing the problem.</p>
        <p>And do not assume a roof is ready simply because it is not currently leaking.</p>
        <p>If you already know something is wrong, have the condition evaluated while there is still time to make a roofing decision without the pressure of an active leak.</p>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- What if storm damages anyway — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="max-w-4xl">
      <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-6">
        What If a Storm Damages the Roof Anyway?
      </h2>
      <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted space-y-5">
        <p>Even a roof that appeared serviceable before the season can be affected by severe weather.</p>
        <p>After a storm, start with what changed.</p>
        <p>If water is entering the property, go to <a href="/my-roof-is-leaking" class="text-primary hover:underline">My Roof Is Leaking</a>.</p>
        <p>If roofing material appears damaged or you suspect wind-related damage, go to <a href="/storm-damage-on-my-roof" class="text-primary hover:underline">Storm Damage on My Roof</a> or schedule a <a href="/roof-inspections/storm-and-wind-damage-inspection" class="text-primary hover:underline">Storm &amp; Wind Damage Roof Inspection</a>.</p>
        <p>If an insurance claim becomes involved, R&C can provide contractor-side inspection and roofing documentation. Your insurance carrier determines coverage and payment.</p>
        <p class="italic text-[14px] md:text-[15px]">R&C is not a public adjuster and does not negotiate insurance settlements, interpret coverage, represent policyholders in claim disputes, or guarantee claim outcomes.</p>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- Related Problems — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Does Another Roofing Problem Better Match Your Situation?" classes={{ container: 'mb-4 md:mb-6' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-center max-w-3xl mx-auto mb-8 md:mb-10">
      What you are dealing with will determine the right next step.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
      {[
        {
          title: 'My Roof Is Leaking',
          description: 'Your roof is leaking now.',
          href: '/my-roof-is-leaking',
        },
        {
          title: 'Storm Damage on My Roof',
          description: 'A recent storm may already have damaged the roof.',
          href: '/storm-damage-on-my-roof',
        },
        {
          title: 'My Roof Is at End of Life',
          description: 'The roof is aging and you are unsure whether another repair makes sense.',
          href: '/my-roof-is-at-end-of-life',
        },
        {
          title: 'My Insurance Claim Was Denied',
          description: 'You are dealing with a denied roof insurance claim.',
          href: '/my-insurance-claim-was-denied',
        },
        {
          title: 'Buying or Selling a Home',
          description: 'You are buying or selling the property.',
          href: '/buying-or-selling-a-home',
        },
      ].map(({ title, description, href }) => (
        <a href={href} class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-5 md:p-6 flex flex-col hover:shadow-md transition-shadow intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h3 class="text-[18px] md:text-[20px] font-medium font-heading leading-[130%] mb-2">{title}</h3>
          <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted flex-1">{description}</p>
          <span class="mt-3 text-primary font-medium text-[14px]">Continue here →</span>
        </a>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- FAQs — grey -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Frequently Asked Questions About Preparing a Roof for Hurricane Season" classes={{ container: 'mb-8 md:mb-10' }} />
    <div class="max-w-3xl mx-auto space-y-0 divide-y divide-gray-200 dark:divide-slate-700">
      {[
        {
          q: 'When should I have my roof checked before hurricane season?',
          a: 'If you already know about a leak, damaged material, or another roofing concern, it makes sense to have the condition evaluated before severe weather puts additional stress on the roof. You do not need to wait for a named storm to begin looking into an existing problem.',
          link: null,
        },
        {
          q: 'Does my roof need an inspection every hurricane season?',
          a: 'Not necessarily. The need for an inspection depends on the roof\'s condition, recent weather exposure, known problems, previous repairs, and your level of uncertainty about the roofing system.',
          link: null,
        },
        {
          q: 'Can R&C make my roof hurricane-proof?',
          a: 'No roofing contractor should promise that a roof cannot be damaged by a hurricane. R&C can evaluate the condition of the roof and identify roofing work that may be appropriate before storm season.',
          link: null,
        },
        {
          q: 'Should I replace an old roof before hurricane season?',
          a: 'Not simply because it is old. If the roof remains serviceable, replacement may not be necessary. If deterioration is widespread or repairs keep appearing in different areas, a broader evaluation may be appropriate.',
          link: { text: 'My Roof Is at End of Life →', href: '/my-roof-is-at-end-of-life' },
        },
        {
          q: 'What if my roof already has a small leak?',
          a: 'Do not assume a small or occasional leak will remain small during heavier weather. Have the source evaluated.',
          link: { text: 'My Roof Is Leaking →', href: '/my-roof-is-leaking' },
        },
        {
          q: 'What if my roof is damaged during a storm?',
          a: 'Document what you can safely see, stay off the damaged roof, and have the condition evaluated.',
          link: { text: 'Storm Damage on My Roof →', href: '/storm-damage-on-my-roof' },
        },
      ].map(({ q, a, link }) => (
        <details class="group py-5 first:pt-0 last:pb-0">
          <summary class="flex cursor-pointer items-start justify-between gap-4 list-none [&::-webkit-details-marker]:hidden">
            <span class="text-[16px] md:text-[17px] font-semibold font-heading leading-[140%] text-heading">{q}</span>
            <span class="shrink-0 mt-0.5 text-primary text-xl font-light leading-none transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-3 text-[15px] md:text-[16px] font-medium leading-[160%] text-muted space-y-2">
            <p>{a}</p>
            {link && <a href={link.href} class="text-primary font-medium hover:underline">{link.text}</a>}
          </div>
        </details>
      ))}
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </WidgetWrapper>

  <!-- P-12 Final CTA — white -->
  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <div class="w-full p-8 md:p-12 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-600">
      <div class="text-center mb-8 md:mb-10">
        <h2 class="text-[30px] md:text-[40px] font-normal leading-[120%] tracking-tighter font-heading text-heading mb-4">
          Go Into Hurricane Season Knowing Your Roof Condition
        </h2>
        <div class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted dark:text-slate-400 space-y-3">
          <p>You cannot predict exactly what the next storm will do.</p>
          <p>You can find out whether your roof already has a problem that deserves attention.</p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-t border-gray-200 dark:border-gray-700 pt-8">
        <div class="text-[15px] md:text-[16px] font-medium leading-[180%] text-muted dark:text-slate-400">
          <p class="font-semibold text-heading text-[16px] md:text-[17px]">R&amp;C Roofing Contractors</p>
          <p>3302 Campbell Ave, Honolulu, HI 96815</p>
          <p>(808) 888-2524</p>
          <p class="mt-1 text-[13px] md:text-[14px] italic">Hawaii Contractor License C-33642</p>
        </div>
        <a href="/contact" class="btn-primary shrink-0">Schedule a Roof Inspection</a>
      </div>
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </WidgetWrapper>

</Layout>
