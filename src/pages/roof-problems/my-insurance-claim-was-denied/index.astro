---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import IconPointBand from '~/components/ui/IconPointBand.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import ServiceDirectory from '~/components/ui/ServiceDirectory.astro';
import Timeline from '~/components/ui/Timeline.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { exploreFromDenied, serviceHeroActions } from '~/data/pages/roofProblems';

const metadata = {
  title: 'Roof Insurance Claim Denied in Hawaii? | R&C Roofing',
  description:
    'Was your roof insurance claim denied in Hawaii? Learn what to review next and how R&C can document roof conditions from the contractor side.',
  ignoreTitleTemplate: true,
};

const letter = [
  {
    title: 'Questioning Storm Damage',
    description:
      'Review what physical roofing conditions were documented after the event. R&C can inspect the roof and document observable roofing conditions.',
    icon: 'tabler:cloud-storm',
  },
  {
    title: 'Age or Wear Concerns',
    description:
      'Determine whether the problem is localized, widespread, or consistent with longer-term wear. R&C evaluates current physical conditions.',
    icon: 'tabler:clock',
  },
  {
    title: 'Insufficient Documentation',
    description:
      'Look at what photographs, findings, or contractor information were included with the claim to see if additional details clarify the condition.',
    icon: 'tabler:file-alert',
  },
  {
    title: 'Unclear Denial Decisions',
    description:
      'Ask your carrier or insurance professional to explain the decision. R&C can answer questions about the roofing condition, but cannot interpret your policy.',
    icon: 'tabler:help',
  },
];

const help = [
  {
    title: 'Thorough Roof Inspections',
    description:
      'We perform a complete physical assessment of your roof exterior, flashings, and vulnerable transition areas.',
    icon: 'tabler:search',
  },
  {
    title: 'Objective Condition Documentation',
    description:
      'We take clear, detailed photographs and record observable physical conditions to establish what is happening on your roof.',
    icon: 'tabler:camera',
  },
  {
    title: 'Actionable Project Scopes',
    description:
      'If repairs or replacement are necessary, we prepare clear contractor scopes of work and transparent project pricing to guide your next steps.',
    icon: 'tabler:clipboard-list',
  },
];
---

<Layout metadata={metadata}>
  <Hero2 actions={serviceHeroActions('Have R&C Review the Roof Condition')}>
    <Fragment slot="title">My Roof Insurance Claim Was Denied. What Should I Do?</Fragment>
    <Fragment slot="subtitle">
      Getting a denial after dealing with roof damage leaves you wondering what to do next. Do not start by assuming the
      carrier is wrong or that the claim will eventually be approved. Start with the denial letter, and get expert local
      evaluation from licensed professionals backed by Hawaii License C-33642.
    </Fragment>
    <Fragment slot="image">
      <HeroImagePlaceholder label="Denied claim photo placeholder" />
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Does Your Denial Letter Say?" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      Read the carrier's explanation carefully before deciding what to do next:
    </p>
    <IconPointGrid items={letter} />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto" isDark={true}>
    <Headline isDark={true} title="How R&C Roofing Helps After a Denial" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-white/70 text-left max-w-3xl mb-[30px]">
      When you need clarity on your roof's actual condition after a claim denial, our team provides professional
      contractor-side support:
    </p>
    <IconPointBand items={help} variant="dark" />
    <Fragment slot="bg">
      <SectionBg variant="dark" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="Explore Other Roof Problem Solutions" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      If your denied claim concerns are tied to other property situations or specific challenges, explore our other
      dedicated problem-solving resources:
    </p>
    <ServiceDirectory items={exploreFromDenied} variant="light" />
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-[1400px] mx-auto">
    <Headline title="What Happens When You Call Us?" classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-medium leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      Getting clarity after a claim denial shouldn't add to your stress:
    </p>
    <Timeline
      items={[
        {
          title: 'Review the Situation',
          description: 'Contact us to discuss your denial letter and current roof concerns.',
          icon: 'tabler:file-text',
        },
        {
          title: 'Professional Condition Evaluation',
          description:
            'We inspect your roof exterior, flashing, and attic space to establish the actual physical condition of the system.',
          icon: 'tabler:search',
        },
        {
          title: 'Clear Recommendations',
          description:
            'We provide an objective report and contractor-side pricing, helping you decide on the right path forward regardless of insurance funding.',
          icon: 'tabler:clipboard-list',
        },
      ]}
    />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title="Your Claim Was Denied. Start With the Roof Facts."
    subtitle="A denial letter tells you the carrier's current position. A roof inspection tells you what is physically happening with the roof."
    ctaText="Have R&C Review the Roof Condition"
  />
</Layout>
