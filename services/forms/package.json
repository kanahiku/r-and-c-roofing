{
  "name": "@massic/forms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "turnstile:create": "node ./scripts/setup-turnstile.mjs",
    "db:migrate:local": "wrangler d1 execute massic-forms --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute massic-forms --local --file=./seed.sql",
    "db:leads:local": "wrangler d1 execute massic-forms --local --command \"SELECT created_at, name, email, phone, street, address_line2, city, state, zip, email_sent_at FROM leads ORDER BY created_at DESC LIMIT 5\"",
    "db:migrate": "wrangler d1 execute massic-forms --remote --file=./schema.sql",
    "db:migrate:address": "wrangler d1 execute massic-forms --remote --file=./migrations/001_lead_address.sql",
    "db:seed": "wrangler d1 execute massic-forms --remote --file=./seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.20.0"
  }
}
