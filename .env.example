# ─── Sanity — Astro site (required) ────────────────────────────────────────────
# The site reads navigation, footer, and all page documents from Sanity.
SANITY_PROJECT_ID=xxxxxxxx
SANITY_DATASET=production
SANITY_API_TOKEN=sk...          # Viewer (read-only) token

# ─── Sanity — Migration script (write access) ──────────────────────────────────
# Only needed when running: npx tsx scripts/migrate-to-sanity.ts
SANITY_WRITE_TOKEN=sk...        # Editor token

# ─── Sanity — Studio ────────────────────────────────────────────────────────────
# Add these in studio/.env (same values as above)
# SANITY_STUDIO_PROJECT_ID=xxxxxxxx
# SANITY_STUDIO_DATASET=production

# ─── Resend (contact form email) ───────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=R&C Roofing Contractors <noreply@randcroofing.com>
NOTIFY_EMAIL=info@safehomeservice.com
SITE_NAME=R&C Roofing Contractors

# ─── Site URL ──────────────────────────────────────────────────────────────────
# SITE_URL=https://www.randcroofing.com
