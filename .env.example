# ─── Content Source ────────────────────────────────────────────────────────────
# Controls where the Astro site reads content from at build time.
# "local"  → reads from src/data/pages/*.ts (dev phase, default)
# "sanity" → fetches from Sanity API (production phase)
CONTENT_SOURCE=local

# ─── Sanity — Astro site (read-only) ───────────────────────────────────────────
# Only needed when CONTENT_SOURCE=sanity
SANITY_PROJECT_ID=xxxxxxxx
SANITY_DATASET=production
SANITY_API_TOKEN=sk...          # Viewer (read-only) token

# ─── Sanity — Migration script (write access) ──────────────────────────────────
# Only needed when running: npx tsx scripts/migrate-to-sanity.ts
SANITY_WRITE_TOKEN=sk...        # Editor token

# ─── Sanity — Studio ────────────────────────────────────────────────────────────
# Add these in studio/.env (same values as above)
# SANITY_STUDIO_PROJECT_ID=xxxxxxxx
# SANITY_STUDIO_DATASET=production

# ─── Contact form (public — baked into the static site) ────────────────────────
# Form POSTs here. Local: http://localhost:8787/submit
# Production fallback in src/lib/forms.ts is https://massic-forms.kanahiku.workers.dev/submit
PUBLIC_FORM_ENDPOINT=http://localhost:8787/submit
# Cloudflare Turnstile site key. Dummy always-pass key (local / until you create a widget):
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_SITE_SLUG=rc-roofing
#
# On Vercel → Project → Settings → Environment Variables, set the three PUBLIC_*
# vars above (Production + Preview). Never put RESEND_API_KEY here.

# ─── Site URL ──────────────────────────────────────────────────────────────────
# SITE_URL=https://www.randcroofing.com

# Resend API key and Turnstile secret live on the form Worker only.
# See services/forms/.dev.vars.example — never put them in this file.
