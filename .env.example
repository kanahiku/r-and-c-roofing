# ─── Sanity — Astro site (required) ────────────────────────────────────────────
# The site reads navigation, footer, and all page documents from Sanity.
SANITY_PROJECT_ID=xxxxxxxx
SANITY_DATASET=production
SANITY_API_TOKEN=sk...          # Viewer (read-only) token

# ─── Sanity — Migration script (write access) ──────────────────────────────────
# Only needed when running: npx tsx scripts/migrate-to-sanity.ts
SANITY_WRITE_TOKEN=sk...        # Editor token

# ─── Sanity — Studio ────────────────────────────────────────────────────────────
# Add these in studio/.env (same values as above)
# SANITY_STUDIO_PROJECT_ID=xxxxxxxx
# SANITY_STUDIO_DATASET=production

# ─── Resend (contact form email) ───────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=R&C Roofing Contractors <noreply@randcroofing.com>
NOTIFY_EMAIL=info@safehomeservice.com
SITE_NAME=R&C Roofing Contractors

# ─── Site URL ──────────────────────────────────────────────────────────────────
# SITE_URL=https://www.randcroofing.com

# ─── ISR / Sanity publish → live (required in production) ─────────────────────
# These are NOT issued by Sanity or Vercel. Generate them (openssl rand -hex 32).
# Then paste the SAME values into:
#   Vercel → Project → Settings → Environment Variables
#   Sanity → Project → API → Webhooks → Authorization: Bearer <SANITY_REVALIDATE_SECRET>
ISR_BYPASS_TOKEN=
SANITY_REVALIDATE_SECRET=

# ─── Reviews (Google Places + Yelp Fusion) ─────────────────────────────────────
# Server-only. Do not prefix with PUBLIC_. Empty keys skip that source; View all still uses the URLs.
GOOGLE_PLACES_API_KEY=AIza...
GOOGLE_PLACE_ID=ChIJ...
GOOGLE_REVIEWS_URL=https://www.google.com/search?q=Your+Business+Name
YELP_API_KEY=xxxxxxxx
YELP_BUSINESS_ID=xxxxxxxxxxxxxxxxxxxx
YELP_REVIEWS_URL=https://www.yelp.com/biz/your-business
